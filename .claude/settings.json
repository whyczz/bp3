    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./bin/bp3 g hooks || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./bin/bp3 g hooks || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./bin/bp3 g hooks || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./bin/bp3 g hooks || true"
          }
        ]
      }
