#!/usr/bin/env bash
# check-constraints (constraints-context rules.2): the tracked files
# against the ```constraints block in CONSTRAINTS.md, the owner-signed
# stack. Fails, naming the file, on a file in an unlisted language, an
# unlisted interpreter in command position (line start, after | ; && ||
# $( ` or (, past VAR=value words and env, exec or command), or a
# declared library its language does not list: dune (libraries ...) and
# (pps ...), node imports and package.json deps, Brewfile brews. docs/
# and *.md are prose, never code. A bash script calling an unlisted tool
# with no Brewfile entry is not caught: that is the grader's.
#   scripts/check-constraints     checks the git repo it runs in
# Exit 0 ok, 1 on any FAIL, 2 when CONSTRAINTS.md has no block.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# shellcheck disable=SC2016  # backticks fence the block; nothing expands
block=$(sed -n '/^```constraints$/,/^```$/p' CONSTRAINTS.md 2>/dev/null | sed '1d;$d')
[ -n "$block" ] || { echo "check-constraints: no constraints block in CONSTRAINTS.md" >&2; exit 2; }
# the block as "key word lang" rows: ext .ml ocaml, lib yojson ocaml, ...
rows=$(awk '{
  lang = ($1 == "data") ? "data" : $2; key = ""
  for (i = 1; i <= NF; i++) {
    if ($i ~ /^(lang|data|ext|files|shebang|libs)$/) { key = $i; continue }
    if (key == "ext" || key == "files" || key == "shebang") print key, $i, lang
    if (key == "libs") print "lib", $i, lang
  }
}' <<< "$block")
langs=$(awk '$1 == "lang" { print $2 }' <<< "$block")
look() { awk -v k="$1" -v w="$2" '$1 == k && $2 == w { print $3; exit }' <<< "$rows"; }
lib_ok() { # lang name: a libs word matches it exactly or as a glob (node:*)
  local pat
  while IFS= read -r pat; do
    # shellcheck disable=SC2254  # the libs word is a glob on purpose
    case "$2" in $pat) return 0 ;; esac
  done < <(awk -v l="$1" '$1 == "lib" && $3 == l { print $2 }' <<< "$rows")
  return 1
}
# interpreters a line may run: the lang names and their shebangs
allowed=$(printf '%s\n' "$langs"; awk '$1 == "shebang" { print $2 }' <<< "$rows")
known="python python2 python3 perl ruby php lua tclsh osascript Rscript deno bun fish zsh node bash sh ocaml"
fails=0
fail() { echo "check-constraints: FAIL $1: $2 not in CONSTRAINTS.md"; fails=$((fails + 1)); }
files=$(git ls-files | grep -v -E '^docs/|\.md$')
shells=() nodes=()
while IFS= read -r f; do
  [ -f "$f" ] || continue
  base=${f##*/}
  lang=$(look files "$f"); [ -n "$lang" ] || lang=$(look files "$base")
  if [ -z "$lang" ]; then
    case "$base" in
      *.*) lang=$(look ext ".${base##*.}")
           [ -n "$lang" ] || { fail "$f" "language .${base##*.}"; continue; } ;;
      *) interp=$(head -1 "$f" | sed -n -E 's@^#![[:space:]]*([^[:space:]]*/)?(env[[:space:]]+)?([^[:space:]]+).*@\3@p')
         [ -n "$interp" ] || { fail "$f" "language (no extension, no shebang)"; continue; }
         lang=$(look shebang "$interp")
         [ -n "$lang" ] || { fail "$f" "language $interp (shebang)"; continue; } ;;
    esac
  fi
  case "$lang" in bash) shells+=("$f") ;; node) nodes+=("$f") ;; esac
  if [ "$f" = Makefile ]; then shells+=("$f"); fi
done <<< "$files"
# interpreters in command position; comment lines are skipped
if [ ${#shells[@]} -gt 0 ]; then
  while IFS= read -r hit; do fail "${hit% *}" "interpreter ${hit##* }"; done < <(
    awk -v known="$known" -v allowed="$(tr '\n' ' ' <<< "$allowed")" '
      BEGIN { n = split(known, K, " "); for (i = 1; i <= n; i++) isk[K[i]] = 1
              n = split(allowed, A, " "); for (i = 1; i <= n; i++) ok[A[i]] = 1 }
      /^[[:space:]]*#/ { next }
      { line = $0  # quoted strings are words, never commands
        gsub(/"([^"\\]|\\.)*"/, "\"\"", line); gsub(/\047[^\047]*\047/, "", line)
        gsub(/\$\(|`|\|\||&&|[|;(]/, "\n", line); s = split(line, seg, "\n")
        for (j = 1; j <= s; j++) {
          w = split(seg[j], W, /[[:space:]]+/); wrap = 0
          for (k = 1; k <= w; k++) {
            t = W[k]
            if (t == "" || t ~ /^[A-Za-z_][A-Za-z0-9_]*=/ || (wrap && t ~ /^-/)) continue
            if (t == "env" || t == "exec" || t == "command") { wrap = 1; continue }
            gsub(/["\047]/, "", t); sub(/^.*\//, "", t)
            if ((t in isk) && !(t in ok)) print FILENAME ":" FNR " " t
            break } } }' "${shells[@]}")
fi
# declared libraries, per language; a library this repo defines is not one
dunes=$(grep -E '(^|/)dune$' <<< "$files" || true)
internal=$(for f in $dunes; do tr '\n' ' ' < "$f"; done | { grep -o -E '\((public_)?name [^)]+\)' || true; } | awk '{ print $2 }' | tr -d ')')
while IFS= read -r f; do
  [ -n "$f" ] || continue
  for lib in $(tr '\n' ' ' < "$f" | grep -o -E '\((libraries|pps) [^)]*\)' | sed -E 's/^\((libraries|pps) //; s/\)$//'); do
    grep -qx -- "$lib" <<< "$internal" || lib_ok ocaml "$lib" || fail "$f" "library $lib (ocaml)"
  done
done <<< "$dunes"
for f in ${nodes[@]+"${nodes[@]}"}; do
  while IFS= read -r spec; do
    case "$spec" in ''|.*|/*) continue ;; @*/*) pkg=$(cut -d/ -f1-2 <<< "$spec") ;; node:*) pkg=$spec ;; *) pkg=${spec%%/*} ;; esac
    lib_ok node "$pkg" || fail "$f" "library $pkg (node)"
  done < <({ grep -h -o -E "(from|import|require)[[:space:]]*\\(?[[:space:]]*['\"][^'\"]+['\"]" "$f" || true; } | sed -E "s/.*['\"]([^'\"]+)['\"]/\\1/")
done
while IFS= read -r f; do
  [ -n "$f" ] || continue
  for dep in $(jq -r '[.dependencies, .devDependencies, .peerDependencies, .optionalDependencies] | map(select(.) | keys[]) | .[]' "$f"); do
    lib_ok node "$dep" || fail "$f" "library $dep (node)"
  done
done <<< "$(grep -E '(^|/)package\.json$' <<< "$files" || true)"
if grep -qx Brewfile <<< "$files"; then
  while read -r n brew; do
    lib_ok bash "$brew" || fail "Brewfile:$n" "library $brew (bash)"
  done < <(awk '$1 == "brew" { gsub(/[",]/, "", $2); print FNR, $2 }' Brewfile)
fi
[ "$fails" = 0 ] || exit 1
echo "check-constraints: ok ($(wc -w <<< "$langs" | tr -d ' ') languages, $(wc -l <<< "$files" | tr -d ' ') files)"
