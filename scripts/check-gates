#!/usr/bin/env bash
# check-gates (test-pyramid tier.2): the gates' exact shape, checked
# from lint, which both gates run first, so a broken gate fails in
# itself rather than silently proving less. An allowlist, not a
# denylist: `make -n check` must be exactly these steps, in order,
#   ./scripts/check-gates
#   ./scripts/check-constraints (the owner-signed stack, CONSTRAINTS.md)
#   ./scripts/check-bump (forward-only bump: frontmatter on proposed/active quests)
#   the shellcheck run over scripts/shell-files (refusing an empty list)
#   ./scripts/check-skills over the four skill trees
#   dune build of both binaries (SDKROOT= and --root=. allowed)
#   dune test
# and `make -n check-full` must be the same plan with the last step
# `./scripts/run-suites` (every tier), so check-full runs all of check.
# check-fast and test are check. The Makefile may not ignore errors
# anywhere: no '-' recipe prefix, no .IGNORE, no MAKEFLAGS, no
# '|| true'. Any other line (a suite run by hand, however spelled) fails:
# test/suites.tsv is the only list of suites. check-changed.sh names no
# test path but the table. Changing a gate means changing this file.
# test/check-tiers.sh (fixture tier) plants each break and checks that
# lint still runs this script.
#   scripts/check-gates [--makefile f]
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
mk="$root/Makefile"
while [ $# -gt 0 ]; do
  case "$1" in
    --makefile) [ $# -ge 2 ] || { echo "check-gates: --makefile needs a value" >&2; exit 2; }
      case "$2" in /*) mk=$2 ;; *) mk="$PWD/$2" ;; esac; shift ;;
    *) echo "check-gates: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
fail() { echo "check-gates: FAIL: $*" >&2; exit 1; }
plan() { make -s -C "$root" -f "$mk" -n "$1" 2>/dev/null || fail "make -n $1 failed"; }

# ignore-errors hides a red gate, and make -n does not print it
if grep -nE $'^\t[@+]*-' "$mk" > /dev/null; then fail "a recipe line ignores errors ('-' prefix): $(grep -nE $'^\t[@+]*-' "$mk" | head -1)"; fi
if grep -nE '^\.IGNORE|^[[:space:]]*MAKEFLAGS|\|\|[[:space:]]*(true|:)([[:space:]]|$)' "$mk" > /dev/null; then
  fail "the Makefile ignores errors: $(grep -nE '^\.IGNORE|^[[:space:]]*MAKEFLAGS|\|\|[[:space:]]*(true|:)([[:space:]]|$)' "$mk" | head -1)"
fi

dune='(SDKROOT=[^ ]+ )?dune'
# shellcheck disable=SC2016  # regexes matched against make -n output, not expansions
steps=(
  '\./scripts/check-gates'
  '\./scripts/check-constraints'
  '\./scripts/check-bump'
  'files=\$\(\./scripts/shell-files\) && \[ -n "\$files" \] && shellcheck \$files'
  '\./scripts/check-skills skills \.pi/skills \.agents/skills \.claude/skills'
  "$dune build( --root=\\.)? src/quest/main\\.exe src/quest/run_suites\\.exe"
  "$dune test( --root=\\.)?"
)
match_plan() { # gate [last-step-regex]
  local gate=$1 last=${2:-} i=0 line
  local want=("${steps[@]}")
  if [ -n "$last" ]; then want+=("$last"); fi
  while IFS= read -r line; do
    [ $i -lt ${#want[@]} ] || fail "make $gate has an extra step: $line"
    [[ $line =~ ^${want[$i]}$ ]] || fail "make $gate step $((i + 1)) is not the gate's: $line"
    i=$((i + 1))
  done < <(plan "$gate")
  [ $i = ${#want[@]} ] || fail "make $gate stops after $i of ${#want[@]} steps"
}
match_plan check
match_plan check-full '\./scripts/run-suites'
[ "$(plan check-full | sed '$d')" = "$(plan check)" ] || fail "make check-full does not run all of check"
[ "$(plan check-fast)" = "$(plan check)" ] || fail "make check-fast is not make check"
[ "$(plan test)" = "$(plan check)" ] || fail "make test is not make check"
# the selector reads the table and names no suite itself
if grep -n 'test/' "$root/scripts/check-changed.sh" | grep -v 'test/suites\.tsv' > /dev/null; then
  fail "check-changed.sh names a test path besides the table: $(grep -n 'test/' "$root/scripts/check-changed.sh" | grep -v 'test/suites\.tsv' | head -1)"
fi
echo "check-gates: ok"
