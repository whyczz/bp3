#!/usr/bin/env bash
# agy-statusline — live bp3 quest progress + context token bar for Antigravity CLI (agy).
# Reads agy's statusLine JSON payload on stdin and prints one compact ANSI line:
#   bp3: <quest> [████░░░░] 2/4 (50%) | <node> (<state> c<N>) | <wall> | ctx <used>/<max> (<pct>%)
#
# Enable in agy:
#   /statusline /path/to/bp3/scripts/agy-statusline
# Or in ~/.gemini/antigravity-cli/settings.json:
#   "statusLine": {"type":"command","command":"/path/to/bp3/scripts/agy-statusline","enabled":true,"stack_with_default":true}
#
# Fail-open: always exits 0 (agy disables statusLine after 30 consecutive failures).
set -uo pipefail

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,12s/^# \{0,1\}//p' "$0"
  exit 0
fi

# ANSI palette (disabled when NO_COLOR is set or --no-color passed)
if [ -n "${NO_COLOR:-}" ] || [ "${1:-}" = "--no-color" ]; then
  C_RST="" C_DIM="" C_CYN="" C_GRN="" C_YLW="" C_RED="" C_BLD=""
else
  C_RST=$'\033[0m'
  C_DIM=$'\033[2m'
  C_CYN=$'\033[36m'
  C_GRN=$'\033[32m'
  C_YLW=$'\033[33m'
  C_RED=$'\033[31m'
  C_BLD=$'\033[1m'
fi

fmt_tokens() {
  local n="${1:-0}"
  awk -v n="$n" 'BEGIN {
    if (n >= 1000000) printf "%.1fM", n / 1000000;
    else if (n >= 1000) printf "%.0fk", n / 1000;
    else printf "%d", n;
  }'
}

fmt_bar() {
  local done="$1" total="$2" width=8
  local filled=0 empty=8 i bar=""
  if [ "$total" -gt 0 ]; then
    filled=$(( (done * width + total / 2) / total ))
    [ "$filled" -gt "$width" ] && filled="$width"
    [ "$filled" -lt 0 ] && filled=0
  fi
  empty=$(( width - filled ))
  for ((i = 0; i < filled; i++)); do bar="${bar}█"; done
  for ((i = 0; i < empty; i++)); do bar="${bar}░"; done
  printf '[%s]' "$bar"
}

fmt_wall() {
  local secs="$1"
  if [ "$secs" -lt 60 ]; then
    printf '%ds' "$secs"
  elif [ "$secs" -lt 3600 ]; then
    printf '%dm' $(( secs / 60 ))
  else
    printf '%dh%02dm' $(( secs / 3600 )) $(( (secs % 3600) / 60 ))
  fi
}

parse_iso_epoch() {
  local ts="$1"
  # macOS BSD date vs GNU date
  date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$ts" "+%s" 2>/dev/null \
    || date -u -d "$ts" "+%s" 2>/dev/null \
    || echo ""
}

extract_sid_from_transcript() {
  local p="$1"
  [ -n "$p" ] || return 0
  case "$p" in
    */brain/*)
      local tail="${p#*/brain/}"
      printf '%s' "${tail%%/*}"
      return 0
      ;;
  esac
  local base
  base="$(basename "$p")"
  case "$base" in
    *.jsonl) printf '%s' "${base%.jsonl}" ;;
  esac
}

valid_sid() {
  local s="$1"
  [ -n "$s" ] && [ "${#s}" -le 128 ] || return 1
  case "$s" in
    .*|*..*|*/*|*\\*) return 1 ;;
  esac
  case "$s" in
    *[!A-Za-z0-9._-]*) return 1 ;;
  esac
  return 0
}

payload=""
if [ ! -t 0 ]; then
  payload="$(cat 2>/dev/null || true)"
fi

cwd="."
j_sid=""
j_tx=""
ctx_str=""
if [ -n "$payload" ] && command -v jq >/dev/null 2>&1; then
  # Single jq pass over stdin JSON for speed (sentinels prevent bash IFS=$'\t' collapsing empty fields)
  IFS=$'\t' read -r j_cwd j_sid j_tx j_pct j_size j_tin j_tout <<< "$(
    printf '%s' "$payload" | jq -r '[
      (if (.workspace.current_dir // .cwd // "") == "" then "." else (.workspace.current_dir // .cwd) end),
      (if (.session_id // .conversation_id // .conversationId // "") == "" then "__NONE__" else (.session_id // .conversation_id // .conversationId) end),
      (if (.transcript_path // "") == "" then "__NONE__" else .transcript_path end),
      (.context_window.used_percentage // -1),
      (.context_window.context_window_size // 0),
      (.context_window.total_input_tokens // 0),
      (.context_window.total_output_tokens // 0)
    ] | @tsv' 2>/dev/null || true
  )"
  [ -n "${j_cwd:-}" ] && cwd="$j_cwd"
  [ "${j_sid:-}" = "__NONE__" ] && j_sid=""
  [ "${j_tx:-}" = "__NONE__" ] && j_tx=""

  if [ -n "${j_pct:-}" ] && [ "$j_pct" != "-1" ]; then
    pct_int="$(awk -v p="$j_pct" 'BEGIN { printf "%d", p + 0.5 }')"
    c_ctx="$C_GRN"
    if [ "$pct_int" -ge 85 ]; then
      c_ctx="$C_RED"
    elif [ "$pct_int" -ge 60 ]; then
      c_ctx="$C_YLW"
    fi
    if [ "${j_size:-0}" -gt 0 ] 2>/dev/null; then
      used_tok="$(awk -v s="$j_size" -v p="$j_pct" 'BEGIN { printf "%.0f", s * p / 100.0 }')"
      ctx_str="${c_ctx}ctx $(fmt_tokens "$used_tok")/$(fmt_tokens "$j_size") (${pct_int}%)${C_RST}"
    else
      tot_tok=$(( ${j_tin:-0} + ${j_tout:-0} ))
      ctx_str="${c_ctx}ctx $(fmt_tokens "$tot_tok") (${pct_int}%)${C_RST}"
    fi
  fi
fi

sid="${j_sid:-}"
if [ -z "$sid" ] && [ -n "${j_tx:-}" ]; then
  sid="$(extract_sid_from_transcript "$j_tx")"
fi
if [ -z "$sid" ]; then
  sid="${AGY_CONVERSATION_ID:-${CLAUDE_SESSION_ID:-}}"
fi
had_sid_input=0
if [ -n "$sid" ]; then
  had_sid_input=1
  if ! valid_sid "$sid"; then
    sid=""
  fi
fi

# Locate bp3 repo root
root="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$root" ] || [ ! -d "$root/docs/quests" ]; then
  [ -n "$ctx_str" ] && printf '%s\n' "$ctx_str"
  exit 0
fi

# Resolve canonical git common dir (shared across main checkout and central ~/.bp3/desks worktrees)
common_dir=""
common_raw="$(git -C "$root" rev-parse --git-common-dir 2>/dev/null || true)"
if [ -n "$common_raw" ]; then
  case "$common_raw" in
    /*) common_dir="$(cd "$common_raw" 2>/dev/null && pwd -P || printf '%s' "$common_raw")" ;;
    *)  common_dir="$(cd "$root/$common_raw" 2>/dev/null && pwd -P || printf '%s' "$root/$common_raw")" ;;
  esac
fi

# Resolve bp3 binary
bp3_bin=""
if [ -x "$root/bin/bp3" ]; then
  bp3_bin="$root/bin/bp3"
elif command -v bp3 >/dev/null 2>&1; then
  bp3_bin="$(command -v bp3)"
fi
if [ -z "$bp3_bin" ] || ! command -v jq >/dev/null 2>&1; then
  [ -n "$ctx_str" ] && printf '%s\n' "$ctx_str"
  exit 0
fi

# Count active quests on this branch (invariant: at most 1 active quest per branch)
active_count=0
active_quest=""
for qf in "$root"/docs/quests/*/QUEST.md; do
  [ -f "$qf" ] || continue
  if grep -q '^status: active$' "$qf" 2>/dev/null; then
    active_count=$((active_count + 1))
    active_quest="$(basename "$(dirname "$qf")")"
  fi
done
warn_part=""
if [ "$active_count" -gt 1 ]; then
  warn_part=" ${C_DIM}|${C_RST} ${C_RED}WARN: ${active_count} active quests${C_RST}"
fi

# Detect active quest:
# When a session ID is present:
#   1. Per-session binding in <git-common-dir>/bp3/sessions/<sid>.json (verifying red_ink_path exists)
#   2. Current quest/<slug> branch
#   3. Else idle (never glob repo-global QUEST.red-ink.md / QUEST.2b-reviewed.md)
# When no session ID is present (legacy session-less caller):
#   1. Current quest/<slug> branch
#   2. Local red-ink working copy
#   3. Active QUEST.md on this branch
quest=""
mode=""
branch="$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [ "$had_sid_input" -eq 1 ]; then
  sfile=""
  [ -n "$sid" ] && [ -n "$common_dir" ] && sfile="$common_dir/bp3/sessions/${sid}.json"
  if [ -n "$sfile" ] && [ -f "$sfile" ]; then
    IFS=$'\t' read -r s_quest s_mode s_rpath <<< "$(
      jq -r '[
        (if (.quest // "") == "" then "__NONE__" else .quest end),
        (if (.mode // "") == "" then "__NONE__" else .mode end),
        (if (.red_ink_path // "") == "" then "__NONE__" else .red_ink_path end)
      ] | @tsv' "$sfile" 2>/dev/null || true
    )"
    [ "${s_quest:-}" = "__NONE__" ] && s_quest=""
    [ "${s_mode:-}" = "__NONE__" ] && s_mode=""
    [ "${s_rpath:-}" = "__NONE__" ] && s_rpath=""
    if [ "$s_mode" = "red-ink" ]; then
      if [ -n "$s_quest" ] && [ -n "$s_rpath" ] && [ -f "$root/$s_rpath" ]; then
        quest="$s_quest"
        mode="red-ink"
      fi
    elif [ -n "$s_quest" ]; then
      quest="$s_quest"
      mode="induct"
    fi
  fi
  if [ -z "$quest" ]; then
    case "$branch" in
      quest/*) quest="${branch#quest/}" ;;
    esac
  fi
else
  case "$branch" in
    quest/*) quest="${branch#quest/}" ;;
  esac
  if [ -z "$quest" ]; then
    for rf in "$root"/docs/quests/*/QUEST.red-ink.md "$root"/docs/quests/*/QUEST.2b-reviewed.md; do
      [ -f "$rf" ] || continue
      quest="$(basename "$(dirname "$rf")")"
      mode="red-ink"
    done
  fi
  if [ -z "$quest" ]; then
    quest="$active_quest"
  fi
fi

print_idle() {
  if [ -n "$ctx_str" ]; then
    printf '%sbp3:%s idle %s|%s %s\n' "$C_CYN" "$C_RST" "$C_DIM" "$C_RST" "$ctx_str"
  else
    printf '%sbp3:%s idle\n' "$C_CYN" "$C_RST"
  fi
  exit 0
}

if [ "$mode" = "red-ink" ]; then
  ctx_part=""
  [ -n "$ctx_str" ] && ctx_part=" ${C_DIM}|${C_RST} ${ctx_str}"
  printf '%s%sbp3:%s %s %s[red-ink]%s%s%s\n' \
    "$C_BLD" "$C_CYN" "$C_RST" \
    "$quest" \
    "$C_YLW" "$C_RST" \
    "$warn_part" \
    "$ctx_part"
  exit 0
fi

if [ -z "$quest" ]; then
  print_idle
fi

# In session-scoped induct mode, drop to idle if the bound quest is already promoted/landed.
if [ -n "$sid" ] && [ "$mode" = "induct" ] && [ -f "$root/docs/quests/$quest/QUEST.md" ]; then
  if grep -q '^status: landed$' "$root/docs/quests/$quest/QUEST.md" 2>/dev/null; then
    print_idle
  fi
fi

rollup="$(cd "$root" && "$bp3_bin" q r "$quest" 2>/dev/null || true)"
if [ -z "$rollup" ] || ! printf '%s' "$rollup" | jq -e '.ok == true' >/dev/null 2>&1; then
  if [ -n "$ctx_str" ]; then
    printf '%sbp3:%s %s%s %s|%s %s\n' "$C_CYN" "$C_RST" "$quest" "$warn_part" "$C_DIM" "$C_RST" "$ctx_str"
  else
    printf '%sbp3:%s %s%s\n' "$C_CYN" "$C_RST" "$quest" "$warn_part"
  fi
  exit 0
fi

if [ -n "$sid" ] && [ "$mode" = "induct" ]; then
  if printf '%s' "$rollup" | jq -e '.state == "landed"' >/dev/null 2>&1; then
    print_idle
  fi
fi

IFS=$'\t' read -r total landed cur_node cur_state cur_cycle <<< "$(
  printf '%s' "$rollup" | jq -r '
    (.nodes | length) as $tot |
    ([.nodes[] | select(.state == "landed")] | length) as $land |
    (
      ([.nodes[] | select(.state == "handed_off")][0]) //
      ([.nodes[] | select(.state == "blocked")][0]) //
      ([.ready[0] as $r | .nodes[] | select(.node == $r)][0]) //
      null
    ) as $cur |
    [
      $tot,
      $land,
      (if ($cur.node // "") == "" then "__NONE__" else $cur.node end),
      (if ($cur.state // "") == "" then "__NONE__" else $cur.state end),
      ($cur.cycle // 0)
    ] | @tsv' 2>/dev/null || true
)"
[ "${cur_node:-}" = "__NONE__" ] && cur_node=""
[ "${cur_state:-}" = "__NONE__" ] && cur_state=""

total="${total:-0}"
landed="${landed:-0}"
pct=0
[ "$total" -gt 0 ] && pct=$(( landed * 100 / total ))
bar="$(fmt_bar "$landed" "$total")"

# Shorten node slug: strip leading "node-" for compact display
short_node="${cur_node#node-}"
if [ -n "$short_node" ]; then
  node_color="$C_CYN"
  [ "$cur_state" = "blocked" ] && node_color="$C_RED"
  [ "$cur_state" = "handed_off" ] && node_color="$C_YLW"
  node_part="${node_color}${short_node} (${cur_state} c${cur_cycle})${C_RST}"
elif [ "$total" -gt 0 ] && [ "$landed" -eq "$total" ]; then
  node_part="${C_GRN}finished (goal_fin)${C_RST}"
else
  node_part="${C_DIM}idle${C_RST}"
fi

# Wall time since quest creation from quest storage ref
wall_part=""
first_ts="$(git -C "$root" show "refs/heads/bp3/quest/${quest}:docs/quests/${quest}/ledger.jsonl" 2>/dev/null | head -n 1 | jq -r '.ts // empty' 2>/dev/null || true)"
if [ -n "$first_ts" ]; then
  start_ep="$(parse_iso_epoch "$first_ts")"
  now_ep="$(date -u +%s)"
  if [ -n "$start_ep" ] && [ "$now_ep" -ge "$start_ep" ]; then
    wall_part=" ${C_DIM}|${C_RST} $(fmt_wall $(( now_ep - start_ep )))"
  fi
fi

ctx_part=""
[ -n "$ctx_str" ] && ctx_part=" ${C_DIM}|${C_RST} ${ctx_str}"

printf '%s%sbp3:%s %s %s%s%s %d/%d (%d%%) %s|%s %s%s%s%s\n' \
  "$C_BLD" "$C_CYN" "$C_RST" \
  "$quest" \
  "$C_GRN" "$bar" "$C_RST" \
  "$landed" "$total" "$pct" \
  "$C_DIM" "$C_RST" \
  "$node_part" \
  "$wall_part" \
  "$warn_part" \
  "$ctx_part"
exit 0
