#!/usr/bin/env bash
# bp3 project tooling (pre-binary). The OCaml CLI absorbs these subcommands
# later; the interface stays: bp3 skills install [--global] --harness=<name|all>.
# Mode (dogfood.3) is derived from the target repo, never passed as a
# flag: self = tracked src/quest + bin/bp3 (bp3 is the product), host =
# neither tracked (bp3 is a tool).
# global-skills-and-backpack-toml (global.1): CORE_SKILLS (7) and bp3 hooks
# install user-globally under $BP3_GLOBAL_HOME / $HOME (matching yap);
# DEV_SKILLS (3) render repo-locally only inside bp3 (self mode).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Skills source: repo layout ($root/skills), installed layout
# ($root/share/bp3/skills), or BP3_SKILLS_DIR for an explicit source.
if [ -n "${BP3_SKILLS_DIR:-}" ]; then
  src_dir="$BP3_SKILLS_DIR"
elif [ -d "$root/skills" ]; then
  src_dir="$root/skills"
else
  src_dir="$root/share/bp3/skills"
fi
if [ -n "${BP3_CHECK_SKILLS:-}" ]; then
  check_skills_bin="$BP3_CHECK_SKILLS"
elif [ -f "$root/scripts/check-skills" ]; then
  check_skills_bin="$root/scripts/check-skills"
else
  check_skills_bin="$root/share/bp3/scripts/check-skills"
fi
if [ -d "$root/completions" ]; then
  completions_dir="$root/completions"
else
  completions_dir="$root/share/bp3/completions"
fi

# Skill sets (dogfood.3): one spelling, named here only. A source
# skill in neither list installs nowhere (fail-closed for hosts);
# test/mode.sh asserts every source skill is listed exactly once.
CORE_SKILLS="induct induct-yolo quest icebox naming red-ink warden"
DEV_SKILLS="add-bp3-skill add-yap-skill using-bp3"

# Layout: every path and name this script spells, named here only
# (the engine's twin is src/quest/layout.ml). A rename edits these.
ENGINE_SRC="src/quest"
WORKFLOWS_DIR=".agents/workflows"
# Workflow renders are retired plain copies (no notice to key on), so
# legacy ones in downstream repos are pruned by explicit name.
RETIRED_WORKFLOWS="bp3g-grade bp3g-land bp3g-node node-loop induct-grade induct-land induct-node"
# Retired bp3 skills whose .pi/settings.json exclusions should also be pruned.
RETIRED_SKILLS="bp3g bp3g-frame bp3g-no-human bp3g-landing-demo traverse traverse-no-human induct-inline induct-inline-yolo"

global_home() {
  printf '%s\n' "${BP3_GLOBAL_HOME:-$HOME}"
}

# Target repo: BP3_TARGET wins; else the cwd repo when it is not
# this script's own repo; else this script's repo (self conduct
# and non-git copies, e.g. test fixtures, keep the old behavior).
target_root() {
  if [ -n "${BP3_TARGET:-}" ]; then
    echo "$BP3_TARGET"; return 0
  fi
  local cwd_top='' src_top=''
  cwd_top="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  src_top="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -d "$root/skills" ] && { [ -z "$src_top" ] || [ "$cwd_top" = "$src_top" ]; }; then
    echo "$root"
  elif [ -n "$cwd_top" ]; then
    echo "$cwd_top"
  else
    echo "$root"
  fi
}

repo_mode() {
  if git -C "$1" ls-files --error-unmatch -- "$ENGINE_SRC" bin/bp3 >/dev/null 2>&1; then
    echo "self"
  else
    echo "host"
  fi
}

mode_flag_error() {
  echo "mode is derived from the repo (tracked $ENGINE_SRC + bin/bp3), never passed as a flag: $1" >&2
  exit 2
}

# User-global skill roots for CORE_SKILLS (matching yap; codex/muse use
# ~/.codex/skills and ~/.muse/skills rather than ~/.agents/skills so pi
# never double-discovers global bp3 skills).
global_harness_target() {
  case "$1" in
    pi)     echo ".pi/agent/skills" ;;
    claude) echo ".claude/skills" ;;
    codex)  echo ".codex/skills" ;;
    muse)   echo ".muse/skills" ;;
    agy)    echo ".gemini/config/skills" ;;
    *) return 1 ;;
  esac
}

# Repo-local skill roots for DEV_SKILLS (self mode only).
local_harness_target() {
  case "$1" in
    pi)     echo ".pi/skills" ;;
    claude) echo ".claude/skills" ;;
    codex)  echo ".agents/skills" ;;
    muse)   echo ".agents/skills" ;;
    agy)    echo ".agents/skills" ;;
    *) return 1 ;;
  esac
}

current_release_tag() {
  local release_file="${BP3_SHARE_DIR:-$root/share/bp3}/RELEASE"
  if [ -f "$release_file" ] && command -v jq >/dev/null 2>&1; then
    jq -r '.tag // empty' "$release_file" 2>/dev/null || true
  fi
}

install_one() {
  local scope="$1" skill="$2" harness="$3" base="$4" target_dir dest release_tag=""
  release_tag="$(current_release_tag)"
  if [ "$scope" = "global" ]; then
    target_dir="$(global_harness_target "$harness")"
  else
    target_dir="$(local_harness_target "$harness")"
  fi
  dest="$base/$target_dir/$skill"
  mkdir -p "$dest"
  awk -v h="$harness" -v s="$skill" -v rt="$release_tag" '
    /^---$/ {
      n++; print;
      if (n == 2) {
        if (rt != "") printf "<!-- GENERATED from skills/%s/SKILL.md (%s) by: bp3 skills install --harness=%s. Edit the source, then re-run. -->\n", s, rt, h;
        else printf "<!-- GENERATED from skills/%s/SKILL.md by: bp3 skills install --harness=%s. Edit the source, then re-run. -->\n", s, h;
      }
      next
    }
    { print }' "$src_dir/$skill/SKILL.md" > "$dest/SKILL.md"
  echo "installed $skill -> $target_dir/$skill/SKILL.md ($harness, $scope)"
}

# Remove renders this script generated (the GENERATED notice) whose skill
# is no longer in keep_skills; hand-written and yap skills carry no notice.
prune_stale_in() {
  local base="$1" target_dir="$2" keep_skills="$3" dir name
  [ -d "$base/$target_dir" ] || return 0
  for dir in "$base/$target_dir"/*/; do
    [ -f "$dir/SKILL.md" ] || continue
    name="$(basename "$dir")"
    case " $keep_skills " in *" $name "*) continue ;; esac
    grep -q '^<!-- GENERATED from skills/' "$dir/SKILL.md" || continue
    rm -rf "$dir"
    echo "pruned $name -> $target_dir/$name (no longer in the skill set)"
  done
}

# Plan non-clobbering Claude/Muse hook merge: keep every non-bp3 hook handler
# and upsert one "bp3 q hooks || true" handler per event.
plan_claude_hooks_merge() {
  local path="$1" hook_cmd="$2" include_post_llm="$3" existing='{}'
  if [ -e "$path" ]; then
    existing="$(jq -sce 'select(length == 1) | .[0] | select(type == "object")' "$path")" \
      || { echo "invalid JSON object in $path" >&2; return 1; }
  fi
  local events='["SessionStart","PreToolUse","PostToolUse","PostToolUseFailure","SubagentStart","SubagentStop","Stop","SessionEnd"]'
  if [ "$include_post_llm" = "1" ]; then
    events='["SessionStart","PreToolUse","PostToolUse","PostToolUseFailure","PostLLMCall","SubagentStart","SubagentStop","Stop","SessionEnd"]'
  fi
  # shellcheck disable=SC2016 # jq variables inside single quotes
  jq -ce --arg cmd "$hook_cmd" --argjson events "$events" '
    if has("hooks") and (.hooks | type != "object") then error("hooks must be an object") else . end |
    .hooks = ((.hooks // {}) |
      reduce $events[] as $ev (.;
        (.[$ev] // []) as $arr |
        if ($arr | type) != "array" then error("hook event must be array") else . end |
        .[$ev] = (
          ($arr | map(select(((.hooks // []) | any(.command? | type == "string" and contains("bp3 q hooks"))) | not)))
          + [{"hooks": [{"type": "command", "command": $cmd}]}]
        )
      )
    )
  ' <<< "$existing" || { echo "invalid hooks structure in $path" >&2; return 1; }
}

# Plan non-clobbering agy global hooks merge: upsert only top-level "bp3" key
# in ~/.gemini/config/hooks.json, preserving every other named hook group.
plan_agy_hooks_merge() {
  local path="$1" hook_cmd="$2" existing='{}'
  if [ -e "$path" ]; then
    existing="$(jq -sce 'select(length == 1) | .[0] | select(type == "object")' "$path")" \
      || { echo "invalid JSON object in $path" >&2; return 1; }
  fi
  # shellcheck disable=SC2016 # jq variables inside single quotes
  jq -ce --arg cmd "$hook_cmd" '
    .bp3 = {
      "SessionStart": [{"type": "command", "command": $cmd}],
      "PreToolUse": [{"matcher": "run_command", "hooks": [{"type": "command", "command": $cmd}]}],
      "PostToolUse": [{"matcher": "run_command", "hooks": [{"type": "command", "command": $cmd}]}],
      "Stop": [{"type": "command", "command": $cmd}]
    }
  ' <<< "$existing" || { echo "invalid hooks structure in $path" >&2; return 1; }
}

write_json_atomic() {
  local dest="$1" json_payload="$2" tmp
  mkdir -p "$(dirname "$dest")"
  tmp="$(mktemp "$(dirname "$dest")/$(basename "$dest").XXXXXX")"
  printf '%s\n' "$json_payload" | jq . > "$tmp"
  mv "$tmp" "$dest"
}

skills_install() {
  local harness="all" global_only=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode|--mode=*) mode_flag_error "$1" ;;
      --global) global_only=1 ;;
      --harness=*) harness="${1#--harness=}" ;;
      --harness) [ $# -ge 2 ] || { echo '--harness needs a value' >&2; exit 2; }; harness="$2"; shift ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
  done

  local harnesses
  if [ "$harness" = "all" ]; then
    harnesses="pi claude codex muse agy"
  else
    harnesses="$harness"
  fi

  local ghome target="" mode="global"
  ghome="$(global_home)"
  if [ "$global_only" -eq 0 ]; then
    target="$(target_root)"
    mode="$(repo_mode "$target")"
    echo "mode: $mode (derived from $target: tracked $ENGINE_SRC + bin/bp3)"
  else
    echo "mode: global (user-global CORE_SKILLS + hooks -> $ghome)"
  fi

  # Preflight every source, selected harness, and target JSON file before writing.
  "$check_skills_bin" "$src_dir"
  local h
  for h in $harnesses; do
    global_harness_target "$h" >/dev/null || { echo "unknown harness: $h" >&2; exit 2; }
  done

  local hook_cmd="bp3 q hooks || true"
  local claude_hooks_plan='' agy_hooks_plan='' muse_hooks_plan=''
  case " $harnesses " in
    *" claude "*)
      claude_hooks_plan="$(plan_claude_hooks_merge "$ghome/.claude/settings.json" "$hook_cmd" 0)" || exit 1
      ;;
  esac
  case " $harnesses " in
    *" agy "*)
      agy_hooks_plan="$(plan_agy_hooks_merge "$ghome/.gemini/config/hooks.json" "$hook_cmd")" || exit 1
      ;;
  esac
  case " $harnesses " in
    *" muse "*)
      muse_hooks_plan="$(plan_claude_hooks_merge "$ghome/.muse/hooks.json" "$hook_cmd" 1)" || exit 1
      ;;
  esac

  # Self mode: plan .pi/settings.json exclusions for repo-local DEV_SKILLS only,
  # stripping CORE_SKILLS and RETIRED_SKILLS exclusions.
  local settings_plan='' existing='{}' ids drop_ids
  if [ "$global_only" -eq 0 ] && [ "$mode" = "self" ]; then
    case " $harnesses " in
      *" pi "*)
        if [ -e "$target/.pi/settings.json" ]; then
          existing="$(jq -sce 'select(length == 1) | .[0] | select(type == "object")' "$target/.pi/settings.json")" || { echo 'invalid .pi/settings.json' >&2; exit 1; }
        fi
        # shellcheck disable=SC2086 # space-separated skill lists by design
        ids="$(printf '%s\n' $DEV_SKILLS | LC_ALL=C sort | jq -Rsc 'split("\n") | map(select(length > 0))')"
        # shellcheck disable=SC2086 # space-separated skill lists by design
        drop_ids="$(printf '%s\n' $CORE_SKILLS $RETIRED_SKILLS | LC_ALL=C sort -u | jq -Rsc 'split("\n") | map(select(length > 0))')"
        # shellcheck disable=SC2016 # jq variables inside single quotes
        settings_plan="$(jq -ce --argjson ids "$ids" --argjson drop "$drop_ids" '
          if has("skills") and (.skills | type != "array" or any(.[]; type != "string")) then error("skills must be an array of strings") else . end |
          ([$drop[] | "!**/.agents/skills/" + . + "/SKILL.md"]) as $rm |
          ((.skills // []) | map(select(. as $p | $rm | index($p) | not))) as $kept |
          .skills = ($kept + [$ids[] | "!**/.agents/skills/" + . + "/SKILL.md" | select(. as $p | $kept | index($p) | not)])
        ' <<< "$existing")" || { echo 'invalid .pi/settings.json skills list' >&2; exit 1; }
        ;;
    esac
  fi

  # 1. Install CORE_SKILLS user-globally and prune stale global generated skills.
  local skill
  for skill in $CORE_SKILLS; do
    [ -f "$src_dir/$skill/SKILL.md" ] || continue
    for h in $harnesses; do
      install_one global "$skill" "$h" "$ghome"
    done
  done
  for h in $harnesses; do
    prune_stale_in "$ghome" "$(global_harness_target "$h")" "$CORE_SKILLS"
  done

  # 2. Write non-clobbering global hooks (gate on backpack.toml at runtime).
  if [ -n "$claude_hooks_plan" ]; then
    write_json_atomic "$ghome/.claude/settings.json" "$claude_hooks_plan"
    echo "installed global hooks -> $ghome/.claude/settings.json"
  fi
  if [ -n "$agy_hooks_plan" ]; then
    write_json_atomic "$ghome/.gemini/config/hooks.json" "$agy_hooks_plan"
    echo "installed global hooks -> $ghome/.gemini/config/hooks.json"
  fi
  if [ -n "$muse_hooks_plan" ]; then
    write_json_atomic "$ghome/.muse/hooks.json" "$muse_hooks_plan"
    echo "installed global hooks -> $ghome/.muse/hooks.json"
  fi

  # 3. Self mode only: render DEV_SKILLS repo-locally & prune local CORE_SKILLS.
  if [ "$global_only" -eq 0 ] && [ "$mode" = "self" ]; then
    for skill in $DEV_SKILLS; do
      [ -f "$src_dir/$skill/SKILL.md" ] || continue
      for h in $harnesses; do
        install_one local "$skill" "$h" "$target"
      done
    done
    for h in $harnesses; do
      prune_stale_in "$target" "$(local_harness_target "$h")" "$DEV_SKILLS"
    done
    if [ -n "$settings_plan" ]; then
      mkdir -p "$target/.pi"
      printf '%s\n' "$settings_plan" | jq . > "$target/.pi/settings.json"
    fi
    local workflow_name
    for workflow_name in $RETIRED_WORKFLOWS; do
      if [ -f "$target/$WORKFLOWS_DIR/$workflow_name.js" ]; then
        rm -f "$target/$WORKFLOWS_DIR/$workflow_name.js"
        echo "pruned $workflow_name -> $WORKFLOWS_DIR/$workflow_name.js (retired workflow)"
      fi
    done
    if [ -d "$target/$WORKFLOWS_DIR" ]; then
      rmdir "$target/$WORKFLOWS_DIR" 2>/dev/null || true
    fi
  fi

  # 4. Tab completion delivery (skipped when --global or BP3_SKIP_COMPLETIONS=1).
  local comp_src="$completions_dir/_bp3" comp_bash_src="$completions_dir/bp3.bash"
  if [ "$global_only" -eq 0 ] && [ "${BP3_SKIP_COMPLETIONS:-}" != "1" ] && [ -f "$comp_src" ]; then
    local comp_dest=''
    if [ -n "${BP3_COMPLETIONS_DIR:-}" ]; then
      comp_dest="$BP3_COMPLETIONS_DIR"
    else
      local cand
      for cand in "${ZDOTDIR:-$HOME}/.zsh/completions" "$HOME/.zsh/completions" \
        /opt/homebrew/share/zsh/site-functions /usr/local/share/zsh/site-functions \
        "$HOME/.local/share/zsh/site-functions"; do
        if [ -d "$cand" ]; then comp_dest="$cand"; break; fi
      done
    fi
    if [ -n "$comp_dest" ]; then
      mkdir -p "$comp_dest"
      cp "$comp_src" "$comp_dest/_bp3"
      echo "installed _bp3 -> $comp_dest/_bp3"
      echo "completion: source $comp_bash_src (bash)"
    else
      echo "completion: add $completions_dir to fpath (zsh: fpath=($completions_dir \$fpath); compinit) or source $comp_bash_src (bash)"
    fi
  fi

  # 5. Auto-register target git repo in bp3.sqlite (fail-fast, skipped on --global).
  if [ "$global_only" -eq 0 ] && git -C "$target" rev-parse --git-common-dir >/dev/null 2>&1; then
    local reg_bin='' cand_bin
    cand_bin="$(q_bin)"
    if [[ -x $cand_bin ]]; then
      reg_bin="$cand_bin"
    elif [ ! -d "$root/skills" ] && command -v bp3-q >/dev/null 2>&1; then
      reg_bin="$(command -v bp3-q)"
    fi
    if [ -n "$reg_bin" ]; then
      BP3_ROOT="$target" "$reg_bin" repo add "$target" >/dev/null
    fi
  fi
}

# Remove duplicated repo-local bp3 GENERATED skill copies and legacy repo-local
# bp3 hooks without ever touching repo-owned skills or non-bp3 user hooks.
skills_prune_local() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --mode|--mode=*) mode_flag_error "$arg" ;;
      *) echo "unknown arg: $arg" >&2; exit 2 ;;
    esac
  done
  local target mode keep_skills=""
  target="$(target_root)"
  mode="$(repo_mode "$target")"
  if [ "$mode" = "self" ]; then
    keep_skills="$DEV_SKILLS"
  fi
  local pruned_skills_json="" pruned_hooks_json=""
  local d dir name
  for d in .pi/skills .claude/skills .agents/skills; do
    [ -d "$target/$d" ] || continue
    for dir in "$target/$d"/*/; do
      [ -f "$dir/SKILL.md" ] || continue
      name="$(basename "$dir")"
      case " $keep_skills " in *" $name "*) continue ;; esac
      grep -q '^<!-- GENERATED from skills/' "$dir/SKILL.md" || continue
      rm -rf "$dir"
      pruned_skills_json="${pruned_skills_json}\"$d/$name\","
    done
    rmdir "$target/$d" 2>/dev/null || true
  done

  # Prune retired workflows
  local wf
  for wf in $RETIRED_WORKFLOWS; do
    if [ -f "$target/$WORKFLOWS_DIR/$wf.js" ]; then
      rm -f "$target/$WORKFLOWS_DIR/$wf.js"
    fi
  done
  [ -d "$target/$WORKFLOWS_DIR" ] && rmdir "$target/$WORKFLOWS_DIR" 2>/dev/null || true

  # Prune legacy repo-local bp3 hook files / entries safely
  for hf in .claude/hooks.json .muse/hooks.json; do
    if [ -f "$target/$hf" ] && grep -q 'bp3 q hooks' "$target/$hf"; then
      rm -f "$target/$hf"
      pruned_hooks_json="${pruned_hooks_json}\"$hf\","
      rmdir "$(dirname "$target/$hf")" 2>/dev/null || true
    fi
  done
  if [ -f "$target/.agents/hooks.json" ] && jq -e 'type == "object" and has("bp3")' "$target/.agents/hooks.json" >/dev/null 2>&1; then
    local rem_agy
    rem_agy="$(jq -c 'del(.bp3)' "$target/.agents/hooks.json")"
    pruned_hooks_json="${pruned_hooks_json}\".agents/hooks.json\","
    if [ "$rem_agy" = "{}" ]; then
      rm -f "$target/.agents/hooks.json"
      rmdir "$target/.agents" 2>/dev/null || true
    else
      write_json_atomic "$target/.agents/hooks.json" "$rem_agy"
    fi
  fi
  if [ -f "$target/.claude/settings.json" ] && grep -q 'bp3 q hooks' "$target/.claude/settings.json"; then
    local rem_claude
    # shellcheck disable=SC2016 # jq variables inside single quotes
    rem_claude="$(jq -c '
      if (.hooks | type) == "object" then
        .hooks = (.hooks | with_entries(
          .value = (if (.value | type) == "array" then
            (.value | map(select(((.hooks // []) | any(.command? | type == "string" and contains("bp3 q hooks"))) | not)))
          else .value end)
        ) | with_entries(select((.value | type) != "array" or (.value | length) > 0)))
        | if (.hooks | length) == 0 then del(.hooks) else . end
      else . end
    ' "$target/.claude/settings.json")"
    pruned_hooks_json="${pruned_hooks_json}\".claude/settings.json\","
    if [ "$rem_claude" = "{}" ]; then
      rm -f "$target/.claude/settings.json"
      rmdir "$target/.claude" 2>/dev/null || true
    else
      write_json_atomic "$target/.claude/settings.json" "$rem_claude"
    fi
  fi
  if [ -f "$target/.pi/settings.json" ] && jq -e 'type == "object" and (.skills | type == "array")' "$target/.pi/settings.json" >/dev/null 2>&1; then
    local drop_pi rem_pi
    if [ "$mode" = "self" ]; then
      # shellcheck disable=SC2086 # space-separated skill lists by design
      drop_pi="$(printf '%s\n' $CORE_SKILLS $RETIRED_SKILLS | LC_ALL=C sort -u | jq -Rsc 'split("\n") | map(select(length > 0))')"
    else
      # shellcheck disable=SC2086 # space-separated skill lists by design
      drop_pi="$(printf '%s\n' $CORE_SKILLS $DEV_SKILLS $RETIRED_SKILLS | LC_ALL=C sort -u | jq -Rsc 'split("\n") | map(select(length > 0))')"
    fi
    # shellcheck disable=SC2016 # jq variables inside single quotes
    rem_pi="$(jq -c --argjson drop "$drop_pi" '
      ([$drop[] | "!**/.agents/skills/" + . + "/SKILL.md"]) as $rm |
      .skills = (.skills | map(select(. as $p | $rm | index($p) | not))) |
      if (.skills | length) == 0 then del(.skills) else . end
    ' "$target/.pi/settings.json")"
    if [ "$rem_pi" = "{}" ]; then
      rm -f "$target/.pi/settings.json"
      rmdir "$target/.pi" 2>/dev/null || true
    else
      write_json_atomic "$target/.pi/settings.json" "$rem_pi"
    fi
  fi

  printf '{"ok":true,"mode":"%s","pruned_skills":[%s],"pruned_hooks":[%s]}\n' \
    "$mode" "${pruned_skills_json%,}" "${pruned_hooks_json%,}"
}

# Render freshness (followup.2, global.1): check global CORE_SKILLS renders
# (plus repo-local DEV_SKILLS in self mode). Body equality plus release tag
# match when share/bp3/RELEASE is present.
strip_generated_notice() {
  awk '
    !done && /^---$/ { n++; print; next }
    !done && n == 2 {
      done = 1
      if (/^<!-- GENERATED from skills\//) next
    }
    { print }' "$1"
}

generated_notice_line() {
  awk '
    /^---$/ { n++; next }
    n == 2 { print; exit }' "$1"
}

check_one_skill_render() {
  local skill="$1" base="$2" rel_dir="$3" release_tag="$4"
  local src_skill="$src_dir/$skill/SKILL.md"
  local render_skill="$base/$rel_dir/$skill/SKILL.md"
  local notice is_stale=0
  if [ ! -f "$render_skill" ]; then
    is_stale=1
  else
    notice="$(generated_notice_line "$render_skill")"
    if [ -n "$release_tag" ]; then
      case "$notice" in
        "<!-- GENERATED from skills/$skill/SKILL.md ($release_tag) by: bp3 skills install --harness="*) ;;
        *) is_stale=1 ;;
      esac
    else
      case "$notice" in
        "<!-- GENERATED from skills/$skill/SKILL.md"*" by: bp3 skills install --harness="*) ;;
        *) is_stale=1 ;;
      esac
    fi
    if [ "$is_stale" -eq 0 ] && ! strip_generated_notice "$render_skill" | cmp -s - "$src_skill"; then
      is_stale=1
    fi
  fi
  return "$is_stale"
}

skills_check() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --mode|--mode=*) mode_flag_error "$arg" ;;
      *) echo "unknown arg: $arg" >&2; exit 2 ;;
    esac
  done
  local ghome target mode release_tag=""
  ghome="$(global_home)"
  target="$(target_root)"
  mode="$(repo_mode "$target")"
  release_tag="$(current_release_tag)"

  local stale_json="" stale_count=0 skills_checked=0
  local global_dirs="" d skill
  for d in .gemini/config/skills .claude/skills .pi/agent/skills .codex/skills .muse/skills; do
    if [ -d "$ghome/$d" ]; then
      global_dirs="${global_dirs:+$global_dirs }$d"
    fi
  done
  if [ -z "$global_dirs" ]; then
    global_dirs=".gemini/config/skills .claude/skills .pi/agent/skills .codex/skills .muse/skills"
  fi
  for d in $global_dirs; do
    for skill in $CORE_SKILLS; do
      [ -f "$src_dir/$skill/SKILL.md" ] || continue
      skills_checked=$((skills_checked + 1))
      if ! check_one_skill_render "$skill" "$ghome" "$d" "$release_tag"; then
        stale_count=$((stale_count + 1))
        stale_json="${stale_json}{\"skill\":\"$skill\",\"render\":\"$ghome/$d/$skill/SKILL.md\",\"source\":\"skills/$skill/SKILL.md\"},"
      fi
    done
  done

  if [ "$mode" = "self" ]; then
    local local_dirs=""
    for d in .pi/skills .claude/skills .agents/skills; do
      if [ -d "$target/$d" ]; then
        local_dirs="${local_dirs:+$local_dirs }$d"
      fi
    done
    if [ -z "$local_dirs" ]; then
      local_dirs=".pi/skills .claude/skills .agents/skills"
    fi
    for d in $local_dirs; do
      for skill in $DEV_SKILLS; do
        [ -f "$src_dir/$skill/SKILL.md" ] || continue
        skills_checked=$((skills_checked + 1))
        if ! check_one_skill_render "$skill" "$target" "$d" "$release_tag"; then
          stale_count=$((stale_count + 1))
          stale_json="${stale_json}{\"skill\":\"$skill\",\"render\":\"$d/$skill/SKILL.md\",\"source\":\"skills/$skill/SKILL.md\"},"
        fi
      done
    done
  fi

  if [ "$stale_count" -gt 0 ]; then
    if [ "$mode" = "self" ]; then
      printf '{"ok":false,"error":{"code":"E_RENDER_STALE","facts":{"stale":[%s]},"guidance":"Re-render in the desk (./bin/bp3 skills install) and re-check; never launch a stale render."}}\n' "${stale_json%,}"
    else
      printf '{"ok":false,"error":{"code":"E_RENDER_STALE","facts":{"stale":[%s]},"guidance":"Re-render global skills (bp3 skills install) and re-check; never launch a stale render."}}\n' "${stale_json%,}"
    fi
    exit 1
  fi
  printf '{"ok":true,"fresh":[],"skills_checked":%d}\n' "$skills_checked"
}

usage_text='usage: bp3 init [--harness=<pi|claude|codex|muse|agy|all>] | bp3 init-repo | bp3 skills install [--global] [--harness=...] | bp3 skills check | bp3 skills prune-local | bp3 q ... | bp3 warden [<quest>] [--last N|--all] [--no-sessions] [--format json|table] | bp3 release (<quest> | --commit <sha>) [...] | bp3 db info [--format json|table] | bp3 repo add|list|remove [...] | bp3 ticket add|list|read|claim|unclaim|done|dismiss [...] | bp3 harness desk derive|create|inspect|remove|prepare|check|exit|release|list|prune ... | bp3 worktree ... (alias of harness desk) | bp3 config [--source] [--format json|table]'
q_bin() { echo "${BP3_Q_BIN:-$root/_build/default/$ENGINE_SRC/main.exe}"; }
run_q() {
  local door="$1"; shift
  local gb
  gb="$(q_bin)"
  if [[ -x $gb ]]; then
    if [[ $door == db || $door == repo || $door == ticket ]]; then
      exec "$gb" "$door" "$@"
    else
      BP3_ROOT="$root" exec "$gb" "$door" "$@"
    fi
  elif command -v bp3-q >/dev/null 2>&1; then
    # Installed tool (host mode): the binary roots at the caller's repo.
    if [[ $door == db || $door == repo || $door == ticket ]]; then
      exec bp3-q "$door" "$@"
    else
      BP3_ROOT="$(target_root)" exec bp3-q "$door" "$@"
    fi
  elif [[ $door == q && ${1:-} == hooks ]]; then
    # Hooks fail open (hooks.ml): exit 2 would block every tool,
    # including the build that fixes this. Drain the payload.
    [[ -t 0 ]] || cat >/dev/null
    echo "bp3 q hooks: no q binary, event not recorded; dune build $ENGINE_SRC/main.exe" >&2; exit 0
  else
    echo "build the q binary first: dune build $ENGINE_SRC/main.exe" >&2; exit 2
  fi
}
case "${1:-}" in
  -h|--help) printf '%s\n' "$usage_text"; printf '%s\n' '  bp3 q -h for quest/node doors'; exit 0 ;;
  g)
    # Retired door (quest rename-back). Hooks registered before the
    # rename still call `g hooks`: fail open, never run the engine.
    if [ "${2:-}" = hooks ]; then
      [[ -t 0 ]] || cat >/dev/null
      echo "bp3 g was renamed to bp3 q; re-run bp3 skills install" >&2; exit 0
    fi
    echo "bp3 g was renamed to bp3 q" >&2; exit 2 ;;
  q) shift; run_q q "$@" ;;
  n) shift; run_q n "$@" ;;
  e) shift; run_q e "$@" ;;
  warden) shift; run_q warden "$@" ;;
  release) shift; run_q release "$@" ;;
  db) shift; run_q db "$@" ;;
  repo) shift; run_q repo "$@" ;;
  ticket) shift; run_q ticket "$@" ;;
  harness) shift; run_q harness "$@" ;;
  config) shift; run_q config "$@" ;;
  worktree) shift; run_q worktree "$@" ;;
  init-repo) shift; run_q init-repo "$@" ;;
  init) shift; skills_install "$@" ;;
  skills)
    shift
    case "${1:-}" in
      install) shift; skills_install "$@" ;;
      check) shift; skills_check "$@" ;;
      prune-local) shift; skills_prune_local "$@" ;;
      *) echo "$usage_text" >&2; exit 2 ;;
    esac
    ;;
  *) echo "$usage_text" >&2; exit 2 ;;
esac
