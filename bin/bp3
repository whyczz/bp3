#!/usr/bin/env bash
# Project entry point. Keep the existing skills installer independent of the
# OCaml toolchain; all coordination commands go to an explicitly built binary.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
src_dir="$root/skills"

# harness -> skills_dir. Sources are plain Markdown: no templating in bp3.
# The render is a copy plus a GENERATED notice after the frontmatter.
harness_target() {
  case "$1" in
    pi)     echo ".pi/skills" ;;
    claude) echo ".claude/skills" ;;
    codex)  echo ".agents/skills" ;;
    muse)   echo ".agents/skills" ;;
    *) return 1 ;;
  esac
}

install_one() {
  local skill="$1" harness="$2" target_dir dest
  target_dir="$(harness_target "$harness")"
  dest="$root/$target_dir/$skill"
  mkdir -p "$dest"
  awk -v h="$harness" -v s="$skill" '
    /^---$/ { n++; print; if (n == 2) printf "<!-- GENERATED from skills/%s/SKILL.md by: bp3 skills install --harness=%s. Edit the source, then re-run. -->\n", s, h; next }
    { print }' "$src_dir/$skill/SKILL.md" > "$dest/SKILL.md"
  echo "installed $skill -> $target_dir/$skill/SKILL.md ($harness)"
}

skills_install() {
  local harness="all"
  while [ $# -gt 0 ]; do
    case "$1" in
      --harness=*) harness="${1#--harness=}" ;;
      --harness) [ $# -ge 2 ] || { echo '--harness needs a value' >&2; exit 2; }; harness="$2"; shift ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
  done

  local harnesses
  if [ "$harness" = "all" ]; then
    harnesses="pi claude codex muse"
  else
    harnesses="$harness"
  fi

  # Preflight every source and the selected harness before writing any render.
  "$root/scripts/check-skills" "$src_dir"
  local h
  for h in $harnesses; do
    harness_target "$h" >/dev/null || { echo "unknown harness: $h" >&2; exit 2; }
  done

  # Pi discovers .agents as well as .pi. Prefer our Pi copies per project,
  # without deleting Codex/Muse skills or hiding unrelated .agents skills.
  local settings_plan='' existing='{}' ids
  case " $harnesses " in
    *" pi "*)
      if [ -e "$root/.pi/settings.json" ]; then
        existing="$(jq -sce 'select(length == 1) | .[0] | select(type == "object")' "$root/.pi/settings.json")" || { echo 'invalid .pi/settings.json' >&2; exit 1; }
      fi
      ids="$(find "$src_dir" -mindepth 2 -maxdepth 2 -name SKILL.md | while IFS= read -r file; do basename "$(dirname "$file")"; done | LC_ALL=C sort | jq -Rsc 'split("\n") | map(select(length > 0))')"
      settings_plan="$(jq -ce --argjson ids "$ids" '
        if has("skills") and (.skills | type != "array" or any(.[]; type != "string")) then error("skills must be an array of strings") else . end |
        (.skills // []) as $existing |
        .skills = ($existing + [$ids[] | "!**/.agents/skills/" + . + "/SKILL.md" | select(. as $p | $existing | index($p) | not)])
      ' <<< "$existing")" || { echo 'invalid .pi/settings.json skills list' >&2; exit 1; }
      ;;
  esac

  local skill_dir skill
  for skill_dir in "$src_dir"/*/; do
    skill="$(basename "$skill_dir")"
    [ -f "$skill_dir/SKILL.md" ] || continue
    for h in $harnesses; do
      install_one "$skill" "$h"
    done
  done
  if [ -n "$settings_plan" ]; then
    printf '%s\n' "$settings_plan" | jq . > "$root/.pi/settings.json"
  fi
  # Note: codex and muse share .agents/skills; under --harness=all the muse
  # render (same dir) is written last. Invocation text differs only in the
  # trigger line; both harnesses accept the skill by name.
}

case "${1:-}" in
  skills)
    shift
    case "${1:-}" in
      install) shift; skills_install "$@" ;;
      *) echo "usage: bp3 skills install --harness=<pi|claude|codex|muse|all>" >&2; exit 2 ;;
    esac
    ;;
  *)
    # No implicit rebuild: running coordination must not change underneath a
    # Worker. Live fixtures use a frozen binary; BP3_CORE selects one explicitly.
    core="${BP3_CORE:-$root/_build/default/core/control/main.exe}"
    [[ -x $core ]] || { echo 'build the genesis CLI first: dune build core/control/main.exe' >&2; exit 2; }
    exec "$core" "$@"
    ;;
esac
