#!/usr/bin/env bash
# bp3 project tooling (pre-binary). The OCaml CLI absorbs these subcommands
# later; the interface stays: bp3 skills install --harness=<name|all>.
# Mode (dogfood.3) is derived from the target repo, never passed as a
# flag: self = tracked src/quest + bin/bp3 (bp3 is the product), host =
# neither tracked (bp3 is a tool). Core skills install everywhere; the
# bp3-dev overlay installs only in self mode.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Skills source: repo layout ($root/skills), installed layout
# ($root/share/bp3/skills), or BP3_SKILLS_DIR for an explicit source.
if [ -n "${BP3_SKILLS_DIR:-}" ]; then
  src_dir="$BP3_SKILLS_DIR"
elif [ -d "$root/skills" ]; then
  src_dir="$root/skills"
else
  src_dir="$root/share/bp3/skills"
fi
if [ -n "${BP3_CHECK_SKILLS:-}" ]; then
  check_skills_bin="$BP3_CHECK_SKILLS"
elif [ -f "$root/scripts/check-skills" ]; then
  check_skills_bin="$root/scripts/check-skills"
else
  check_skills_bin="$root/share/bp3/scripts/check-skills"
fi
if [ -d "$root/completions" ]; then
  completions_dir="$root/completions"
else
  completions_dir="$root/share/bp3/completions"
fi

# Skill sets (dogfood.3): one spelling, named here only. A source
# skill in neither list installs nowhere (fail-closed for hosts);
# test/mode.sh asserts every source skill is listed exactly once.
CORE_SKILLS="induct induct-inline induct-inline-yolo quest induct-yolo icebox naming red-ink warden"
DEV_SKILLS="add-bp3-skill add-yap-skill using-bp3"

# Layout: every path and name this script spells, named here only
# (the engine's twin is src/quest/layout.ml). A rename edits these.
ENGINE_SRC="src/quest"
WORKFLOW_SKILL="induct"
WORKFLOW_NAMES="node-loop induct-grade induct-land induct-node"
WORKFLOWS_DIR=".agents/workflows"
# Workflow renders are plain copies (no notice to key on), so renamed
# ones are pruned by explicit name.
RETIRED_WORKFLOWS="bp3g-grade bp3g-land bp3g-node"

# Target repo: BP3_TARGET wins; else the cwd repo when it is not
# this script's own repo; else this script's repo (self conduct
# and non-git copies, e.g. test fixtures, keep the old behavior).
target_root() {
  if [ -n "${BP3_TARGET:-}" ]; then
    echo "$BP3_TARGET"; return 0
  fi
  local cwd_top='' src_top=''
  cwd_top="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  src_top="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -d "$root/skills" ] && { [ -z "$src_top" ] || [ "$cwd_top" = "$src_top" ]; }; then
    echo "$root"
  elif [ -n "$cwd_top" ]; then
    echo "$cwd_top"
  else
    echo "$root"
  fi
}

repo_mode() {
  if git -C "$1" ls-files --error-unmatch -- "$ENGINE_SRC" bin/bp3 >/dev/null 2>&1; then
    echo "self"
  else
    echo "host"
  fi
}

mode_flag_error() {
  echo "mode is derived from the repo (tracked $ENGINE_SRC + bin/bp3), never passed as a flag: $1" >&2
  exit 2
}

# harness -> skills_dir. Sources are plain Markdown: no templating in bp3.
# The render is a copy plus a GENERATED notice after the frontmatter.
harness_target() {
  case "$1" in
    pi)     echo ".pi/skills" ;;
    claude) echo ".claude/skills" ;;
    codex)  echo ".agents/skills" ;;
    muse)   echo ".agents/skills" ;;
    agy)    echo ".agents/skills" ;;
    *) return 1 ;;
  esac
}

install_one() {
  local skill="$1" harness="$2" target="$3" target_dir dest release_tag=""
  local release_file="${BP3_SHARE_DIR:-$root/share/bp3}/RELEASE"
  if [ -f "$release_file" ] && command -v jq >/dev/null 2>&1; then
    release_tag="$(jq -r '.tag // empty' "$release_file" 2>/dev/null || true)"
  fi
  target_dir="$(harness_target "$harness")"
  dest="$target/$target_dir/$skill"
  mkdir -p "$dest"
  awk -v h="$harness" -v s="$skill" -v rt="$release_tag" '
    /^---$/ {
      n++; print;
      if (n == 2) {
        if (rt != "") printf "<!-- GENERATED from skills/%s/SKILL.md (%s) by: bp3 skills install --harness=%s. Edit the source, then re-run. -->\n", s, rt, h;
        else printf "<!-- GENERATED from skills/%s/SKILL.md by: bp3 skills install --harness=%s. Edit the source, then re-run. -->\n", s, h;
      }
      next
    }
    { print }' "$src_dir/$skill/SKILL.md" > "$dest/SKILL.md"
  echo "installed $skill -> $target_dir/$skill/SKILL.md ($harness)"
}

# A rename leaves the old render behind, still triggerable. Remove
# renders this script generated (the GENERATED notice) whose skill
# is no longer in the set; hand-written skills carry no notice.
prune_stale() {
  local harness="$1" target="$2" skills="$3" target_dir dir name
  target_dir="$(harness_target "$harness")"
  for dir in "$target/$target_dir"/*/; do
    [ -f "$dir/SKILL.md" ] || continue
    name="$(basename "$dir")"
    case " $skills " in *" $name "*) continue ;; esac
    grep -q '^<!-- GENERATED from skills/' "$dir/SKILL.md" || continue
    rm -rf "$dir"
    echo "pruned $name -> $target_dir/$name (no longer in the skill set)"
  done
}

skills_install() {
  local harness="all"
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode|--mode=*) mode_flag_error "$1" ;;
      --harness=*) harness="${1#--harness=}" ;;
      --harness) [ $# -ge 2 ] || { echo '--harness needs a value' >&2; exit 2; }; harness="$2"; shift ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
  done

  local harnesses
  if [ "$harness" = "all" ]; then
    harnesses="pi claude codex muse agy"
  else
    harnesses="$harness"
  fi

  local target mode skills
  target="$(target_root)"
  mode="$(repo_mode "$target")"
  skills="$CORE_SKILLS"
  if [ "$mode" = "self" ]; then
    skills="$CORE_SKILLS $DEV_SKILLS"
  fi
  echo "mode: $mode (derived from $target: tracked $ENGINE_SRC + bin/bp3)"

  # Preflight every source and the selected harness before writing any render.
  "$check_skills_bin" "$src_dir"
  local h
  for h in $harnesses; do
    harness_target "$h" >/dev/null || { echo "unknown harness: $h" >&2; exit 2; }
  done

  # Pi discovers .agents as well as .pi. Prefer our Pi copies per project,
  # without deleting Codex/Muse skills or hiding unrelated .agents skills.
  local settings_plan='' existing='{}' ids
  case " $harnesses " in
    *" pi "*)
      if [ -e "$target/.pi/settings.json" ]; then
        existing="$(jq -sce 'select(length == 1) | .[0] | select(type == "object")' "$target/.pi/settings.json")" || { echo 'invalid .pi/settings.json' >&2; exit 1; }
      fi
      # shellcheck disable=SC2086 # $skills is a space-separated word list by design
      ids="$(printf '%s\n' $skills | LC_ALL=C sort | jq -Rsc 'split("\n") | map(select(length > 0))')"
      settings_plan="$(jq -ce --argjson ids "$ids" '
        if has("skills") and (.skills | type != "array" or any(.[]; type != "string")) then error("skills must be an array of strings") else . end |
        (.skills // []) as $existing |
        .skills = ($existing + [$ids[] | "!**/.agents/skills/" + . + "/SKILL.md" | select(. as $p | $existing | index($p) | not)])
      ' <<< "$existing")" || { echo 'invalid .pi/settings.json skills list' >&2; exit 1; }
      ;;
  esac

  # The induct saved workflows ship with the induct skill (core, both
  # modes). They are plain copies (no render notice); the target is
  # the project workflows dir every harness discovers. Absent source
  # means nothing to copy.
  local workflow_names="$WORKFLOW_NAMES"

  local skill
  for skill in $skills; do
    [ -f "$src_dir/$skill/SKILL.md" ] || continue
    for h in $harnesses; do
      install_one "$skill" "$h" "$target"
    done
  done
  for h in $harnesses; do
    prune_stale "$h" "$target" "$skills"
  done
  if [ -n "$settings_plan" ]; then
    mkdir -p "$target/.pi"
    printf '%s\n' "$settings_plan" | jq . > "$target/.pi/settings.json"
  fi
  local workflow_name
  for workflow_name in $workflow_names; do
    if [ -f "$src_dir/$WORKFLOW_SKILL/workflows/$workflow_name.js" ]; then
      mkdir -p "$target/$WORKFLOWS_DIR"
      cp "$src_dir/$WORKFLOW_SKILL/workflows/$workflow_name.js" "$target/$WORKFLOWS_DIR/$workflow_name.js"
      echo "installed $workflow_name -> $WORKFLOWS_DIR/$workflow_name.js"
    fi
  done
  for workflow_name in $RETIRED_WORKFLOWS; do
    if [ -f "$target/$WORKFLOWS_DIR/$workflow_name.js" ]; then
      rm -f "$target/$WORKFLOWS_DIR/$workflow_name.js"
      echo "pruned $workflow_name -> $WORKFLOWS_DIR/$workflow_name.js (retired workflow)"
    fi
  done
  # Muse hook registration: one fail-open emitter command for
  # every event. Repos without this file never fire hooks. The
  # command is mode-aware (dogfood.3): self reads via the desk
  # script, host reads call bp3 on PATH. `|| true` makes fail-open
  # hold outside the script too: harnesses read exit 2 as "block",
  # so a broken wrapper (or a missing bp3 on PATH) must still exit 0.
  local hook_cmd="./bin/bp3 q hooks || true"
  if [ "$mode" = "host" ]; then
    hook_cmd="bp3 q hooks || true"
  fi
  mkdir -p "$target/.claude"
  {
    printf '{\n  "hooks": {\n'
    printf '    "SessionStart": [{"hooks": [{"type": "command", "command": "%s"}]}],\n' "$hook_cmd"
    printf '    "PreToolUse": [{"hooks": [{"type": "command", "command": "%s"}]}],\n' "$hook_cmd"
    printf '    "PostToolUse": [{"hooks": [{"type": "command", "command": "%s"}]}],\n' "$hook_cmd"
    printf '    "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "%s"}]}],\n' "$hook_cmd"
    printf '    "PostLLMCall": [{"hooks": [{"type": "command", "command": "%s"}]}],\n' "$hook_cmd"
    printf '    "SubagentStart": [{"hooks": [{"type": "command", "command": "%s"}]}],\n' "$hook_cmd"
    printf '    "SubagentStop": [{"hooks": [{"type": "command", "command": "%s"}]}],\n' "$hook_cmd"
    printf '    "Stop": [{"hooks": [{"type": "command", "command": "%s"}]}],\n' "$hook_cmd"
    printf '    "SessionEnd": [{"hooks": [{"type": "command", "command": "%s"}]}]\n' "$hook_cmd"
    printf '  }\n}\n'
  } > "$target/.claude/hooks.json"
  echo "installed hooks -> .claude/hooks.json"
  # Claude Code loads hooks from settings.json, not hooks.json
  # (live probe 2026-11-14: hooks.json alone never fired; the
  # same hooks under settings.json produced ledger event lines).
  # Merge into any existing settings, preserving other keys.
  # PostLLMCall is Muse-only; Claude Code warns on unknown events.
  local claude_settings="$target/.claude/settings.json"
  local existing_settings='{}'
  if [ -e "$claude_settings" ]; then
    existing_settings="$(cat "$claude_settings")"
  fi
  printf '%s\n' "$existing_settings" | jq --slurpfile hj "$target/.claude/hooks.json" \
    '.hooks = ($hj[0].hooks | del(.PostLLMCall))' > "$claude_settings.tmp"
  mv "$claude_settings.tmp" "$claude_settings"
  echo "installed hooks -> .claude/settings.json"
  # Muse hook registration: project tier .muse/hooks.json at the
  # workspace root (live probe 2026-11-13: fires in the main session
  # and in workflow children; no settings merge needed).
  case " $harnesses " in
    *" muse "*)
      mkdir -p "$target/.muse"
      cp "$target/.claude/hooks.json" "$target/.muse/hooks.json"
      echo "installed hooks -> .muse/hooks.json"
      ;;
  esac
  # Antigravity CLI (agy) hook registration: .agents/hooks.json uses
  # named top-level hook groups, flat SessionStart/Stop, grouped
  # PreToolUse/PostToolUse with matcher, and runs with cwd=.agents/.
  case " $harnesses " in
    *" agy "*)
      local agy_hook_cmd="../bin/bp3 q hooks || true"
      if [ "$mode" = "host" ]; then
        agy_hook_cmd="bp3 q hooks || true"
      fi
      mkdir -p "$target/.agents"
      {
        printf '{\n  "bp3": {\n'
        printf '    "SessionStart": [{"type": "command", "command": "%s"}],\n' "$agy_hook_cmd"
        printf '    "PreToolUse": [{"matcher": "run_command", "hooks": [{"type": "command", "command": "%s"}]}],\n' "$agy_hook_cmd"
        printf '    "PostToolUse": [{"matcher": "run_command", "hooks": [{"type": "command", "command": "%s"}]}],\n' "$agy_hook_cmd"
        printf '    "Stop": [{"type": "command", "command": "%s"}]\n' "$agy_hook_cmd"
        printf '  }\n}\n'
      } > "$target/.agents/hooks.json"
      echo "installed hooks -> .agents/hooks.json"
      ;;
  esac
  # Note: codex and muse share .agents/skills; under --harness=all the muse
  # render (same dir) is written last. Invocation text differs only in the
  # trigger line; both harnesses accept the skill by name.
  # Tab completion delivery: copy the scripts into an existing zsh
  # completions dir when one is found (BP3_COMPLETIONS_DIR overrides the
  # search); otherwise print the path to add. Never edit a shell rc file.
  local comp_src="$completions_dir/_bp3" comp_bash_src="$completions_dir/bp3.bash"
  if [ "${BP3_SKIP_COMPLETIONS:-}" != "1" ] && [ -f "$comp_src" ]; then
    local comp_dest=''
    if [ -n "${BP3_COMPLETIONS_DIR:-}" ]; then
      comp_dest="$BP3_COMPLETIONS_DIR"
    else
      local cand
      for cand in "${ZDOTDIR:-$HOME}/.zsh/completions" "$HOME/.zsh/completions" \
        /opt/homebrew/share/zsh/site-functions /usr/local/share/zsh/site-functions \
        "$HOME/.local/share/zsh/site-functions"; do
        if [ -d "$cand" ]; then comp_dest="$cand"; break; fi
      done
    fi
    if [ -n "$comp_dest" ]; then
      mkdir -p "$comp_dest"
      cp "$comp_src" "$comp_dest/_bp3"
      echo "installed _bp3 -> $comp_dest/_bp3"
      echo "completion: source $comp_bash_src (bash)"
    else
      echo "completion: add $completions_dir to fpath (zsh: fpath=($completions_dir \$fpath); compinit) or source $comp_bash_src (bash)"
    fi
  fi

  # Auto-register target git repo in bp3.sqlite (sqlite-control-plane repo.1, fail-fast).
  # In self/repo layout (where $root/skills exists), invoke only the repo's own built
  # binary (or BP3_Q_BIN) so an unbuilt fixture never falls back to a stale bp3-q on PATH.
  if git -C "$target" rev-parse --git-common-dir >/dev/null 2>&1; then
    local reg_bin=''
    local cand_bin
    cand_bin="$(q_bin)"
    if [[ -x $cand_bin ]]; then
      reg_bin="$cand_bin"
    elif [ ! -d "$root/skills" ] && command -v bp3-q >/dev/null 2>&1; then
      reg_bin="$(command -v bp3-q)"
    fi
    if [ -n "$reg_bin" ]; then
      BP3_ROOT="$target" "$reg_bin" repo add "$target" >/dev/null
    fi
  fi
}

# Render freshness (followup.2, workflow-birth): a dispatch
# must never launch a render older than its source. Workflow
# renders are plain copies (byte equality); SKILL.md renders
# carry one GENERATED notice after frontmatter (body equality
# plus release tag match when share/bp3/RELEASE is present).
# Fresh is silent JSON ok; stale refuses E_RENDER_STALE naming
# render and source.
strip_generated_notice() {
  awk '
    !done && /^---$/ { n++; print; next }
    !done && n == 2 {
      done = 1
      if (/^<!-- GENERATED from skills\//) next
    }
    { print }' "$1"
}

generated_notice_line() {
  awk '
    /^---$/ { n++; next }
    n == 2 { print; exit }' "$1"
}

skills_check() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --mode|--mode=*) mode_flag_error "$arg" ;;
      *) echo "unknown arg: $arg" >&2; exit 2 ;;
    esac
  done
  local target mode skills release_tag="" release_file
  target="$(target_root)"
  mode="$(repo_mode "$target")"
  skills="$CORE_SKILLS"
  if [ "$mode" = "self" ]; then
    skills="$CORE_SKILLS $DEV_SKILLS"
  fi
  release_file="${BP3_SHARE_DIR:-$root/share/bp3}/RELEASE"
  if [ -f "$release_file" ] && command -v jq >/dev/null 2>&1; then
    release_tag="$(jq -r '.tag // empty' "$release_file" 2>/dev/null || true)"
  fi
  local workflow_name src_file render_file
  local stale_json="" stale_count=0 fresh_json=""
  for workflow_name in $WORKFLOW_NAMES; do
    fresh_json="${fresh_json}\"$workflow_name\","
    src_file="$src_dir/$WORKFLOW_SKILL/workflows/$workflow_name.js"
    [ -f "$src_file" ] || continue
    render_file="$target/$WORKFLOWS_DIR/$workflow_name.js"
    if [ ! -f "$render_file" ] || ! cmp -s "$src_file" "$render_file"; then
      stale_count=$((stale_count + 1))
      stale_json="${stale_json}{\"workflow\":\"$workflow_name\",\"render\":\"$WORKFLOWS_DIR/$workflow_name.js\",\"source\":\"skills/$WORKFLOW_SKILL/workflows/$workflow_name.js\"},"
    fi
  done
  local skill_dirs="" d skill src_skill render_skill notice skills_checked=0 is_stale
  for d in .pi/skills .claude/skills .agents/skills; do
    if [ -d "$target/$d" ]; then
      skill_dirs="${skill_dirs:+$skill_dirs }$d"
    fi
  done
  if [ -z "$skill_dirs" ]; then
    skill_dirs=".pi/skills .claude/skills .agents/skills"
  fi
  for d in $skill_dirs; do
    for skill in $skills; do
      src_skill="$src_dir/$skill/SKILL.md"
      [ -f "$src_skill" ] || continue
      skills_checked=$((skills_checked + 1))
      render_skill="$target/$d/$skill/SKILL.md"
      is_stale=0
      if [ ! -f "$render_skill" ]; then
        is_stale=1
      else
        notice="$(generated_notice_line "$render_skill")"
        if [ -n "$release_tag" ]; then
          case "$notice" in
            "<!-- GENERATED from skills/$skill/SKILL.md ($release_tag) by: bp3 skills install --harness="*) ;;
            *) is_stale=1 ;;
          esac
        else
          case "$notice" in
            "<!-- GENERATED from skills/$skill/SKILL.md"*" by: bp3 skills install --harness="*) ;;
            *) is_stale=1 ;;
          esac
        fi
        if [ "$is_stale" -eq 0 ] && ! strip_generated_notice "$render_skill" | cmp -s - "$src_skill"; then
          is_stale=1
        fi
      fi
      if [ "$is_stale" -ne 0 ]; then
        stale_count=$((stale_count + 1))
        stale_json="${stale_json}{\"skill\":\"$skill\",\"render\":\"$d/$skill/SKILL.md\",\"source\":\"skills/$skill/SKILL.md\"},"
      fi
    done
  done
  if [ "$stale_count" -gt 0 ]; then
    if [ "$mode" = "self" ]; then
      printf '{"ok":false,"error":{"code":"E_RENDER_STALE","facts":{"stale":[%s]},"guidance":"Re-render in the desk (./bin/bp3 skills install) and re-check; never launch a stale render."}}\n' "${stale_json%,}"
    else
      printf '{"ok":false,"error":{"code":"E_RENDER_STALE","facts":{"stale":[%s]},"guidance":"Re-render in the repo (bp3 skills install) and re-check; never launch a stale render."}}\n' "${stale_json%,}"
    fi
    exit 1
  fi
  printf '{"ok":true,"fresh":[%s],"skills_checked":%d}\n' "${fresh_json%,}" "$skills_checked"
}

usage_text='usage: bp3 init [--harness=<pi|claude|codex|muse|agy|all>] | bp3 init-repo | bp3 skills install [...] | bp3 skills check | bp3 q ... | bp3 n [r] | bp3 e [<edge> ...] | bp3 warden [<quest>] [--last N|--all] [--no-sessions] [--format json|table] | bp3 release (<quest> | --commit <sha>) [...] | bp3 db info [--format json|table] | bp3 repo add|list|remove [...] | bp3 harness ... | bp3 harness desk derive|create|inspect|remove|prepare|check|exit|release|list ... | bp3 worktree ... (alias of harness desk) | bp3 config [--source] [--format json|table]'
q_bin() { echo "${BP3_Q_BIN:-$root/_build/default/$ENGINE_SRC/main.exe}"; }
run_q() {
  local door="$1"; shift
  local gb
  gb="$(q_bin)"
  if [[ -x $gb ]]; then
    BP3_ROOT="$root" exec "$gb" "$door" "$@"
  elif command -v bp3-q >/dev/null 2>&1; then
    # Installed tool (host mode): the binary roots at the caller's repo.
    BP3_ROOT="$(target_root)" exec bp3-q "$door" "$@"
  elif [[ $door == q && ${1:-} == hooks ]]; then
    # Hooks fail open (hooks.ml): exit 2 would block every tool,
    # including the build that fixes this. Drain the payload.
    [[ -t 0 ]] || cat >/dev/null
    echo "bp3 q hooks: no q binary, event not recorded; dune build $ENGINE_SRC/main.exe" >&2; exit 0
  else
    echo "build the q binary first: dune build $ENGINE_SRC/main.exe" >&2; exit 2
  fi
}
case "${1:-}" in
  -h|--help) printf '%s\n' "$usage_text"; printf '%s\n' '  bp3 q -h for quest/node doors'; exit 0 ;;
  g)
    # Retired door (quest rename-back). Hooks registered before the
    # rename still call `g hooks`: fail open, never run the engine.
    if [ "${2:-}" = hooks ]; then
      [[ -t 0 ]] || cat >/dev/null
      echo "bp3 g was renamed to bp3 q; re-run bp3 skills install" >&2; exit 0
    fi
    echo "bp3 g was renamed to bp3 q" >&2; exit 2 ;;
  q) shift; run_q q "$@" ;;
  n) shift; run_q n "$@" ;;
  e) shift; run_q e "$@" ;;
  warden) shift; run_q warden "$@" ;;
  release) shift; run_q release "$@" ;;
  db) shift; run_q db "$@" ;;
  repo) shift; run_q repo "$@" ;;
  harness) shift; run_q harness "$@" ;;
  config) shift; run_q config "$@" ;;
  worktree) shift; run_q worktree "$@" ;;
  init-repo) shift; run_q init-repo "$@" ;;
  init) shift; skills_install "$@" ;;
  skills)
    shift
    case "${1:-}" in
      install) shift; skills_install "$@" ;;
      check) shift; skills_check "$@" ;;
      *) echo "$usage_text" >&2; exit 2 ;;
    esac
    ;;
  *) echo "$usage_text" >&2; exit 2 ;;
esac
