#!/usr/bin/env bash
# bp3 project tooling (pre-binary). The OCaml CLI absorbs these subcommands
# later; the interface stays: bp3 skills install --harness=<name|all>.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
src_dir="$root/skills"

# harness -> skills_dir. Sources are plain Markdown: no templating in bp3.
# The render is a copy plus a GENERATED notice after the frontmatter.
harness_target() {
  case "$1" in
    pi)     echo ".pi/skills" ;;
    claude) echo ".claude/skills" ;;
    codex)  echo ".agents/skills" ;;
    muse)   echo ".agents/skills" ;;
    *) return 1 ;;
  esac
}

install_one() {
  local skill="$1" harness="$2" target_dir dest
  target_dir="$(harness_target "$harness")"
  dest="$root/$target_dir/$skill"
  mkdir -p "$dest"
  awk -v h="$harness" -v s="$skill" '
    /^---$/ { n++; print; if (n == 2) printf "<!-- GENERATED from skills/%s/SKILL.md by: bp3 skills install --harness=%s. Edit the source, then re-run. -->\n", s, h; next }
    { print }' "$src_dir/$skill/SKILL.md" > "$dest/SKILL.md"
  echo "installed $skill -> $target_dir/$skill/SKILL.md ($harness)"
}

skills_install() {
  local harness="all"
  while [ $# -gt 0 ]; do
    case "$1" in
      --harness=*) harness="${1#--harness=}" ;;
      --harness) [ $# -ge 2 ] || { echo '--harness needs a value' >&2; exit 2; }; harness="$2"; shift ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
  done

  local harnesses
  if [ "$harness" = "all" ]; then
    harnesses="pi claude codex muse"
  else
    harnesses="$harness"
  fi

  # Preflight every source and the selected harness before writing any render.
  "$root/scripts/check-skills" "$src_dir"
  local h
  for h in $harnesses; do
    harness_target "$h" >/dev/null || { echo "unknown harness: $h" >&2; exit 2; }
  done

  # Pi discovers .agents as well as .pi. Prefer our Pi copies per project,
  # without deleting Codex/Muse skills or hiding unrelated .agents skills.
  local settings_plan='' existing='{}' ids
  case " $harnesses " in
    *" pi "*)
      if [ -e "$root/.pi/settings.json" ]; then
        existing="$(jq -sce 'select(length == 1) | .[0] | select(type == "object")' "$root/.pi/settings.json")" || { echo 'invalid .pi/settings.json' >&2; exit 1; }
      fi
      ids="$(find "$src_dir" -mindepth 2 -maxdepth 2 -name SKILL.md | while IFS= read -r file; do basename "$(dirname "$file")"; done | LC_ALL=C sort | jq -Rsc 'split("\n") | map(select(length > 0))')"
      settings_plan="$(jq -ce --argjson ids "$ids" '
        if has("skills") and (.skills | type != "array" or any(.[]; type != "string")) then error("skills must be an array of strings") else . end |
        (.skills // []) as $existing |
        .skills = ($existing + [$ids[] | "!**/.agents/skills/" + . + "/SKILL.md" | select(. as $p | $existing | index($p) | not)])
      ' <<< "$existing")" || { echo 'invalid .pi/settings.json skills list' >&2; exit 1; }
      ;;
  esac

  # The traverse saved workflows ship with the traverse skill. They are
  # plain copies (no render notice); the target is the project workflows
  # dir every harness discovers. Absent source means nothing to copy.
  local workflow_names="node-loop induct-grade quest-land induct-node"

  local skill_dir skill
  for skill_dir in "$src_dir"/*/; do
    skill="$(basename "$skill_dir")"
    [ -f "$skill_dir/SKILL.md" ] || continue
    for h in $harnesses; do
      install_one "$skill" "$h"
    done
  done
  if [ -n "$settings_plan" ]; then
    printf '%s\n' "$settings_plan" | jq . > "$root/.pi/settings.json"
  fi
  local workflow_name
  for workflow_name in $workflow_names; do
    if [ -f "$src_dir/traverse/workflows/$workflow_name.js" ]; then
      mkdir -p "$root/.agents/workflows"
      cp "$src_dir/traverse/workflows/$workflow_name.js" "$root/.agents/workflows/$workflow_name.js"
      echo "installed $workflow_name -> .agents/workflows/$workflow_name.js"
    fi
  done
  # Muse hook registration: one fail-open emitter command for
  # every event. Repos without this file never fire hooks.
  mkdir -p "$root/.claude"
  cat > "$root/.claude/hooks.json" <<'HOOKS_JSON'
{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PostLLMCall": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}]
  }
}
HOOKS_JSON
  echo "installed hooks -> .claude/hooks.json"
  # Claude Code loads hooks from settings.json, not hooks.json
  # (live probe 2026-11-14: hooks.json alone never fired; the
  # same hooks under settings.json produced ledger event lines).
  # Merge into any existing settings, preserving other keys.
  local claude_settings="$root/.claude/settings.json"
  local existing_settings='{}'
  if [ -e "$claude_settings" ]; then
    existing_settings="$(cat "$claude_settings")"
  fi
  printf '%s\n' "$existing_settings" | jq --slurpfile hj "$root/.claude/hooks.json" \
    '.hooks = $hj[0].hooks' > "$claude_settings.tmp"
  mv "$claude_settings.tmp" "$claude_settings"
  echo "installed hooks -> .claude/settings.json"
  # Muse hook registration: project tier .muse/hooks.json at the
  # workspace root (live probe 2026-11-13: fires in the main session
  # and in workflow children; no settings merge needed).
  case " $harnesses " in
    *" muse "*)
      mkdir -p "$root/.muse"
      cp "$root/.claude/hooks.json" "$root/.muse/hooks.json"
      echo "installed hooks -> .muse/hooks.json"
      ;;
  esac
  # Note: codex and muse share .agents/skills; under --harness=all the muse
  # render (same dir) is written last. Invocation text differs only in the
  # trigger line; both harnesses accept the skill by name.
  # Tab completion delivery: copy the scripts into an existing zsh
  # completions dir when one is found (BP3_COMPLETIONS_DIR overrides the
  # search); otherwise print the path to add. Never edit a shell rc file.
  local comp_src="$root/completions/_bp3" comp_bash_src="$root/completions/bp3.bash"
  if [ -f "$comp_src" ]; then
    local comp_dest=''
    if [ -n "${BP3_COMPLETIONS_DIR:-}" ]; then
      comp_dest="$BP3_COMPLETIONS_DIR"
    else
      local cand
      for cand in "${ZDOTDIR:-$HOME}/.zsh/completions" "$HOME/.zsh/completions" \
        /opt/homebrew/share/zsh/site-functions /usr/local/share/zsh/site-functions \
        "$HOME/.local/share/zsh/site-functions"; do
        if [ -d "$cand" ]; then comp_dest="$cand"; break; fi
      done
    fi
    if [ -n "$comp_dest" ]; then
      mkdir -p "$comp_dest"
      cp "$comp_src" "$comp_dest/_bp3"
      echo "installed _bp3 -> $comp_dest/_bp3"
      echo "completion: source $comp_bash_src (bash)"
    else
      echo "completion: add $root/completions to fpath (zsh: fpath=($root/completions \$fpath); compinit) or source $comp_bash_src (bash)"
    fi
  fi
}

usage_text='usage: bp3 init [--harness=<pi|claude|codex|muse|all>] | bp3 skills install [...] | bp3 q|quest ... | bp3 e [<edge> ...] | bp3 harness ... | bp3 harness desk derive|create|inspect|remove|prepare|check|exit|release|list ... | bp3 worktree ... (alias of harness desk) | bp3 config [--source] [--format json|table]'
case "${1:-}" in
  -h|--help) printf '%s\n' "$usage_text"; printf '%s\n' '  bp3 q -h for quest/exp doors'; exit 0 ;;
  q|quest) shift
    q_bin="${BP3_Q_BIN:-$root/_build/default/src/quest/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/quest/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" "$@" ;;
  e) shift
    q_bin="${BP3_Q_BIN:-$root/_build/default/src/quest/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/quest/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" e "$@" ;;
  harness) shift
    q_bin="${BP3_Q_BIN:-$root/_build/default/src/quest/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/quest/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" harness "$@" ;;
  config) shift
    q_bin="${BP3_Q_BIN:-$root/_build/default/src/quest/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/quest/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" config "$@" ;;
  worktree) shift
    q_bin="${BP3_Q_BIN:-$root/_build/default/src/quest/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/quest/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" worktree "$@" ;;
  init) shift; skills_install "$@" ;;
  skills)
    shift
    case "${1:-}" in
      install) shift; skills_install "$@" ;;
      *) echo "$usage_text" >&2; exit 2 ;;
    esac
    ;;
  *) echo "$usage_text" >&2; exit 2 ;;
esac
=== test/ready.sh ===
#!/usr/bin/env bash
# mvp.3: node deps, ready-set waves, starved sets, derived
# timing, setup gate, serial land. Fixture graphs are built
# through bp3 q itself; timing fixtures write ledger lines
# with fixed timestamps through git plumbing.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/repo/bin" "$work/repo/plans"
cp "$root/bin/bp3" "$work/repo/bin/"
cp "$root/_build/default/src/quest/main.exe" "$work/repo/q-bin"
cp "$root"/plans/*.yaml "$work/repo/plans/"
cd "$work/repo"
git init -q -b master
git config user.email t@t.t; git config user.name t
echo base > a.txt; git add .; git commit -qm base

export BP3_HARNESS=muse-code BP3_MODEL=test-model
q() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q "$@"; }
lk() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 harness link "$@"; }
fail() { echo "FAIL: $*" >&2; exit 1; }

commit_on_exp() { # $1 quest $2 exp $3 path $4 content -> new tip
  local branch="refs/heads/bp3/exp/$1/$2" tip blob tree new_tip idx="$work/idx-$1-$2"
  tip=$(git rev-parse "$branch"); rm -f "$idx"
  blob=$(printf '%s' "$4" | git hash-object -w --stdin)
  GIT_INDEX_FILE="$idx" git read-tree "$tip"
  GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,$3"
  tree=$(GIT_INDEX_FILE="$idx" git write-tree)
  new_tip=$(printf 'work %s\n' "$2" | git commit-tree "$tree" -p "$tip")
  git update-ref "$branch" "$new_tip" "$tip"; rm -f "$idx"
  printf '%s' "$new_tip"
}
land_exp() { # $1 quest $2 exp $3 path
  local c; c=$(commit_on_exp "$1" "$2" "$3" "content-$2")
  q "$1" u "$2" handoff --commit "$c" --reason work >/dev/null
  q "$1" u "$2" grade --verdict ship --reason ok >/dev/null
  q "$1" u "$2" verify --verdict pass --reason ok >/dev/null
  q "$1" u "$2" land --reason ship >/dev/null
}
exp_ledger() { git show "bp3/exp/$1/$2:docs/quests/$1/experiments/$2/ledger.jsonl"; }

# --- diamond: deps declared, waves, ready, handoff gate ---
q c sched >/dev/null
q sched c na >/dev/null; q sched c nb >/dev/null; q sched c nd >/dev/null
out=$(q sched c nc --depends-on na,nb)
echo "$out" | jq -e '.ok == true and .deps == ["na","nb"]' >/dev/null || fail "create deps: $out"
out=$(q sched r nc)
echo "$out" | jq -e '.deps == ["na","nb"] and .state == "todo"' >/dev/null || fail "deps read from record: $out"
out=$(q r sched)
echo "$out" | jq -e '.ready_set_waves == [["na","nb","nd"],["nc"]] and .ready == ["na","nb","nd"] and .starved == []' >/dev/null || fail "diamond waves: $out"
echo w > w.txt; git add w.txt; git commit -qm w; W=$(git rev-parse HEAD)
if out=$(q sched u nc handoff --commit "$W" --reason early 2>&1); then fail "dep-blocked handoff accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEPENDENCY" and (.error.facts.blocked_by == ["na","nb"])' >/dev/null || fail "handoff gate: $out"
land_exp sched na fa.txt; land_exp sched nb fb.txt
out=$(q r sched)
echo "$out" | jq -e '.ready == ["nc","nd"] and .ready_set_waves == [["nc","nd"]]' >/dev/null || fail "ready after land: $out"

# --- cycle refused at write time, naming the cycle ---
q sched c nx >/dev/null
q sched dep nx --depends-on nc --reason "chain" >/dev/null
before=$(exp_ledger sched nc | wc -l)
if out=$(q sched dep nc --depends-on nx --reason loop 2>&1); then fail "cycle dep accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEP_CYCLE" and (.error.facts.cycle | index("nc") != null) and (.error.facts.cycle | index("nx") != null)' >/dev/null || fail "cycle facts: $out"
[ "$(exp_ledger sched nc | wc -l)" = "$before" ] || fail "cycle refusal ledgered"
if out=$(q sched dep na --depends-on na --reason self 2>&1); then fail "self dep accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEP_CYCLE"' >/dev/null || fail "self cycle code: $out"
if out=$(q sched c ghost --depends-on nope 2>&1); then fail "unknown dep accepted"; fi
echo "$out" | jq -e '.error.code == "E_NOT_FOUND"' >/dev/null || fail "unknown dep code: $out"

# --- deps mutable-but-logged, mid-flight edit on the record ---
out=$(q sched dep nd --depends-on na --reason "nd waits for na")
echo "$out" | jq -e '.ok == true and .deps == ["na"] and .state == "todo"' >/dev/null || fail "dep edit: $out"
exp_ledger sched nd | tail -1 | jq -e '.edge == "dep" and .from == "todo" and .to == "todo" and .depends_on == ["na"]' >/dev/null || fail "dep line logged"
out=$(q sched u nd handoff --commit "$W" --reason work)
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "nd handoff (dep landed): $out"
out=$(q sched dep nd --depends-on nb --reason "mid-flight swap")
echo "$out" | jq -e '.ok == true and .state == "handed_off" and .deps == ["nb"]' >/dev/null || fail "mid-flight dep edit: $out"
exp_ledger sched nd | tail -1 | jq -e '.edge == "dep" and .from == "handed_off" and .to == "handed_off" and .cycle == 1 and .depends_on == ["nb"]' >/dev/null || fail "mid-flight dep line carries state+cycle"

# --- blocked blast radius: starved dependents, independents ready ---
q c blast >/dev/null
q blast c bx >/dev/null; q blast c bw >/dev/null
q blast c by --depends-on bx >/dev/null; q blast c bz --depends-on by >/dev/null
q blast u bx block --reason "choose storage" >/dev/null
out=$(q r blast)
echo "$out" | jq -e '.ready == ["bw"] and .starved == [{"blocked":"bx","starved":["by","bz"]}] and ([.inbox[] | select(.exp == "bx")] | length == 1)' >/dev/null || fail "starved rollup: $out"
if out=$(q blast u by handoff --commit "$W" --reason early 2>&1); then fail "starved handoff accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEPENDENCY"' >/dev/null || fail "starved handoff gate: $out"

# --- timing derived from ledger timestamps, hand-checked ---
q c timing >/dev/null; q timing c tm >/dev/null
tip=$(git rev-parse bp3/exp/timing/tm); idx="$work/idx-tm"; rm -f "$idx"
cat > "$work/tm-ledger.jsonl" <<EOF
{"ts":"2026-01-01T00:00:00Z","edge":"create","from":"","to":"todo","cycle":1,"commit":null,"verdict":null,"reason":"","harness":"t","model":"t","bp3_version":"0.2.0","exp_type":"default"}
{"ts":"2026-01-01T00:10:00Z","edge":"handoff","from":"todo","to":"handed_off","cycle":1,"commit":"$W","verdict":null,"reason":"work","harness":"t","model":"t","bp3_version":"0.2.0"}
{"ts":"2026-01-01T00:20:00Z","edge":"grade","from":"handed_off","to":"handed_off","cycle":1,"commit":"$W","verdict":"ship","reason":"ok","harness":"t","model":"t","bp3_version":"0.2.0"}
{"ts":"2026-01-01T00:30:00Z","edge":"verify","from":"handed_off","to":"approved","cycle":1,"commit":"$W","verdict":"pass","reason":"ok","harness":"t","model":"t","bp3_version":"0.2.0"}
{"ts":"2026-01-01T00:51:00Z","edge":"land","from":"approved","to":"landed","cycle":1,"commit":"$W","verdict":null,"reason":"ship","harness":"t","model":"t","bp3_version":"0.2.0"}
EOF
blob=$(git hash-object -w "$work/tm-ledger.jsonl")
GIT_INDEX_FILE="$idx" git read-tree "$tip"
GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,docs/quests/timing/experiments/tm/ledger.jsonl"
tree=$(GIT_INDEX_FILE="$idx" git write-tree)
nt=$(git commit-tree "$tree" -p "$tip" -m "timing fixture")
git update-ref refs/heads/bp3/exp/timing/tm "$nt" "$tip"; rm -f "$idx"
out=$(q timing r tm)
echo "$out" | jq -e '.state == "landed" and .timing.wait_s == 600 and .timing.wall_s == 2460 and .timing.dwell_s == {"todo":600,"handed_off":1200,"approved":1260} and .timing.cycles == 1' >/dev/null || fail "timing math: $out"
out2=$(q r timing)
echo "$out2" | jq -e '(.exps[] | select(.exp == "tm") | .timing.wall_s == 2460)' >/dev/null || fail "rollup timing: $out2"
before=$(git rev-parse bp3/exp/timing/tm)
q timing r tm >/dev/null; q r timing >/dev/null
[ "$(git rev-parse bp3/exp/timing/tm)" = "$before" ] || fail "timing read wrote state"
dirty=$(git status --porcelain | wc -l | tr -d ' ')
[ "$dirty" = "0" ] || fail "timing read dirtied worktree: $dirty entries"
echo "timing read clean: tip unchanged, worktree entries: $dirty"
# No hand-edited state: reads derive timing from ledger timestamps
# and setup from machine-local run configs; neither writes a tracked
# ledger/state file. Counts are echoed so the check carries a
# quotable line (an empty porcelain output is not typed evidence).
tracked_state=$(git ls-files | grep -c -E 'ledger\.jsonl|state\.yaml' || true)
echo "tracked ledger/state files on fixture tip: $tracked_state"

# --- setup measured per Run; slow fixture fires locally only ---
out=$(lk mint --kind edge --graph sched --node na --edge handoff --desk "$work/repo")
RID=$(echo "$out" | jq -r .run_id); TOK=$(echo "$out" | jq -r .token)
out=$(MUSE_SESSION_ID=sess-fast lk claim "$TOK")
echo "$out" | jq -e '.ok == true and .state == "claimed"' >/dev/null || fail "fast claim: $out"
rm -f .bp3-context.json
out=$(q r sched)
echo "$out" | jq -e --arg r "$RID" '(.setup[] | select(.run_id == $r) | .setup_wall_s >= 0 and .setup_wall_s < 180) and (has("warnings") | not or (.warnings | index("W_SETUP_SLOW") == null))' >/dev/null || fail "fast setup: $out"
out=$(lk mint --kind edge --graph sched --node nb --edge handoff --desk "$work/repo")
SRID=$(echo "$out" | jq -r .run_id)
jq '.state = "claimed" | .creator.minted_at = "2026-01-01T00:00:00Z" | .claim = {"session_id":"sess-slow","pid":1,"cwd":"/tmp","claimed_at":"2026-01-01T00:10:00Z"}' ".git/bp3/runs/$SRID.json" > "$work/slow.json"
cp "$work/slow.json" ".git/bp3/runs/$SRID.json"
out=$(q r sched)
echo "$out" | jq -e --arg r "$SRID" '(.setup[] | select(.run_id == $r) | .setup_wall_s == 600) and (.warnings | index("W_SETUP_SLOW") != null)' >/dev/null || fail "slow setup gate: $out"
for e in na nb nc nd nx; do
  exp_ledger sched "$e" | grep -q setup_wall && fail "setup leaked into ledger $e"
done

# --- serial land: second land re-checks against the new tip ---
q c serial >/dev/null; q serial c sl-a >/dev/null; q serial c sl-b >/dev/null
CA=$(commit_on_exp serial sl-a sa.txt "A"); CB=$(commit_on_exp serial sl-b sb.txt "B")
for e in sl-a sl-b; do
  c=$CA; [ "$e" = sl-b ] && c=$CB
  q serial u "$e" handoff --commit "$c" --reason work >/dev/null
  q serial u "$e" grade --verdict ship --reason ok >/dev/null
  q serial u "$e" verify --verdict pass --reason ok >/dev/null
done
out=$(q serial u sl-a land --reason first)
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "first land: $out"
tip1=$(git rev-parse bp3/quest/serial)
out=$(q serial r sl-b)
echo "$out" | jq -e '.state == "approved"' >/dev/null || fail "second still approved: $out"
out=$(q serial u sl-b land --reason second)
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "second land: $out"
git merge-base --is-ancestor "$tip1" bp3/quest/serial || fail "second land did not build on first tip"
git merge-base --is-ancestor "$CB" bp3/quest/serial || fail "second reviewed commit not in quest tip"
[ "$(git show bp3/quest/serial:sa.txt)" = "A" ] && [ "$(git show bp3/quest/serial:sb.txt)" = "B" ] || fail "serial merge lost files"

# --- help: dep verb and flags documented at their doors ---
out=$(q sched dep -h) || fail "dep -h exit"
echo "$out" | grep -q -- "--depends-on" || fail "dep help flags: $out"
echo "$out" | grep -q "E_DEP_CYCLE" || fail "dep help cycle: $out"
out=$(q sched -h) || fail "exp door -h exit"
echo "$out" | grep -q "dep" || fail "exp door help dep: $out"
echo "$out" | grep -q -- "--depends-on" || fail "exp door help depends-on: $out"

echo "ready tests: ok"
=== test/q.sh head ===
#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/repo/bin" "$work/repo/plans"
cp "$root/bin/bp3" "$work/repo/bin/"
cp "$root/_build/default/src/quest/main.exe" "$work/repo/q-bin"
cp "$root"/plans/*.yaml "$work/repo/plans/"
cd "$work/repo"
git init -q -b master
git config user.email t@t.t; git config user.name t
echo base > a.txt; git add .; git commit -qm base

export BP3_HARNESS=muse-code BP3_MODEL=test-model
q() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q "$@"; }
quest_alias() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 quest "$@"; }

fail() { echo "FAIL: $*" >&2; exit 1; }

# --- create / read verdict shapes, both spellings ---
out=$(q c demo)
echo "$out" | jq -e '.ok == true and .quest == "demo" and .state == "proposed"' >/dev/null || fail "quest create shape: $out"
out=$(q create demo2)
echo "$out" | jq -e '.ok == true and .state == "proposed"' >/dev/null || fail "quest create alias: $out"
out=$(quest_alias r demo)
echo "$out" | jq -e '.ok == true and .quest == "demo" and .state == "proposed" and (.exps | type == "array") and (.inbox | type == "array") and has("rollup")' >/dev/null || fail "quest read shape: $out"
out=$(q r)
echo "$out" | jq -e '.ok == true and (.quests | length >= 2)' >/dev/null || fail "quest list: $out"

out=$(q demo c parser-fix)
echo "$out" | jq -e '.ok == true and .state == "todo" and .cycle == 1' >/dev/null || fail "exp create: $out"
out=$(q demo create parser-fix2)
echo "$out" | jq -e '.ok == true and .state == "todo"' >/dev/null || fail "exp create alias: $out"
out=$(q demo r parser-fix)
echo "$out" | jq -e '.ok == true and .state == "todo"' >/dev/null || fail "exp read: $out"
out=$(q demo read parser-fix)
echo "$out" | jq -e '.ok == true and .state == "todo"' >/dev/null || fail "exp read alias: $out"

# --- strict argv: dup flag, unknown flag, stray positional -> usage before write ---
before=$(git show bp3/exp/demo/parser-fix:docs/quests/demo/experiments/parser-fix/ledger.jsonl | wc -l)
if out=$(q demo u parser-fix handoff --commit abc --reason x --reason y 2>&1); then fail "dup flag accepted"; fi
echo "$out" | jq -e '.ok == false and .error.code == "E_USAGE"' >/dev/null || fail "dup flag code: $out"
if out=$(q demo u parser-fix handoff --commit abc --reason x --bogus y 2>&1); then fail "unknown flag accepted"; fi
echo "$out" | jq -e '.error.code == "E_USAGE"' >/dev/null || fail "unknown flag code: $out"
if out=$(q demo u parser-fix handoff extra --commit abc --reason x 2>&1); then fail "stray positional accepted"; fi
echo "$out" | jq -e '.error.code == "E_USAGE"' >/dev/null || fail "stray code: $out"
after=$(git show bp3/exp/demo/parser-fix:docs/quests/demo/experiments/parser-fix/ledger.jsonl | wc -l)
[ "$before" = "$after" ] || fail "strict argv wrote to ledger"

# --- refusal: land from todo, ledger unchanged ---
if out=$(q demo u parser-fix land --reason "too early" 2>&1); then fail "land from todo accepted"; fi
echo "$out" | jq -e '.ok == false and .error.code == "E_ILLEGAL_EDGE" and .error.facts.state == "todo" and .error.facts.edge == "land" and (.error.facts.legal_edges | index("handoff") != null) and (.error.guidance | length > 0)' >/dev/null || fail "illegal edge facts: $out"
after=$(git show bp3/exp/demo/parser-fix:docs/quests/demo/experiments/parser-fix/ledger.jsonl | wc -l)
[ "$before" = "$after" ] || fail "refusal ledgered"

# --- identity: unset -> unknown + warning; invalid -> fail fast ---
out=$(env -u BP3_HARNESS -u BP3_MODEL BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q demo c id-exp)
echo "$out" | jq -e '.ok == true and (.warnings | index("W_IDENTITY_UNKNOWN") != null)' >/dev/null || fail "identity warning: $out"
git show bp3/exp/demo/id-exp:docs/quests/demo/experiments/id-exp/ledger.jsonl | tail -1 | jq -e '.harness == "unknown" and .model == "unknown" and .bp3_version == "0.2.0"' >/dev/null || fail "identity ledger unknown"
if out=$(BP3_HARNESS=bogus BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q demo r parser-fix 2>&1); then fail "invalid harness accepted"; fi
echo "$out" | jq -e '.error.code == "E_IDENTITY"' >/dev/null || fail "identity code: $out"

# --- run-id: BP3_RUN_ID from env stamps verdict + ledger; unset is absent ---
out=$(BP3_RUN_ID=run-42 BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q c runq)
echo "$out" | jq -e '.ok == true and .run_id == "run-42"' >/dev/null || fail "run-id quest verdict: $out"
out=$(BP3_RUN_ID=run-42 BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q runq c rid-exp)
echo "$out" | jq -e '.ok == true and .run_id == "run-42"' >/dev/null || fail "run-id exp verdict: $out"
git show bp3/exp/runq/rid-exp:docs/quests/runq/experiments/rid-exp/ledger.jsonl | tail -1 | jq -e '.run_id == "run-42" and .harness == "muse-code"' >/dev/null || fail "run-id ledger set"
out=$(BP3_RUN_ID=run-42 BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q runq r rid-exp)
echo "$out" | jq -e '.ok == true and .run_id == "run-42"' >/dev/null || fail "run-id read verdict: $out"
out=$(env -u BP3_RUN_ID BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q runq c rid-unset)
echo "$out" | jq -e '.ok == true and (has("run_id") | not)' >/dev/null || fail "run-id unset verdict: $out"
git show bp3/exp/runq/rid-unset:docs/quests/runq/experiments/rid-unset/ledger.jsonl | tail -1 | jq -e 'has("run_id") | not' >/dev/null || fail "run-id ledger unset"
out=$(env -u BP3_RUN_ID BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q runq r rid-unset)
echo "$out" | jq -e '.ok == true and (has("run_id") | not)' >/dev/null || fail "run-id unset read verdict: $out"
out=$(env -u BP3_HARNESS -u BP3_MODEL -u BP3_RUN_ID BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q runq c rid-unknown)
echo "$out" | jq -e '.ok == true and (has("run_id") | not) and (.warnings | index("W_IDENTITY_UNKNOWN") != null)' >/dev/null || fail "run-id unset identity warning: $out"
git show bp3/exp/runq/rid-unknown:docs/quests/runq/experiments/rid-unknown/ledger.jsonl | tail -1 | jq -e '(has("run_id") | not) and .harness == "unknown"' >/dev/null || fail "run-id unset unknown ledger"

# --- happy path handoff/grade/verify/land (alias spellings mixed) ---
echo work > b.txt; git add b.txt; git commit -qm work
B=$(git rev-parse HEAD)
out=$(q demo u parser-fix handoff --commit "$B" --reason "first cut")
echo "$out" | jq -e '.ok == true and .state == "handed_off" and .cycle == 1' >/dev/null || fail "handoff: $out"
out=$(q demo update parser-fix grade --verdict ship --reason "looks right")
echo "$out" | jq -e '.ok == true and .state == "handed_off"' >/dev/null || fail "grade ship stays handed_off until verify: $out"
out=$(q demo u parser-fix verify --verdict pass --reason "green")
echo "$out" | jq -e '.ok == true and .state == "approved"' >/dev/null || fail "verify pass approves: $out"
out=$(q demo u parser-fix land --reason "ship it")
echo "$out" | jq -e '.ok == true and .state == "landed" and .fin == "exp_fin"' >/dev/null || fail "land: $out"
out=$(q r demo)
echo "$out" | jq -e '.ok == true and (.exps[] | select(.exp == "parser-fix") | .state == "landed" and .fin == "exp_fin")' >/dev/null || fail "read after land: $out"

# --- mig.1 compat: frozen pre-rename ledger folds to new words, file untouched ---
out=$(q demo c compat-exp)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "compat create: $out"
append_ledger_line() { # $1 exp $2 json-line
  local br="bp3/exp/demo/$1" path="docs/quests/demo/experiments/$1/ledger.jsonl" tip idx led blob tree nt
  tip=$(git rev-parse "$br")
  led=$(git show "$br:$path")
  idx=$(mktemp)
  GIT_INDEX_FILE="$idx" git read-tree "$tip"
  blob=$(printf '%s\n%s\n' "$led" "$2" | git hash-object -w --stdin)
  GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,$path"
  tree=$(GIT_INDEX_FILE="$idx" git write-tree)
  nt=$(git commit-tree "$tree" -p "$tip" -m "compat fixture $1")
  git update-ref "refs/heads/$br" "$nt" "$tip"
  rm -f "$idx"
}
compat_tip_before=$(git rev-parse bp3/exp/demo/compat-exp)
append_ledger_line compat-exp "{\"ts\":\"2026-01-01T00:00:00Z\",\"edge\":\"submit\",\"from\":\"todo\",\"to\":\"submitted\",\"cycle\":1,\"commit\":\"$B\",\"verdict\":null,\"reason\":\"frozen\",\"harness\":\"t\",\"model\":\"t\",\"bp3_version\":\"0.2.0\"}"
out=$(q demo r compat-exp)
echo "$out" | jq -e --arg c "$B" '.state == "handed_off" and .cycle == 1 and .commit == $c and (.legal_edges | index("grade") != null) and (.legal_edges | index("verify") != null)' >/dev/null || fail "compat old submit folds handed_off: $out"
append_ledger_line compat-exp "{\"ts\":\"2026-01-01T00:01:00Z\",\"edge\":\"review\",\"from\":\"submitted\",\"to\":\"submitted\",\"cycle\":1,\"commit\":\"$B\",\"verdict\":\"ship\",\"reason\":\"frozen\",\"harness\":\"t\",\"model\":\"t\",\"bp3_version\":\"0.2.0\"}"
append_ledger_line compat-exp "{\"ts\":\"2026-01-01T00:02:00Z\",\"edge\":\"check\",\"from\":\"submitted\",\"to\":\"approved\",\"cycle\":1,\"commit\":\"$B\",\"verdict\":\"pass\",\"reason\":\"frozen\",\"harness\":\"t\",\"model\":\"t\",\"bp3_version\":\"0.2.0\"}"
out=$(q demo r compat-exp)
echo "$out" | jq -e '.state == "approved" and .cycle == 1' >/dev/null || fail "compat old grade/verify fold approved: $out"
# reads never rewrite the frozen file
q demo r compat-exp >/dev/null
=== completions ===
# bp3 bash completion: static verbs/edges/flags, dynamic quest/exp names.
# Candidates come from _bp3_candidates (words after bp3, last word is the
# current one); completion fails silently on any error.
# shellcheck shell=bash

_bp3_flags='--format --reason --commit --verdict --target --type --depends-on'
_bp3_edges='handoff grade verify land block resume'
_bp3_quest_verbs='c r d create read delete'
_bp3_exp_verbs='c r u d create read update delete'
_bp3_format_values='json table tree'
_bp3_verdict_values='ship needs_fix pass fail'

_bp3_words() {
  # Print the words of a space-separated list, one per line.
  local w
  # shellcheck disable=SC2086 # the list is split on purpose
  for w in $1; do printf '%s\n' "$w"; done
}

_bp3_filter() {
  # _bp3_filter <current>: print stdin lines starting with <current>.
  local cur="$1" line
  while IFS= read -r line; do
    case "$line" in
      "$cur"*) printf '%s\n' "$line" ;;
    esac
  done
}

_bp3_cmd() {
  if [ -n "${BP3_COMPLETION_BP3:-}" ]; then
    [ -x "$BP3_COMPLETION_BP3" ] || return 1
    printf '%s\n' "$BP3_COMPLETION_BP3"
  elif command -v bp3 >/dev/null 2>&1; then
    printf '%s\n' 'bp3'
  elif [ -x ./bin/bp3 ]; then
    printf '%s\n' './bin/bp3'
  else
    return 1
  fi
}

_bp3_quests() {
  local cmd
  cmd="$(_bp3_cmd)" || return 0
  command -v jq >/dev/null 2>&1 || return 0
  "$cmd" q r 2>/dev/null | jq -r '.quests[]?.quest // empty' 2>/dev/null || true
}

_bp3_exps() {
  local cmd quest="$1"
  cmd="$(_bp3_cmd)" || return 0
  command -v jq >/dev/null 2>&1 || return 0
  "$cmd" q "$quest" r 2>/dev/null | jq -r '.exps[]?.exp // empty' 2>/dev/null || true
}

_bp3_is_verb() {
  case "$1" in
    c|create|r|read|u|update|d|delete) return 0 ;;
    *) return 1 ;;
  esac
}

_bp3_candidates() {
  local -a words=("$@")
  local n=${#words[@]} cur='' prev_last=''
  if [ "$n" -gt 0 ]; then cur="${words[$((n - 1))]}"; fi
  if [ "$n" -gt 1 ]; then prev_last="${words[$((n - 2))]}"; fi

  case "$prev_last" in
    --format) _bp3_words "$_bp3_format_values" | _bp3_filter "$cur"; return 0 ;;
    --verdict) _bp3_words "$_bp3_verdict_values" | _bp3_filter "$cur"; return 0 ;;
    --reason|--commit|--target|--type|--depends-on) return 0 ;;
  esac

  case "$cur" in
    --format=*)
      local v
      for v in $_bp3_format_values; do printf '%s\n' "--format=$v"; done | _bp3_filter "$cur"
      return 0 ;;
    --verdict=*)
      local v
      for v in $_bp3_verdict_values; do printf '%s\n' "--verdict=$v"; done | _bp3_filter "$cur"
      return 0 ;;
    --*|-*)
      _bp3_words "$_bp3_flags" | _bp3_filter "$cur"
      return 0 ;;
  esac

  # Completed words before the current one.
  local -a a=()
  local i
  for ((i = 0; i < n - 1; i++)); do a+=("${words[$i]}"); done

  local has_q=0
  if [ "${#a[@]}" -gt 0 ] && { [ "${a[0]}" = 'q' ] || [ "${a[0]}" = 'quest' ]; }; then
    has_q=1
    local -a rest=()
    local j
    for ((j = 1; j < ${#a[@]}; j++)); do rest+=("${a[$j]}"); done
    a=()
    for ((j = 0; j < ${#rest[@]}; j++)); do a+=("${rest[$j]}"); done
  fi

  if [ "$has_q" -eq 0 ]; then
    if [ "${#a[@]}" -eq 0 ]; then
      printf '%s\n' q quest e init skills harness worktree config | _bp3_filter "$cur"
    elif [ "${#a[@]}" -eq 1 ] && [ "${a[0]}" = 'config' ]; then
      printf '%s\n' --source --format -h --help | _bp3_filter "$cur"
    elif [ "${#a[@]}" -eq 1 ] && [ "${a[0]}" = 'e' ]; then
      _bp3_words "$_bp3_edges" | _bp3_filter "$cur"
    elif [ "${#a[@]}" -eq 1 ] && [ "${a[0]}" = 'skills' ]; then
      printf '%s\n' install | _bp3_filter "$cur"
    elif [ "${#a[@]}" -eq 1 ] && [ "${a[0]}" = 'harness' ]; then
      printf '%s\n' supervisor init-check find-tape watch desk s i f w d | _bp3_filter "$cur"
    elif [ "${#a[@]}" -eq 2 ] && [ "${a[0]}" = 'harness' ] && { [ "${a[1]}" = 'desk' ] || [ "${a[1]}" = 'd' ]; }; then
      printf '%s\n' derive create inspect remove prepare check exit release list | _bp3_filter "$cur"
    elif [ "${#a[@]}" -eq 1 ] && [ "${a[0]}" = 'worktree' ]; then
      printf '%s\n' derive create inspect remove prepare check exit release list | _bp3_filter "$cur"
    fi
    return 0
  fi

  _bp3_cmd >/dev/null 2>&1 || return 0

  if [ "${#a[@]}" -eq 0 ]; then
    _bp3_quests | _bp3_filter "$cur"
    return 0
  fi

  if _bp3_is_verb "${a[0]}"; then
    if [ "${#a[@]}" -eq 1 ]; then
      case "${a[0]}" in
        r|read|d|delete) _bp3_quests | _bp3_filter "$cur" ;;
        *) : ;;
      esac
    fi
    return 0
  fi

  # a[0] is a quest name.
  if [ "${#a[@]}" -eq 1 ]; then
    _bp3_words "$_bp3_exp_verbs" | _bp3_filter "$cur"
    return 0
  fi

  if [ "${#a[@]}" -eq 2 ]; then
    case "${a[1]}" in
      r|read|d|delete|u|update) _bp3_exps "${a[0]}" | _bp3_filter "$cur" ;;
      *) : ;;
    esac
    return 0
  fi

  if [ "${#a[@]}" -eq 3 ] && { [ "${a[1]}" = 'u' ] || [ "${a[1]}" = 'update' ]; }; then
    _bp3_words "$_bp3_edges" | _bp3_filter "$cur"
    return 0
  fi

  return 0
}

_bp3() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local -a cands=()
  local line
  while IFS= read -r line; do
    [ -n "$line" ] && cands+=("$line")
  done < <(_bp3_candidates "${COMP_WORDS[@]:1}" 2>/dev/null)
  COMPREPLY=()
  if [ "${#cands[@]}" -gt 0 ]; then
    # Candidates already match the current word; compgen keeps COMPREPLY exact.
    while IFS= read -r line; do
      COMPREPLY+=("$line")
    done < <(compgen -W "${cands[*]}" -- "$cur" 2>/dev/null)
  fi
  return 0
}

complete -F _bp3 bp3 2>/dev/null || true
