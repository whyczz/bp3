CA=$(commit_on_graph conf touch-a shared.txt "A-side")
CB=$(commit_on_graph conf touch-b shared.txt "B-side")
for spec in "touch-a $CA" "touch-b $CB"; do
  n=${spec%% *}; c=${spec##* }
