# This host's default MacOSX27.2 SDK ships a libpthread.tbd the linker
# cannot parse ("unknown architecture"); the 26.5 SDK links cleanly.
# Use it when present; harmless elsewhere.
MAC_SDK := $(shell if [ -d /Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk ]; then echo /Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk; fi)
DUNE_BUILD = $(if $(MAC_SDK),SDKROOT=$(MAC_SDK) ,)dune build$(if $(findstring /.bp3/worktrees/,$(CURDIR)), --root=.,)

check: lint
	./scripts/check-skills skills .pi/skills .agents/skills .claude/skills
	./test/skills.sh
	$(DUNE_BUILD) src/quest/main.exe
	./test/q.sh
	./test/ready.sh
	./test/harness.sh
	./test/config.sh
	./test/link.sh
	./test/context.sh
	node --test extensions/bp3-pi/test/bp3-pi.test.mjs
	./test/worktree.sh
	./test/tape.sh
	./test/hooks.sh
	./test/traverse.sh
	./test/completion.sh
	./test/release.sh
	./test/install.sh

lint:
	shellcheck bin/bp3 scripts/check-skills test/skills.sh test/q.sh test/ready.sh test/harness.sh test/config.sh test/link.sh test/context.sh test/worktree.sh test/tape.sh test/hooks.sh test/traverse.sh test/completion.sh test/release.sh test/install.sh completions/bp3.bash scripts/release-check scripts/install-bp3.sh scripts/bp3-shim scripts/release-publish
	node --check skills/traverse/workflows/induct-node.js
	node --check skills/traverse/workflows/node-loop.js
	node --check skills/traverse/workflows/induct-grade.js
	node --check skills/traverse/workflows/quest-land.js

test:
	./test/skills.sh

# --- release (Exp 5): tag-gated artifact + checksum; publish-once via gh ---
RELEASE_VERSION := $(shell sed -n 's/.*bp3_version = "\(.*\)".*/\1/p' src/quest/gitx.ml | head -1)
RELEASE_OS := $(shell uname -s | tr '[:upper:]' '[:lower:]')
RELEASE_ARCH := $(shell uname -m)
RELEASE_ARTIFACT := dist/bp3-q-v$(RELEASE_VERSION)-$(RELEASE_OS)-$(RELEASE_ARCH)

release:
	@./scripts/release-check >/dev/null
	$(DUNE_BUILD) src/quest/main.exe
	mkdir -p dist
	cp _build/default/src/quest/main.exe $(RELEASE_ARTIFACT)
	cd dist && shasum -a 256 $$(basename $(RELEASE_ARTIFACT)) > $$(basename $(RELEASE_ARTIFACT)).sha256
	@echo "released $(RELEASE_ARTIFACT)"

publish: release
	./scripts/release-publish $(RELEASE_ARTIFACT) $(RELEASE_ARTIFACT).sha256

PREFIX ?= $(HOME)/.local
install:
	PREFIX="$(PREFIX)" ./scripts/install-bp3.sh
}

function exitOf(obs) {
  return obs && typeof obs.exit === "number" ? obs.exit : 1;
}

// Grade validations (followup.1, owner-locked names): each
// plug is deterministic code — ctx in, one typed evidence
// row out, expectation declared in the plug itself. ctx is
// {expDir, commit, obs} where obs carries raw command output
// gathered verbatim; plugs judge, transports never quote.
function validate_git_clean(ctx) {
  const stdout = stdoutOf(ctx.obs.git_clean);
  const exit = exitOf(ctx.obs.git_clean);
  const ok = exit === 0 && stdout === "";
  return {
    case: "adherence: no hand-edited state",
    rung: "2",
    evidence: { kind: "command", ref: "git status --porcelain", quote: quoteForStdout(stdout, exit) },
    verdict: ok ? "pass" : "fail",
  };
}

function validate_clean_commit(ctx) {
  const stdout = stdoutOf(ctx.obs.git_show);
  const exit = exitOf(ctx.obs.git_show);
  const shown = exit === 0 && stdout.indexOf(ctx.commit) >= 0;
  const clean = validate_git_clean(ctx).verdict === "pass";
  const first = stdout.split("\n")[0] || "";
  return {
    case: "adherence: clean commit",
    rung: "2",
    evidence: { kind: "command", ref: "git show " + ctx.commit, quote: quoteForStdout(first, exit) },
    verdict: shown && clean ? "pass" : "fail",
  };
}

function validate_run_folder_present(ctx) {
  const lines = Array.isArray(ctx.obs.run_folders) ? ctx.obs.run_folders : [];
  const complete = lines.filter(function (l) {
    return typeof l === "string" && l.indexOf("tape=yes") >= 0 && l.indexOf("notes=yes") >= 0;
  });
  const handoff = complete.filter(function (l) { return l.indexOf("-handoff-") >= 0; });
  const chosen = handoff[0] || complete[0] || "";
  return {
    case: "adherence: run folder present",
    rung: "2",
    evidence: {
      kind: "file",
      ref: ctx.expDir + "/runs/",
      quote: chosen !== "" ? chosen : "no run folder with tape.log and notes.md",
    },
    verdict: chosen !== "" ? "pass" : "fail",
  };
}

function validate_handoff_by_child(ctx) {
  const line = typeof ctx.obs.handoff_line === "string" ? ctx.obs.handoff_line : "";
  const ok = line.indexOf('"edge":"handoff"') >= 0 || line.indexOf('"edge":"submit"') >= 0;
  return {
    case: "adherence: handoff by child",
    rung: "2",
    evidence: {
      kind: "ledger",
      ref: ctx.expDir + "/ledger.jsonl handoff line",
      quote: line !== "" ? line : "(no handoff ledger line)",
    },
    verdict: ok ? "pass" : "fail",
  };
}

function validate_env_run_id_stamped(ctx) {
  const line = typeof ctx.obs.handoff_line === "string" ? ctx.obs.handoff_line : "";
  const ok = /"run_id":"[^"]+"/.test(line);
  return {
    case: "adherence: env run-id stamped",
    rung: "2",
    evidence: {
      kind: "ledger",
      ref: ctx.expDir + "/ledger.jsonl handoff line",
      quote: line !== "" ? line : "(no handoff ledger line)",
    },
    verdict: ok ? "pass" : "fail",
  };
}

const GRADE_VALIDATIONS = [
  validate_git_clean,
  validate_clean_commit,
  validate_run_folder_present,
  validate_handoff_by_child,
  validate_env_run_id_stamped,
];

function runValidations(ctx) {
  return GRADE_VALIDATIONS.map(function (v) { return v(ctx); });
}

function rowCase(row, i) {
  return row && typeof row.case === "string" && row.case !== ""
    ? row.case
