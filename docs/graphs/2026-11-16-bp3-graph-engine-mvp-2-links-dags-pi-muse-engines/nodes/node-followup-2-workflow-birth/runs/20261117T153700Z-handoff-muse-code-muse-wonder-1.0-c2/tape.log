    !validationsVerdict ||
    typeof validationsVerdict.git_clean !== "object" ||
    typeof validationsVerdict.git_show !== "object"
  ) {
    refusals.push(
      "audit failure: grade validations pipeline returned no observations: " +
      errorText(validationsResult)
