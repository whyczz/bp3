usage_text='usage: bp3 init [--harness=<pi|claude|codex|muse|all>] | bp3 skills install [...] | bp3 g|graph ... | bp3 e [<edge> ...] | bp3 harness ... | bp3 harness desk derive|create|inspect|remove|prepare|check|exit|release|list ... | bp3 worktree ... (alias of harness desk) | bp3 config [--source] [--format json|table]'
case "${1:-}" in
  -h|--help) printf '%s\n' "$usage_text"; printf '%s\n' '  bp3 g -h for graph/node doors'; exit 0 ;;
  q|graph) shift
    q_bin="${BP3_G_BIN:-$root/_build/default/src/graph/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/graph/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" "$@" ;;
  e) shift
    q_bin="${BP3_G_BIN:-$root/_build/default/src/graph/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/graph/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" e "$@" ;;
  harness) shift
    q_bin="${BP3_G_BIN:-$root/_build/default/src/graph/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/graph/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" harness "$@" ;;
  config) shift
    q_bin="${BP3_G_BIN:-$root/_build/default/src/graph/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/graph/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" config "$@" ;;
  worktree) shift
    q_bin="${BP3_G_BIN:-$root/_build/default/src/graph/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/graph/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" worktree "$@" ;;
  init) shift; skills_install "$@" ;;
  skills)
    shift
    case "${1:-}" in
      install) shift; skills_install "$@" ;;
      *) echo "$usage_text" >&2; exit 2 ;;
    esac
    ;;
  *) echo "$usage_text" >&2; exit 2 ;;
esac
