#!/usr/bin/env bash
# mvp.3: node deps, ready-set waves, starved sets, derived
# timing, setup gate, serial land. Fixture graphs are built
# through bp3 q itself; timing fixtures write ledger lines
# with fixed timestamps through git plumbing.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/repo/bin" "$work/repo/plans"
cp "$root/bin/bp3" "$work/repo/bin/"
cp "$root/_build/default/src/quest/main.exe" "$work/repo/q-bin"
cp "$root"/plans/*.yaml "$work/repo/plans/"
cd "$work/repo"
git init -q -b master
git config user.email t@t.t; git config user.name t
echo base > a.txt; git add .; git commit -qm base

export BP3_HARNESS=muse-code BP3_MODEL=test-model
q() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q "$@"; }
lk() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 harness link "$@"; }
fail() { echo "FAIL: $*" >&2; exit 1; }

commit_on_exp() { # $1 quest $2 exp $3 path $4 content -> new tip
  local branch="refs/heads/bp3/exp/$1/$2" tip blob tree new_tip idx="$work/idx-$1-$2"
  tip=$(git rev-parse "$branch"); rm -f "$idx"
  blob=$(printf '%s' "$4" | git hash-object -w --stdin)
  GIT_INDEX_FILE="$idx" git read-tree "$tip"
  GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,$3"
  tree=$(GIT_INDEX_FILE="$idx" git write-tree)
  new_tip=$(printf 'work %s\n' "$2" | git commit-tree "$tree" -p "$tip")
  git update-ref "$branch" "$new_tip" "$tip"; rm -f "$idx"
  printf '%s' "$new_tip"
}
land_exp() { # $1 quest $2 exp $3 path
  local c; c=$(commit_on_exp "$1" "$2" "$3" "content-$2")
  q "$1" u "$2" handoff --commit "$c" --reason work >/dev/null
  q "$1" u "$2" grade --verdict ship --reason ok >/dev/null
  q "$1" u "$2" verify --verdict pass --reason ok >/dev/null
  q "$1" u "$2" land --reason ship >/dev/null
}
exp_ledger() { git show "bp3/exp/$1/$2:docs/quests/$1/experiments/$2/ledger.jsonl"; }

# --- diamond: deps declared, waves, ready, handoff gate ---
q c sched >/dev/null
q sched c na >/dev/null; q sched c nb >/dev/null; q sched c nd >/dev/null
out=$(q sched c nc --depends-on na,nb)
echo "$out" | jq -e '.ok == true and .deps == ["na","nb"]' >/dev/null || fail "create deps: $out"
out=$(q sched r nc)
echo "$out" | jq -e '.deps == ["na","nb"] and .state == "todo"' >/dev/null || fail "deps read from record: $out"
out=$(q r sched)
echo "$out" | jq -e '.ready_set_waves == [["na","nb","nd"],["nc"]] and .ready == ["na","nb","nd"] and .starved == []' >/dev/null || fail "diamond waves: $out"
echo w > w.txt; git add w.txt; git commit -qm w; W=$(git rev-parse HEAD)
if out=$(q sched u nc handoff --commit "$W" --reason early 2>&1); then fail "dep-blocked handoff accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEPENDENCY" and (.error.facts.blocked_by == ["na","nb"])' >/dev/null || fail "handoff gate: $out"
land_exp sched na fa.txt; land_exp sched nb fb.txt
out=$(q r sched)
echo "$out" | jq -e '.ready == ["nc","nd"] and .ready_set_waves == [["nc","nd"]]' >/dev/null || fail "ready after land: $out"

# --- cycle refused at write time, naming the cycle ---
q sched c nx >/dev/null
q sched dep nx --depends-on nc --reason "chain" >/dev/null
before=$(exp_ledger sched nc | wc -l)
if out=$(q sched dep nc --depends-on nx --reason loop 2>&1); then fail "cycle dep accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEP_CYCLE" and (.error.facts.cycle | index("nc") != null) and (.error.facts.cycle | index("nx") != null)' >/dev/null || fail "cycle facts: $out"
[ "$(exp_ledger sched nc | wc -l)" = "$before" ] || fail "cycle refusal ledgered"
if out=$(q sched dep na --depends-on na --reason self 2>&1); then fail "self dep accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEP_CYCLE"' >/dev/null || fail "self cycle code: $out"
if out=$(q sched c ghost --depends-on nope 2>&1); then fail "unknown dep accepted"; fi
echo "$out" | jq -e '.error.code == "E_NOT_FOUND"' >/dev/null || fail "unknown dep code: $out"

# --- deps mutable-but-logged, mid-flight edit on the record ---
out=$(q sched dep nd --depends-on na --reason "nd waits for na")
echo "$out" | jq -e '.ok == true and .deps == ["na"] and .state == "todo"' >/dev/null || fail "dep edit: $out"
exp_ledger sched nd | tail -1 | jq -e '.edge == "dep" and .from == "todo" and .to == "todo" and .depends_on == ["na"]' >/dev/null || fail "dep line logged"
out=$(q sched u nd handoff --commit "$W" --reason work)
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "nd handoff (dep landed): $out"
out=$(q sched dep nd --depends-on nb --reason "mid-flight swap")
echo "$out" | jq -e '.ok == true and .state == "handed_off" and .deps == ["nb"]' >/dev/null || fail "mid-flight dep edit: $out"
exp_ledger sched nd | tail -1 | jq -e '.edge == "dep" and .from == "handed_off" and .to == "handed_off" and .cycle == 1 and .depends_on == ["nb"]' >/dev/null || fail "mid-flight dep line carries state+cycle"

# --- blocked blast radius: starved dependents, independents ready ---
q c blast >/dev/null
q blast c bx >/dev/null; q blast c bw >/dev/null
q blast c by --depends-on bx >/dev/null; q blast c bz --depends-on by >/dev/null
q blast u bx block --reason "choose storage" >/dev/null
out=$(q r blast)
echo "$out" | jq -e '.ready == ["bw"] and .starved == [{"blocked":"bx","starved":["by","bz"]}] and ([.inbox[] | select(.exp == "bx")] | length == 1)' >/dev/null || fail "starved rollup: $out"
if out=$(q blast u by handoff --commit "$W" --reason early 2>&1); then fail "starved handoff accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEPENDENCY"' >/dev/null || fail "starved handoff gate: $out"

# --- timing derived from ledger timestamps, hand-checked ---
q c timing >/dev/null; q timing c tm >/dev/null
tip=$(git rev-parse bp3/exp/timing/tm); idx="$work/idx-tm"; rm -f "$idx"
cat > "$work/tm-ledger.jsonl" <<EOF
{"ts":"2026-01-01T00:00:00Z","edge":"create","from":"","to":"todo","cycle":1,"commit":null,"verdict":null,"reason":"","harness":"t","model":"t","bp3_version":"0.2.0","exp_type":"default"}
{"ts":"2026-01-01T00:10:00Z","edge":"handoff","from":"todo","to":"handed_off","cycle":1,"commit":"$W","verdict":null,"reason":"work","harness":"t","model":"t","bp3_version":"0.2.0"}
{"ts":"2026-01-01T00:20:00Z","edge":"grade","from":"handed_off","to":"handed_off","cycle":1,"commit":"$W","verdict":"ship","reason":"ok","harness":"t","model":"t","bp3_version":"0.2.0"}
{"ts":"2026-01-01T00:30:00Z","edge":"verify","from":"handed_off","to":"approved","cycle":1,"commit":"$W","verdict":"pass","reason":"ok","harness":"t","model":"t","bp3_version":"0.2.0"}
{"ts":"2026-01-01T00:51:00Z","edge":"land","from":"approved","to":"landed","cycle":1,"commit":"$W","verdict":null,"reason":"ship","harness":"t","model":"t","bp3_version":"0.2.0"}
EOF
blob=$(git hash-object -w "$work/tm-ledger.jsonl")
GIT_INDEX_FILE="$idx" git read-tree "$tip"
GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,docs/quests/timing/experiments/tm/ledger.jsonl"
tree=$(GIT_INDEX_FILE="$idx" git write-tree)
nt=$(git commit-tree "$tree" -p "$tip" -m "timing fixture")
git update-ref refs/heads/bp3/exp/timing/tm "$nt" "$tip"; rm -f "$idx"
out=$(q timing r tm)
echo "$out" | jq -e '.state == "landed" and .timing.wait_s == 600 and .timing.wall_s == 2460 and .timing.dwell_s == {"todo":600,"handed_off":1200,"approved":1260} and .timing.cycles == 1' >/dev/null || fail "timing math: $out"
out2=$(q r timing)
echo "$out2" | jq -e '(.exps[] | select(.exp == "tm") | .timing.wall_s == 2460)' >/dev/null || fail "rollup timing: $out2"
before=$(git rev-parse bp3/exp/timing/tm)
q timing r tm >/dev/null; q r timing >/dev/null
[ "$(git rev-parse bp3/exp/timing/tm)" = "$before" ] || fail "timing read wrote state"
[ -z "$(git status --porcelain)" ] || fail "timing read dirtied worktree"

# --- setup measured per Run; slow fixture fires locally only ---
out=$(lk mint --kind edge --graph sched --node na --edge handoff --desk "$work/repo")
RID=$(echo "$out" | jq -r .run_id); TOK=$(echo "$out" | jq -r .token)
out=$(MUSE_SESSION_ID=sess-fast lk claim "$TOK")
echo "$out" | jq -e '.ok == true and .state == "claimed"' >/dev/null || fail "fast claim: $out"
rm -f .bp3-context.json
out=$(q r sched)
echo "$out" | jq -e --arg r "$RID" '(.setup[] | select(.run_id == $r) | .setup_wall_s >= 0 and .setup_wall_s < 180) and (has("warnings") | not or (.warnings | index("W_SETUP_SLOW") == null))' >/dev/null || fail "fast setup: $out"
out=$(lk mint --kind edge --graph sched --node nb --edge handoff --desk "$work/repo")
SRID=$(echo "$out" | jq -r .run_id)
jq '.state = "claimed" | .creator.minted_at = "2026-01-01T00:00:00Z" | .claim = {"session_id":"sess-slow","pid":1,"cwd":"/tmp","claimed_at":"2026-01-01T00:10:00Z"}' ".git/bp3/runs/$SRID.json" > "$work/slow.json"
cp "$work/slow.json" ".git/bp3/runs/$SRID.json"
out=$(q r sched)
echo "$out" | jq -e --arg r "$SRID" '(.setup[] | select(.run_id == $r) | .setup_wall_s == 600) and (.warnings | index("W_SETUP_SLOW") != null)' >/dev/null || fail "slow setup gate: $out"
for e in na nb nc nd nx; do
  exp_ledger sched "$e" | grep -q setup_wall && fail "setup leaked into ledger $e"
done

# --- serial land: second land re-checks against the new tip ---
q c serial >/dev/null; q serial c sl-a >/dev/null; q serial c sl-b >/dev/null
CA=$(commit_on_exp serial sl-a sa.txt "A"); CB=$(commit_on_exp serial sl-b sb.txt "B")
for e in sl-a sl-b; do
  c=$CA; [ "$e" = sl-b ] && c=$CB
  q serial u "$e" handoff --commit "$c" --reason work >/dev/null
  q serial u "$e" grade --verdict ship --reason ok >/dev/null
  q serial u "$e" verify --verdict pass --reason ok >/dev/null
done
out=$(q serial u sl-a land --reason first)
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "first land: $out"
tip1=$(git rev-parse bp3/quest/serial)
out=$(q serial r sl-b)
echo "$out" | jq -e '.state == "approved"' >/dev/null || fail "second still approved: $out"
out=$(q serial u sl-b land --reason second)
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "second land: $out"
git merge-base --is-ancestor "$tip1" bp3/quest/serial || fail "second land did not build on first tip"
git merge-base --is-ancestor "$CB" bp3/quest/serial || fail "second reviewed commit not in quest tip"
[ "$(git show bp3/quest/serial:sa.txt)" = "A" ] && [ "$(git show bp3/quest/serial:sb.txt)" = "B" ] || fail "serial merge lost files"

# --- help: dep verb and flags documented at their doors ---
out=$(q sched dep -h) || fail "dep -h exit"
echo "$out" | grep -q -- "--depends-on" || fail "dep help flags: $out"
echo "$out" | grep -q "E_DEP_CYCLE" || fail "dep help cycle: $out"
out=$(q sched -h) || fail "exp door -h exit"
echo "$out" | grep -q "dep" || fail "exp door help dep: $out"
echo "$out" | grep -q -- "--depends-on" || fail "exp door help depends-on: $out"

echo "ready tests: ok"
#!/usr/bin/env bash
# mvp.3: node deps, ready-set waves, starved sets, derived
# timing, setup gate, serial land. Fixture graphs are built
# through bp3 q itself; timing fixtures write ledger lines
# with fixed timestamps through git plumbing.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/repo/bin" "$work/repo/plans"
cp "$root/bin/bp3" "$work/repo/bin/"
cp "$root/_build/default/src/quest/main.exe" "$work/repo/q-bin"
cp "$root"/plans/*.yaml "$work/repo/plans/"
cd "$work/repo"
git init -q -b master
git config user.email t@t.t; git config user.name t
echo base > a.txt; git add .; git commit -qm base

export BP3_HARNESS=muse-code BP3_MODEL=test-model
q() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q "$@"; }
lk() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 harness link "$@"; }
fail() { echo "FAIL: $*" >&2; exit 1; }

commit_on_exp() { # $1 quest $2 exp $3 path $4 content -> new tip
  local branch="refs/heads/bp3/exp/$1/$2" tip blob tree new_tip idx="$work/idx-$1-$2"
  tip=$(git rev-parse "$branch"); rm -f "$idx"
  blob=$(printf '%s' "$4" | git hash-object -w --stdin)
  GIT_INDEX_FILE="$idx" git read-tree "$tip"
  GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,$3"
  tree=$(GIT_INDEX_FILE="$idx" git write-tree)
  new_tip=$(printf 'work %s\n' "$2" | git commit-tree "$tree" -p "$tip")
  git update-ref "$branch" "$new_tip" "$tip"; rm -f "$idx"
  printf '%s' "$new_tip"
}
land_exp() { # $1 quest $2 exp $3 path
  local c; c=$(commit_on_exp "$1" "$2" "$3" "content-$2")
  q "$1" u "$2" handoff --commit "$c" --reason work >/dev/null
  q "$1" u "$2" grade --verdict ship --reason ok >/dev/null
  q "$1" u "$2" verify --verdict pass --reason ok >/dev/null
  q "$1" u "$2" land --reason ship >/dev/null
}
exp_ledger() { git show "bp3/exp/$1/$2:docs/quests/$1/experiments/$2/ledger.jsonl"; }

# --- diamond: deps declared, waves, ready, handoff gate ---
q c sched >/dev/null
q sched c na >/dev/null; q sched c nb >/dev/null; q sched c nd >/dev/null
out=$(q sched c nc --depends-on na,nb)
echo "$out" | jq -e '.ok == true and .deps == ["na","nb"]' >/dev/null || fail "create deps: $out"
out=$(q sched r nc)
echo "$out" | jq -e '.deps == ["na","nb"] and .state == "todo"' >/dev/null || fail "deps read from record: $out"
out=$(q r sched)
echo "$out" | jq -e '.ready_set_waves == [["na","nb","nd"],["nc"]] and .ready == ["na","nb","nd"] and .starved == []' >/dev/null || fail "diamond waves: $out"
echo w > w.txt; git add w.txt; git commit -qm w; W=$(git rev-parse HEAD)
if out=$(q sched u nc handoff --commit "$W" --reason early 2>&1); then fail "dep-blocked handoff accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEPENDENCY" and (.error.facts.blocked_by == ["na","nb"])' >/dev/null || fail "handoff gate: $out"
land_exp sched na fa.txt; land_exp sched nb fb.txt
out=$(q r sched)
echo "$out" | jq -e '.ready == ["nc","nd"] and .ready_set_waves == [["nc","nd"]]' >/dev/null || fail "ready after land: $out"

# --- cycle refused at write time, naming the cycle ---
q sched c nx >/dev/null
q sched dep nx --depends-on nc --reason "chain" >/dev/null
before=$(exp_ledger sched nc | wc -l)
if out=$(q sched dep nc --depends-on nx --reason loop 2>&1); then fail "cycle dep accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEP_CYCLE" and (.error.facts.cycle | index("nc") != null) and (.error.facts.cycle | index("nx") != null)' >/dev/null || fail "cycle facts: $out"
[ "$(exp_ledger sched nc | wc -l)" = "$before" ] || fail "cycle refusal ledgered"
if out=$(q sched dep na --depends-on na --reason self 2>&1); then fail "self dep accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEP_CYCLE"' >/dev/null || fail "self cycle code: $out"
if out=$(q sched c ghost --depends-on nope 2>&1); then fail "unknown dep accepted"; fi
echo "$out" | jq -e '.error.code == "E_NOT_FOUND"' >/dev/null || fail "unknown dep code: $out"

# --- deps mutable-but-logged, mid-flight edit on the record ---
out=$(q sched dep nd --depends-on na --reason "nd waits for na")
echo "$out" | jq -e '.ok == true and .deps == ["na"] and .state == "todo"' >/dev/null || fail "dep edit: $out"
exp_ledger sched nd | tail -1 | jq -e '.edge == "dep" and .from == "todo" and .to == "todo" and .depends_on == ["na"]' >/dev/null || fail "dep line logged"
out=$(q sched u nd handoff --commit "$W" --reason work)
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "nd handoff (dep landed): $out"
out=$(q sched dep nd --depends-on nb --reason "mid-flight swap")
echo "$out" | jq -e '.ok == true and .state == "handed_off" and .deps == ["nb"]' >/dev/null || fail "mid-flight dep edit: $out"
exp_ledger sched nd | tail -1 | jq -e '.edge == "dep" and .from == "handed_off" and .to == "handed_off" and .cycle == 1 and .depends_on == ["nb"]' >/dev/null || fail "mid-flight dep line carries state+cycle"

# --- blocked blast radius: starved dependents, independents ready ---
q c blast >/dev/null
q blast c bx >/dev/null; q blast c bw >/dev/null
q blast c by --depends-on bx >/dev/null; q blast c bz --depends-on by >/dev/null
q blast u bx block --reason "choose storage" >/dev/null
out=$(q r blast)
echo "$out" | jq -e '.ready == ["bw"] and .starved == [{"blocked":"bx","starved":["by","bz"]}] and ([.inbox[] | select(.exp == "bx")] | length == 1)' >/dev/null || fail "starved rollup: $out"
if out=$(q blast u by handoff --commit "$W" --reason early 2>&1); then fail "starved handoff accepted"; fi
echo "$out" | jq -e '.error.code == "E_DEPENDENCY"' >/dev/null || fail "starved handoff gate: $out"

# --- timing derived from ledger timestamps, hand-checked ---
q c timing >/dev/null; q timing c tm >/dev/null
tip=$(git rev-parse bp3/exp/timing/tm); idx="$work/idx-tm"; rm -f "$idx"
cat > "$work/tm-ledger.jsonl" <<EOF
{"ts":"2026-01-01T00:00:00Z","edge":"create","from":"","to":"todo","cycle":1,"commit":null,"verdict":null,"reason":"","harness":"t","model":"t","bp3_version":"0.2.0","exp_type":"default"}
{"ts":"2026-01-01T00:10:00Z","edge":"handoff","from":"todo","to":"handed_off","cycle":1,"commit":"$W","verdict":null,"reason":"work","harness":"t","model":"t","bp3_version":"0.2.0"}
{"ts":"2026-01-01T00:20:00Z","edge":"grade","from":"handed_off","to":"handed_off","cycle":1,"commit":"$W","verdict":"ship","reason":"ok","harness":"t","model":"t","bp3_version":"0.2.0"}
{"ts":"2026-01-01T00:30:00Z","edge":"verify","from":"handed_off","to":"approved","cycle":1,"commit":"$W","verdict":"pass","reason":"ok","harness":"t","model":"t","bp3_version":"0.2.0"}
{"ts":"2026-01-01T00:51:00Z","edge":"land","from":"approved","to":"landed","cycle":1,"commit":"$W","verdict":null,"reason":"ship","harness":"t","model":"t","bp3_version":"0.2.0"}
EOF
blob=$(git hash-object -w "$work/tm-ledger.jsonl")
GIT_INDEX_FILE="$idx" git read-tree "$tip"
GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,docs/quests/timing/experiments/tm/ledger.jsonl"
tree=$(GIT_INDEX_FILE="$idx" git write-tree)
nt=$(git commit-tree "$tree" -p "$tip" -m "timing fixture")
git update-ref refs/heads/bp3/exp/timing/tm "$nt" "$tip"; rm -f "$idx"
out=$(q timing r tm)
echo "$out" | jq -e '.state == "landed" and .timing.wait_s == 600 and .timing.wall_s == 2460 and .timing.dwell_s == {"todo":600,"handed_off":1200,"approved":1260} and .timing.cycles == 1' >/dev/null || fail "timing math: $out"
out2=$(q r timing)
echo "$out2" | jq -e '(.exps[] | select(.exp == "tm") | .timing.wall_s == 2460)' >/dev/null || fail "rollup timing: $out2"
before=$(git rev-parse bp3/exp/timing/tm)
q timing r tm >/dev/null; q r timing >/dev/null
[ "$(git rev-parse bp3/exp/timing/tm)" = "$before" ] || fail "timing read wrote state"
dirty=$(git status --porcelain | wc -l | tr -d ' ')
[ "$dirty" = "0" ] || fail "timing read dirtied worktree: $dirty entries"
echo "timing read clean: tip unchanged, worktree entries: $dirty"
# No hand-edited state: reads derive timing from ledger timestamps
# and setup from machine-local run configs; neither writes a tracked
# ledger/state file. Counts are echoed so the check carries a
# quotable line (an empty porcelain output is not typed evidence).
tracked_state=$(git ls-files | grep -c -E 'ledger\.jsonl|state\.yaml' || true)
echo "tracked ledger/state files on fixture tip: $tracked_state"

# --- setup measured per Run; slow fixture fires locally only ---
out=$(lk mint --kind edge --graph sched --node na --edge handoff --desk "$work/repo")
RID=$(echo "$out" | jq -r .run_id); TOK=$(echo "$out" | jq -r .token)
out=$(MUSE_SESSION_ID=sess-fast lk claim "$TOK")
echo "$out" | jq -e '.ok == true and .state == "claimed"' >/dev/null || fail "fast claim: $out"
rm -f .bp3-context.json
out=$(q r sched)
echo "$out" | jq -e --arg r "$RID" '(.setup[] | select(.run_id == $r) | .setup_wall_s >= 0 and .setup_wall_s < 180) and (has("warnings") | not or (.warnings | index("W_SETUP_SLOW") == null))' >/dev/null || fail "fast setup: $out"
out=$(lk mint --kind edge --graph sched --node nb --edge handoff --desk "$work/repo")
SRID=$(echo "$out" | jq -r .run_id)
jq '.state = "claimed" | .creator.minted_at = "2026-01-01T00:00:00Z" | .claim = {"session_id":"sess-slow","pid":1,"cwd":"/tmp","claimed_at":"2026-01-01T00:10:00Z"}' ".git/bp3/runs/$SRID.json" > "$work/slow.json"
cp "$work/slow.json" ".git/bp3/runs/$SRID.json"
out=$(q r sched)
echo "$out" | jq -e --arg r "$SRID" '(.setup[] | select(.run_id == $r) | .setup_wall_s == 600) and (.warnings | index("W_SETUP_SLOW") != null)' >/dev/null || fail "slow setup gate: $out"
for e in na nb nc nd nx; do
  exp_ledger sched "$e" | grep -q setup_wall && fail "setup leaked into ledger $e"
done

# --- serial land: second land re-checks against the new tip ---
q c serial >/dev/null; q serial c sl-a >/dev/null; q serial c sl-b >/dev/null
CA=$(commit_on_exp serial sl-a sa.txt "A"); CB=$(commit_on_exp serial sl-b sb.txt "B")
for e in sl-a sl-b; do
  c=$CA; [ "$e" = sl-b ] && c=$CB
  q serial u "$e" handoff --commit "$c" --reason work >/dev/null
  q serial u "$e" grade --verdict ship --reason ok >/dev/null
  q serial u "$e" verify --verdict pass --reason ok >/dev/null
done
out=$(q serial u sl-a land --reason first)
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "first land: $out"
tip1=$(git rev-parse bp3/quest/serial)
out=$(q serial r sl-b)
echo "$out" | jq -e '.state == "approved"' >/dev/null || fail "second still approved: $out"
out=$(q serial u sl-b land --reason second)
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "second land: $out"
git merge-base --is-ancestor "$tip1" bp3/quest/serial || fail "second land did not build on first tip"
git merge-base --is-ancestor "$CB" bp3/quest/serial || fail "second reviewed commit not in quest tip"
[ "$(git show bp3/quest/serial:sa.txt)" = "A" ] && [ "$(git show bp3/quest/serial:sb.txt)" = "B" ] || fail "serial merge lost files"

# --- help: dep verb and flags documented at their doors ---
out=$(q sched dep -h) || fail "dep -h exit"
echo "$out" | grep -q -- "--depends-on" || fail "dep help flags: $out"
echo "$out" | grep -q "E_DEP_CYCLE" || fail "dep help cycle: $out"
out=$(q sched -h) || fail "exp door -h exit"
echo "$out" | grep -q "dep" || fail "exp door help dep: $out"
echo "$out" | grep -q -- "--depends-on" || fail "exp door help depends-on: $out"

echo "ready tests: ok"
=== induct-node test ===
// Mock-host test for skills/traverse/workflows/induct-node.js
// (mvp.3): one run owns one node's FSM loop and returns
// exactly one terminal outcome (landed, blocked, deleted).
import workflow from "../skills/traverse/workflows/induct-node.js";

const TS = "20260101T000000Z";
let failures = 0;
function assert(cond, msg) {
  if (!cond) { console.error("FAIL: " + msg); failures++; }
}

function mockHost({ reads, gradeReason }) {
  let readIdx = 0;
  const labels = [];
  const inputs = {};
  const host = {
    args: { quest: "toy", exp: "fx", ts: TS, harness: "muse-code", model: "test-model" },
    async agent({ label, input }) {
      if (input.includes("harness link mint")) {
        labels.push("mint");
        const e = input.match(/--edge (\S+)/);
        const edge = e ? e[1] : "node";
        const runId = TS + "-" + edge + "-muse-code-test-model-c1";
        return JSON.stringify({ ok: true, token: "bp3link_test-" + edge, run_id: runId });
      }
      if (input.includes("harness find-tape")) {
        labels.push("resolve");
        const m = input.match(/--run-id (\S+)/);
        return JSON.stringify({ ok: true, run_id: m ? m[1] : "", tape_path: "/tmp/tape.jsonl" });
      }
      if (input.includes("harness bind-tape")) {
        labels.push("bind");
        return JSON.stringify({ ok: true });
      }
      if (input.startsWith("Run exactly")) {
        return JSON.stringify(reads[Math.min(readIdx++, reads.length - 1)]);
      }
      const edge = label.split(" ")[0];
      labels.push(edge);
      (inputs[edge] = inputs[edge] || []).push(input);
      const reply = { ok: true, run_id: "r-" + edge, commit: "abc1234", verdict: { ok: true } };
      if (edge === "grade" && gradeReason) reply.reason = gradeReason;
      return JSON.stringify(reply);
    },
    async parallel(calls) {
      const out = [];
      for (const c of calls) out.push(await host.agent(c));
      return out;
    },
  };
  return { host, labels, inputs };
}

const st = (state, cycle) => ({ state, cycle: cycle || 1, commit: "abc1234", legal_edges: [] });

// --- happy path: todo -> handed_off -> approved -> landed, one outcome ---
{
  const reads = [st("todo"), st("handed_off"), st("handed_off"), st("approved"), st("landed")];
  const { host, labels, inputs } = mockHost({ reads });
  const result = await workflow(host);
  assert(result.outcome === "landed" && result.node === "fx", "happy outcome landed, got " + result.outcome);
  assert(result.commit === "abc1234", "happy commit, got " + result.commit);
  assert(labels.filter((l) => l === "handoff").length === 1, "one author, got " + labels.join(","));
  assert(labels.filter((l) => l === "grade").length === 1, "one grade, got " + labels.join(","));
  assert(labels.filter((l) => l === "verify").length === 1, "one verify, got " + labels.join(","));
  assert(labels.filter((l) => l === "land").length === 1, "one land, got " + labels.join(","));
  assert(inputs.grade[0].includes("abc1234"), "grade judges the bound commit");
  assert(inputs.handoff[0].includes("link claim bp3link_test-handoff"), "author claims first");
  assert(inputs.land[0].includes("u fx land"), "land child calls the land edge");
  assert(result.run_ids.length >= 4, "run_ids collected, got " + result.run_ids.join(","));
}

// --- needs_fix rides the loop: fix carried verbatim to the next author ---
{
  const reads = [st("todo"), st("handed_off"), st("todo", 2), st("todo", 2), st("handed_off", 2), st("handed_off", 2), st("approved", 2), st("landed", 2)];
  const { host, inputs } = mockHost({ reads, gradeReason: "fix the parser" });
  const result = await workflow(host);
  assert(result.outcome === "landed", "cycle outcome landed, got " + result.outcome);
  assert(inputs.handoff.length === 2, "two authors across cycles, got " + inputs.handoff.length);
  assert(inputs.handoff[1].includes("fix the parser"), "named fix rides verbatim");
}

// --- terminal states return at once, no edge worker spawns ---
for (const state of ["blocked", "deleted", "landed"]) {
  const { host, labels } = mockHost({ reads: [st(state)] });
  const result = await workflow(host);
  assert(result.outcome === state, state + " outcome, got " + result.outcome);
  assert(labels.length === 0, "no spawns for " + state + ", got " + labels.join(","));
}

// --- missing args refuse without spawning anything ---
{
  const host = {
    args: { quest: "toy" },
    async agent() { throw new Error("must not spawn"); },
    async parallel() { throw new Error("must not spawn"); },
  };
  const result = await workflow(host);
  assert(result.outcome === "refused", "missing args refuse");
}

if (failures > 0) process.exit(1);
console.log("induct-node tests: ok");
(* store — identity, plans, ledger fold: the truth layer. *)
open Gitx

(* ---------- slugs / identity ---------- *)
let valid_slug s =
  let n = String.length s in
  n >= 1 &&
  (let ok c = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c = '-' in
   let rec loop i = i >= n || (ok s.[i] && loop (i + 1)) in
   ((s.[0] >= 'a' && s.[0] <= 'z') || (s.[0] >= '0' && s.[0] <= '9')) && loop 1)

let check_slug s = if not (valid_slug s) then usage ("invalid slug: " ^ s)

(* Door and verb spellings across every bp3 door. A created
   quest or exp carrying one of these slugs could never be
   addressed again (the token would parse as the door or
   verb instead), so creation refuses it; reads stay total. *)
let reserved_slugs =
  [ "harness"; "worktree"; "icebox"; "hooks"; "init-repo"; "config"; "e"; "dep";
    "supervisor"; "init-check"; "find-tape"; "watch"; "desk"; "backtest"; "b";
    "c"; "create"; "r"; "read"; "u"; "update"; "d"; "delete";
    "s"; "i"; "f"; "w";
    "derive"; "inspect"; "remove"; "prepare"; "check"; "exit";
    "release"; "list" ]

let check_creatable s =
  check_slug s;
  if List.mem s reserved_slugs then
    usage ("reserved slug: " ^ s ^ " names a bp3 door or verb")

type identity = { harness : string; model : string; decider_human : bool; incomplete : bool; run_id : string option }

let run_id_of_env () =
  match Sys.getenv_opt "BP3_RUN_ID" with Some v when v <> "" -> Some v | _ -> None

(* The claimed run-id (mvp.2 context resolution), set by the
   CLI door once per call when a rung resolves. The claim
   wins over the env hint; env alone keeps the legacy
   stamping for unclaimed callers. *)
let resolved_run_id : string option ref = ref None
let context_warnings : string list ref = ref []

let effective_run_id () =
  match !resolved_run_id with Some _ as r -> r | None -> run_id_of_env ()

let stamp_run_id = function
  | `Assoc fs ->
      (match effective_run_id () with
       | Some r ->
           `Assoc (List.filter (fun (k, _) -> k <> "run_id") fs
                   @ [("run_id", json_str r)])
       | None -> `Assoc fs)
  | v -> v

let identity () =
  let h = Sys.getenv_opt "BP3_HARNESS" in
  (match h with
   | Some v when v <> "" ->
       if not (List.mem v ["muse-code"; "codex"; "muse"; "human"]) then
         err "E_IDENTITY" (`Assoc [("harness", json_str v)])
           "BP3_HARNESS must be one of muse-code, codex, muse, human." 2
   | _ -> ());
  let decider_human = (Sys.getenv_opt "BP3_DECIDER" = Some "human") in
  let harness = match h with Some v when v <> "" -> v | _ -> "unknown" in
  let model =
    if decider_human then "none"
    else match Sys.getenv_opt "BP3_MODEL" with Some v when v <> "" -> v | _ -> "unknown" in
  let incomplete = harness = "unknown" || model = "unknown" in
  { harness; model; decider_human; incomplete; run_id = run_id_of_env () }

let parse_version s =
  try List.map int_of_string (String.split_on_char '.' s) with _ -> [0]

let rec version_cmp a b =
  match a, b with
  | [], [] -> 0
  | [], _ -> version_cmp [0] b
  | _, [] -> version_cmp a [0]
  | x :: xs, y :: ys -> if x <> y then compare x y else version_cmp xs ys

let version_major v = match parse_version v with m :: _ -> m | [] -> 0

(* ---------- plans ---------- *)
type knobs = { max_cycles : int; grade_required : bool; verify_required : bool }

let contains_sub s sub =
  let n = String.length s and m = String.length sub in
  let rec loop i = i + m <= n && (String.sub s i m = sub || loop (i + 1)) in
  m = 0 || loop 0

let plan_knobs_from_text text =
  (* reject stages:/edges: keys at line start (after spaces) *)
  let lines = String.split_on_char '\n' text in
  List.iter (fun ln ->
    let t = String.trim ln in
    if t = "stages:" || (String.length t > 7 && String.sub t 0 7 = "stages:") ||
       t = "edges:" || (String.length t > 6 && String.sub t 0 6 = "edges:") then
      err "E_INVALID_PLAN" (`Assoc []) "Plan contains stages:/edges: keys; plans carry knobs only." 1
  ) lines;
  let max_cycles =
    try
      let re = Str.regexp "max_cycles:[ \t]*\\([0-9]+\\)" in
      ignore (Str.search_forward re text 0);
      int_of_string (Str.matched_group 1 text)
    with _ -> 1 in
  let grade_required =
    (* look at grade section: 'required: false' after 'grade:' *)
    if contains_sub text "required: false" && contains_sub text "grade:" then false
    else if contains_sub text "grade.required: false" then false
    else true in
  let grade_required =
    if contains_sub text "required: false" then
      (* only counts if a grade: key exists or grade_required spelling *)
      grade_required else grade_required in
  let verify_required =
    not (contains_sub text "verify: optional" || contains_sub text "verify: none"
         || contains_sub text "verify:optional" || contains_sub text "verify:none") in
  { max_cycles; grade_required; verify_required }

let load_plan_file path =
  let full = Filename.concat root path in
  if not (Sys.file_exists full) then
    err "E_INVALID_PLAN" (`Assoc [("plan", json_str path)]) ("Plan file missing: " ^ path) 1;
  plan_knobs_from_text (read_file_or full "")

let quest_knobs quest_type = load_plan_file ("plans/" ^ quest_type ^ ".yaml")

let effective_knobs ~quest_type ~exp_type =
  if exp_type = "default" || exp_type = "" then quest_knobs quest_type
  else load_plan_file ("plans/exp-" ^ exp_type ^ ".yaml")

(* ---------- ledger fold ---------- *)
type exp_state = {
  mutable st : string;
  mutable cycle : int;
  mutable bound : string option;
  mutable has_bound : bool;
  mutable grade_ok : bool;
  mutable verify_ok : bool;
  mutable blocked_reason : string;
  mutable blocked_checkpoint : string option;
  mutable blocked_since : string;
  mutable last_commit : string option;
  mutable exp_type : string;
}

let fresh_state () = {
  st = "todo"; cycle = 1; bound = None; has_bound = false;
  grade_ok = false; verify_ok = false;
  blocked_reason = ""; blocked_checkpoint = None; blocked_since = "";
  last_commit = None; exp_type = "default";
}

let get_str j key default =
  try match Yojson.Safe.Util.member key j with `String s -> s | _ -> default
  with _ -> default
let get_int j key default =
  try match Yojson.Safe.Util.member key j with `Int n -> n | _ -> default
  with _ -> default
let get_opt j key =
  try match Yojson.Safe.Util.member key j with `String s -> Some s | _ -> None
  with _ -> None

(* The one compat mapping (mig.1): pre-rename ledger strings fold
   to the new words here and nowhere else; new ledger lines already
   carry the new words. *)
let fold_edge = function
  | "submit" -> "handoff" | "review" -> "grade" | "check" -> "verify"
  | e -> e

let fold_state_name = function "submitted" -> "handed_off" | s -> s

let fold_ledger text =
  let s = fresh_state () in
  let quest_type = ref "default" in
  let depends_on = ref [] in
  String.split_on_char '\n' text |> List.iter (fun ln ->
    let ln = String.trim ln in
    if ln <> "" then
      try
        let j = Yojson.Safe.from_string ln in
        let edge = fold_edge (get_str j "edge" "") in
        let to_ = fold_state_name (get_str j "to" "") in
        let cyc = get_int j "cycle" s.cycle in
        if edge = "create" || edge = "dep" then begin
          if edge = "create" then begin
            s.exp_type <- get_str j "exp_type" (get_str j "quest_type" "default");
            quest_type := get_str j "quest_type" !quest_type
          end;
          (try match Yojson.Safe.Util.member "depends_on" j with
             | `List xs -> depends_on := List.map (function `String x -> x | _ -> "") xs
             | _ -> () with _ -> ())
        end;
        if to_ <> "" then s.st <- to_;
        s.cycle <- cyc;
        (match get_opt j "commit" with Some c -> s.last_commit <- Some c; s.bound <- Some c; s.has_bound <- true | None -> ());
        if edge = "handoff" then begin s.grade_ok <- false; s.verify_ok <- false end;
        if edge = "grade" && get_str j "verdict" "" = "ship" then s.grade_ok <- true;
        if edge = "verify" && get_str j "verdict" "" = "pass" then s.verify_ok <- true;
        if (edge = "grade" && get_str j "verdict" "" = "needs_fix") ||
           (edge = "verify" && get_str j "verdict" "" = "fail") then begin
          s.grade_ok <- false; s.verify_ok <- false
        end;
        if edge = "resume" then begin s.bound <- None; s.has_bound <- false; s.grade_ok <- false; s.verify_ok <- false end;
        if to_ = "blocked" then begin
          s.blocked_reason <- get_str j "reason" "";
          s.blocked_checkpoint <- get_opt j "checkpoint";
          s.blocked_since <- get_str j "ts" ""
        end
      with _ ->
        err "E_INVALID_PLAN" (`Assoc []) "Malformed ledger line." 1
  );
  (s, !quest_type, !depends_on)

let ledger_text branch path =
  match ref_tip branch with
  | None -> None
  | Some tip -> (match git_show tip path with Some t -> Some (tip, t) | None -> Some (tip, ""))

let quest_branch q = "refs/heads/bp3/quest/" ^ q
let exp_branch q e = "refs/heads/bp3/exp/" ^ q ^ "/" ^ e
let quest_dir q = "docs/quests/" ^ q
let quest_ledger_path q = quest_dir q ^ "/ledger.jsonl"
let exp_dir q e = quest_dir q ^ "/experiments/" ^ e
let exp_ledger_path q e = exp_dir q e ^ "/ledger.jsonl"
let exp_state_path q e = exp_dir q e ^ "/state.yaml"

let list_refs prefix =
  let out, code = git_out ["for-each-ref"; "--format=%(refname)"; prefix] in
  if code <> 0 then [] else
  String.split_on_char '\n' out |> List.map String.trim |> List.filter (fun s -> s <> "")

let list_quests () =
  list_refs "refs/heads/bp3/quest/" |> List.map (fun r ->
    let p = "refs/heads/bp3/quest/" in String.sub r (String.length p) (String.length r - String.length p))

let list_exps q =
  let p = "refs/heads/bp3/exp/" ^ q ^ "/" in
  list_refs p |> List.map (fun r -> String.sub r (String.length p) (String.length r - String.length p))

(* newest bp3_version stamped in any quest/exp ledger in this repo *)
let newest_bp3_version () =
  let from_text acc text =
    List.fold_left (fun acc line ->
      try
        match Yojson.Safe.from_string line with
        | `Assoc fs ->
            (match List.assoc_opt "bp3_version" fs with
             | Some (`String v) ->
                 (match acc with
                  | Some cur when version_cmp (parse_version cur) (parse_version v) >= 0 -> acc
                  | _ -> Some v)
             | _ -> acc)
        | _ -> acc
      with _ -> acc) acc (String.split_on_char '\n' text) in
  List.fold_left (fun acc q ->
    let acc = match ledger_text (quest_branch q) (quest_ledger_path q) with
      | Some (_, t) -> from_text acc t | None -> acc in
    List.fold_left (fun acc e ->
      match ledger_text (exp_branch q e) (exp_ledger_path q e) with
      | Some (_, t) -> from_text acc t | None -> acc) acc (list_exps q))
    None (list_quests ())

let version_ahead () =
  match newest_bp3_version () with
  | Some v when version_cmp (parse_version v) (parse_version bp3_version) > 0 -> Some v
  | _ -> None

let warnings_of id is_write =
  (if is_write && id.incomplete then ["W_IDENTITY_UNKNOWN"] else [])
  @ (match version_ahead () with Some _ -> ["W_VERSION_AHEAD"] | None -> [])

let fold_exp q e =
  match ledger_text (exp_branch q e) (exp_ledger_path q e) with
  | None -> None
  | Some (tip, text) -> let (s, _, _) = fold_ledger text in Some (tip, s, text)

let fold_quest q =
  match ledger_text (quest_branch q) (quest_ledger_path q) with
  | None -> None
  | Some (tip, text) -> let (s, qt, deps) = fold_ledger text in Some (tip, s, qt, deps, text)

let legal_edges st =
  match st with
  | "todo" -> ["handoff"; "block"; "delete"]
  | "handed_off" -> ["grade"; "verify"; "block"; "delete"]
  | "approved" -> ["land"; "block"; "delete"]
  | "blocked" -> ["resume"; "delete"]
  | _ -> []

let state_yaml q e s =
  Printf.sprintf "quest: %s\nexp: %s\nstate: %s\ncycle: %d\ncommit: %s\n"
    q e s.st s.cycle (match s.last_commit with Some c -> c | None -> "none")

let ledger_line ~edge ~from ~to_ ~cycle ~commit ~verdict ~reason ~id
    ?checkpoint ?extra () =
  let base = [
    ("ts", json_str (now_ts ()));
    ("edge", json_str edge);
    ("from", json_str from);
    ("to", json_str to_);
    ("cycle", `Int cycle);
    ("commit", (match commit with Some c -> json_str c | None -> `Null));
    ("verdict", (match verdict with Some v -> json_str v | None -> `Null));
    ("reason", json_str reason);
    ("harness", json_str id.harness);
    ("model", json_str id.model);
    ("bp3_version", json_str bp3_version);
  ] in
  let base = match id.run_id with Some r -> base @ [("run_id", json_str r)] | None -> base in
  let base = match checkpoint with Some c -> base @ [("checkpoint", json_str c)] | None -> base in
  let base = base @ (match extra with Some xs -> xs | None -> []) in
  Yojson.Safe.to_string (`Assoc base)

let append_exp_line q e line new_state =
  let branch = exp_branch q e in
  match ledger_text branch (exp_ledger_path q e) with
  | None -> not_found "exp" e
  | Some (tip, text) ->
      let new_text = (if String.trim text = "" then "" else
        (if text.[String.length text - 1] = '\n' then text else text ^ "\n")) ^ line ^ "\n" in
      commit_files ~branch ~base_tip:tip ~expect_tip:tip
        ~files:[(exp_ledger_path q e, new_text); (exp_state_path q e, state_yaml q e new_state)]
        ~msg:("bp3: " ^ e)

let make_checkpoint () =
  let idx = tmp_path "ckpt-index" in
  Unix.putenv "GIT_INDEX_FILE" idx;
  let head = head_sha () in
  ignore (run_status (git ["read-tree"; head]));
  ignore (run_status (git ["add"; "-A"]));
  let treef = tmp_path "ckpt-tree" in
  ignore (Sys.command (String.concat " " (List.map Filename.quote (git ["write-tree"]))
      ^ " > " ^ Filename.quote treef ^ " 2>/dev/null"));
  let tree = String.trim (read_file_or treef "") in
  let msgf = write_tmp "bp3 checkpoint" in
  let cf = tmp_path "ckpt-commit" in
  ignore (Sys.command (String.concat " " (List.map Filename.quote (git ["commit-tree"; tree; "-p"; head]))
      ^ " < " ^ Filename.quote msgf ^ " > " ^ Filename.quote cf ^ " 2>/dev/null"));
  Unix.putenv "GIT_INDEX_FILE" "";
  String.trim (read_file_or cf "")

let dep_satisfied dep =
  match fold_quest dep with
  | None -> false
  | Some (_, qs, _, _, _) ->
      if qs.st = "deleted" then false
      else
        let exps = list_exps dep in
        exps <> [] && List.for_all (fun e ->
          match fold_exp dep e with Some (_, s, _) -> s.st = "landed" || s.st = "deleted" | None -> false) exps

(* ---------- schedule and timing (mvp.3) ---------- *)
(* Node deps live in exp ledger records (create and dep
   lines); ready-set waves, the ready set, starved sets,
   and per-node timing are derived on read from ledger
   timestamps and never written to any committed file. *)
let days_from_civil y m d =
  let y = if m <= 2 then y - 1 else y in
  let era = (if y >= 0 then y else y - 399) / 400 in
  let yoe = y - era * 400 in
  let mp = if m > 2 then m - 3 else m + 9 in
  let doy = (153 * mp + 2) / 5 + d - 1 in
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy in
  era * 146097 + doe - 719468

let ts_epoch s =
  try
    if String.length s <> 20 || s.[4] <> '-' || s.[7] <> '-' || s.[10] <> 'T'
       || s.[13] <> ':' || s.[16] <> ':' || s.[19] <> 'Z' then None
    else
      let num a b = int_of_string (String.sub s a b) in
      let days = days_from_civil (num 0 4) (num 5 2) (num 8 2) in
      Some (days * 86400 + (num 11 2) * 3600 + (num 14 2) * 60 + (num 17 2))
  with _ -> None

let deps_of_text text = let (_, _, deps) = fold_ledger text in deps

type timing = { t_wall : int option; t_wait : int option;
                t_dwell : (string * int) list }

let timing_of_text text =
  let created = ref None and first_handoff = ref None and landed = ref None in
  let dwell : (string, int) Hashtbl.t = Hashtbl.create 8 in
  let order = ref [] in
  let cur = ref "" and since = ref None in
  let add_dwell st secs =
    if not (Hashtbl.mem dwell st) then order := !order @ [st];
    Hashtbl.replace dwell st ((try Hashtbl.find dwell st with _ -> 0) + secs) in
  String.split_on_char '\n' text |> List.iter (fun ln ->
    let ln = String.trim ln in
    if ln <> "" then
      try
        let j = Yojson.Safe.from_string ln in
        let edge = fold_edge (get_str j "edge" "") in
        let to_ = fold_state_name (get_str j "to" "") in
        (match ts_epoch (get_str j "ts" "") with
         | None -> ()
         | Some t ->
             if edge = "create" && !created = None then created := Some t;
             if edge = "handoff" && !first_handoff = None then first_handoff := Some t;
             if to_ = "landed" && !landed = None then landed := Some t;
             if to_ <> "" then begin
               (match !since with
                | Some t0 when !cur <> "" -> add_dwell !cur (t - t0)
                | _ -> ());
               cur := to_; since := Some t
             end)
      with _ -> ());
  let sub a b = match a, b with Some x, Some y -> Some (x - y) | _ -> None in
  { t_wall = sub !landed !first_handoff; t_wait = sub !first_handoff !created;
    t_dwell = List.sort compare
      (List.map (fun st -> (st, Hashtbl.find dwell st)) !order) }

let dep_cycle_through graph start =
  let deps_of n = match List.assoc_opt n graph with Some ds -> ds | None -> [] in
  let rec visit path n =
    if n = start && path <> [] then Some (List.rev (n :: path))
    else if List.mem n path then None
    else List.fold_left (fun acc d ->
      match acc with Some _ -> acc | None -> visit (n :: path) d) None (deps_of n) in
  (match visit [] start with
   | Some (_ :: _ :: _ as cyc) -> Some cyc
   | _ -> None)

type sched_node = { n_id : string; n_state : string; n_deps : string list }

let sched_waves nodes =
  let done0 = List.filter_map (fun n ->
    if n.n_state = "landed" || n.n_state = "deleted" then Some n.n_id else None) nodes in
  let todo = List.filter (fun n -> n.n_state = "todo") nodes in
  let rec loop finished acc =
    let layer = List.filter (fun n ->
      not (List.mem n.n_id finished)
      && List.for_all (fun d -> List.mem d finished) n.n_deps) todo in
    match layer with
    | [] -> List.rev acc
    | _ -> loop (finished @ List.map (fun n -> n.n_id) layer)
             ((List.sort String.compare (List.map (fun n -> n.n_id) layer)) :: acc) in
  loop done0 []

let sched_starved nodes =
  let dependents d =
    List.filter_map (fun n -> if List.mem d n.n_deps then Some n.n_id else None) nodes in
  List.filter_map (fun b ->
    if b.n_state <> "blocked" then None
    else
      let seen = ref [b.n_id] and frontier = ref [b.n_id] in
      while !frontier <> [] do
        let next = List.concat_map dependents !frontier in
        frontier := List.filter (fun x -> not (List.mem x !seen)) next;
        seen := !seen @ !frontier
      done;
      let starved = List.sort String.compare
        (List.filter (fun id ->
           id <> b.n_id
           && (match List.find_opt (fun n -> n.n_id = id) nodes with
               | Some n -> n.n_state = "todo" | None -> false)) !seen) in
      if starved = [] then None else Some (b.n_id, starved)) nodes

(* ---------- icebox reader ---------- *)
(* Frozen entries are plain files, not state: read-only, dumb
   line parsing, malformed files degrade to [-] fields. *)
type icebox_entry = {
  slug : string; date : string; status : string;
  promoted : string option; title : string; text : string;
}

let parse_icebox_entry slug text =
  let lines = String.split_on_char '\n' text in
  let fm_lines = match lines with
    | first :: rest when String.trim first = "---" ->
        let rec take acc = function
          | [] -> []
          | l :: _ when String.trim l = "---" -> List.rev acc
          | l :: r -> take (l :: acc) r in
        take [] rest
    | _ -> [] in
  let field k =
    let rec go = function
      | [] -> None
      | l :: r ->
          (match String.index_opt l ':' with
           | Some i when String.trim (String.sub l 0 i) = k ->
               let v = String.trim (String.sub l (i + 1) (String.length l - i - 1)) in
               if v = "" then None else Some v
           | _ -> go r) in
    go fm_lines in
  let or_dash = function Some v -> v | None -> "-" in
  let promoted = match field "promoted" with Some "null" -> None | other -> other in
  let title =
    let rec go = function
      | [] -> "-"
      | l :: r when String.length l >= 2 && String.sub l 0 2 = "# " ->
          let t = String.trim (String.sub l 2 (String.length l - 2)) in
          if t = "" then go r else t
      | _ :: r -> go r in
    go lines in
  { slug; date = or_dash (field "date"); status = or_dash (field "status");
    promoted; title; text }

let list_icebox_entries () =
  let dir = Filename.concat root "docs/icebox" in
  let names = try Array.to_list (Sys.readdir dir) with _ -> [] in
  names
  |> List.filter (fun n -> n <> "README.md" && Filename.check_suffix n ".md"
      && not (try Sys.is_directory (Filename.concat dir n) with _ -> false))
  |> List.sort String.compare
  |> List.map (fun n ->
       parse_icebox_entry (Filename.remove_extension n)
         (read_file_or (Filename.concat dir n) ""))

let icebox_matches e terms =
  let hay = String.lowercase_ascii (e.slug ^ "\n" ^ e.title ^ "\n" ^ e.text) in
  List.for_all (fun t -> contains_sub hay (String.lowercase_ascii t)) terms

let icebox_entry_json e =
  `Assoc [("slug", json_str e.slug); ("date", json_str e.date);
          ("status", json_str e.status);
          ("promoted", (match e.promoted with Some p -> json_str p | None -> `Null));
          ("title", json_str e.title)]

