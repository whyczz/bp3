[0.000, "o", "\r\n=== 2. Refusal path & 10-way concurrent claim race ===\r\n"]
[0.000, "o", "$ bp3 ticket add --to nonexistent --title typo   # strict --to -> E_NOT_FOUND (rc 2)\r\n"]
[0.020, "o", "rc=2 {\"ok\":false,\"code\":\"E_NOT_FOUND\",\"registered\":[\"fake-bp3\",\"fake-predictor\"]}\r\n"]
[0.021, "o", "$ spawning 10 concurrent: bp3 ticket claim 2 --by worker-{1..10}\r\n"]
[0.089, "o", "race result: ok=1 E_ALREADY_CLAIMED=9 other/E_DB_ERROR=0\r\n"]
[0.000, "o", "$ bp3 ticket done 1 --reason again   # terminal -> E_ILLEGAL_EDGE (rc 1)\r\n"]
[0.015, "o", "rc=1 {\"ok\":false,\"code\":\"E_ILLEGAL_EDGE\",\"facts\":{\"id\":1,\"status\":\"done\",\"verb\":\"done\",\"legal_verbs\":[]}}\r\n"]
[0.003, "o", "\r\n=== 3. Recovery & worktree dedup + historical ticket preservation ===\r\n"]
[0.037, "o", "$ bp3 repo add <worktree> -> dedupes to main repo:\r\n"]
