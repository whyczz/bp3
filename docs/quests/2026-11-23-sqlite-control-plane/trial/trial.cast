[0.058, "o", "\r\n=== 1. Happy path: SQLite init (WAL v1), auto-register on bp3 init, cross-repo ticket lifecycle ===\r\n$ bp3 db info\r\n"]
[0.022, "o", "\u001b[1;39m{\u001b[0m\u001b[1;34m\"ok\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"schema_version\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"journal_mode\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"wal\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"counts\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[1;39m{\u001b[0m\u001b[1;34m\"repos\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"tickets_open\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"tickets_total\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m}\u001b[0m\u001b[1;39m}\u001b[0m\r\n"]
[0.709, "o", "$ bp3 repo list --format table\r\n"]
