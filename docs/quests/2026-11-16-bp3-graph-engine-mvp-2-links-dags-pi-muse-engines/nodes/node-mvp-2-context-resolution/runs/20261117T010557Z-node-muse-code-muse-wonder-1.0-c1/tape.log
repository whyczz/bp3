diff --git a/src/quest/config.ml b/src/quest/config.ml
index 3e53aac..2518a19 100644
--- a/src/quest/config.ml
+++ b/src/quest/config.ml
@@ -282,6 +282,116 @@ let derivations_count dir =
   if not (Sys.file_exists dd) then 0
