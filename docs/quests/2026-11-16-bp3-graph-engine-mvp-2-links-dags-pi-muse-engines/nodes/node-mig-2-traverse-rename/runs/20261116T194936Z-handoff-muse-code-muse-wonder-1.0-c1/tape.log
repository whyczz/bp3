=== bin/bp3 skills install section ===
#!/usr/bin/env bash
# bp3 project tooling (pre-binary). The OCaml CLI absorbs these subcommands
# later; the interface stays: bp3 skills install --harness=<name|all>.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
src_dir="$root/skills"

# harness -> skills_dir. Sources are plain Markdown: no templating in bp3.
# The render is a copy plus a GENERATED notice after the frontmatter.
harness_target() {
  case "$1" in
    pi)     echo ".pi/skills" ;;
    claude) echo ".claude/skills" ;;
    codex)  echo ".agents/skills" ;;
    muse)   echo ".agents/skills" ;;
    *) return 1 ;;
  esac
}

install_one() {
  local skill="$1" harness="$2" target_dir dest
  target_dir="$(harness_target "$harness")"
  dest="$root/$target_dir/$skill"
  mkdir -p "$dest"
  awk -v h="$harness" -v s="$skill" '
    /^---$/ { n++; print; if (n == 2) printf "<!-- GENERATED from skills/%s/SKILL.md by: bp3 skills install --harness=%s. Edit the source, then re-run. -->\n", s, h; next }
    { print }' "$src_dir/$skill/SKILL.md" > "$dest/SKILL.md"
  echo "installed $skill -> $target_dir/$skill/SKILL.md ($harness)"
}

skills_install() {
  local harness="all"
  while [ $# -gt 0 ]; do
    case "$1" in
      --harness=*) harness="${1#--harness=}" ;;
      --harness) [ $# -ge 2 ] || { echo '--harness needs a value' >&2; exit 2; }; harness="$2"; shift ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
  done

  local harnesses
  if [ "$harness" = "all" ]; then
    harnesses="pi claude codex muse"
  else
    harnesses="$harness"
  fi

  # Preflight every source and the selected harness before writing any render.
  "$root/scripts/check-skills" "$src_dir"
  local h
  for h in $harnesses; do
    harness_target "$h" >/dev/null || { echo "unknown harness: $h" >&2; exit 2; }
  done

  # Pi discovers .agents as well as .pi. Prefer our Pi copies per project,
  # without deleting Codex/Muse skills or hiding unrelated .agents skills.
  local settings_plan='' existing='{}' ids
  case " $harnesses " in
    *" pi "*)
      if [ -e "$root/.pi/settings.json" ]; then
        existing="$(jq -sce 'select(length == 1) | .[0] | select(type == "object")' "$root/.pi/settings.json")" || { echo 'invalid .pi/settings.json' >&2; exit 1; }
      fi
      ids="$(find "$src_dir" -mindepth 2 -maxdepth 2 -name SKILL.md | while IFS= read -r file; do basename "$(dirname "$file")"; done | LC_ALL=C sort | jq -Rsc 'split("\n") | map(select(length > 0))')"
      settings_plan="$(jq -ce --argjson ids "$ids" '
        if has("skills") and (.skills | type != "array" or any(.[]; type != "string")) then error("skills must be an array of strings") else . end |
        (.skills // []) as $existing |
        .skills = ($existing + [$ids[] | "!**/.agents/skills/" + . + "/SKILL.md" | select(. as $p | $existing | index($p) | not)])
      ' <<< "$existing")" || { echo 'invalid .pi/settings.json skills list' >&2; exit 1; }
      ;;
  esac

  # The induct saved workflows ship with the induct skill. They are
  # plain copies (no render notice); the target is the project workflows
  # dir every harness discovers. Absent source means nothing to copy.
  local workflow_names="induct-exp induct-grade quest-land"

  local skill_dir skill
  for skill_dir in "$src_dir"/*/; do
    skill="$(basename "$skill_dir")"
    [ -f "$skill_dir/SKILL.md" ] || continue
    for h in $harnesses; do
      install_one "$skill" "$h"
    done
  done
  if [ -n "$settings_plan" ]; then
    printf '%s\n' "$settings_plan" | jq . > "$root/.pi/settings.json"
  fi
  local workflow_name
  for workflow_name in $workflow_names; do
    if [ -f "$src_dir/induct/workflows/$workflow_name.js" ]; then
      mkdir -p "$root/.agents/workflows"
      cp "$src_dir/induct/workflows/$workflow_name.js" "$root/.agents/workflows/$workflow_name.js"
      echo "installed $workflow_name -> .agents/workflows/$workflow_name.js"
    fi
  done
  # Muse hook registration: one fail-open emitter command for
  # every event. Repos without this file never fire hooks.
  mkdir -p "$root/.claude"
  cat > "$root/.claude/hooks.json" <<'HOOKS_JSON'
{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PostLLMCall": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}]
  }
}
HOOKS_JSON
  echo "installed hooks -> .claude/hooks.json"
  # Claude Code loads hooks from settings.json, not hooks.json
  # (live probe 2026-11-14: hooks.json alone never fired; the
  # same hooks under settings.json produced ledger event lines).
  # Merge into any existing settings, preserving other keys.
  local claude_settings="$root/.claude/settings.json"
  local existing_settings='{}'
  if [ -e "$claude_settings" ]; then
    existing_settings="$(cat "$claude_settings")"
  fi
  printf '%s\n' "$existing_settings" | jq --slurpfile hj "$root/.claude/hooks.json" \
    '.hooks = $hj[0].hooks' > "$claude_settings.tmp"
  mv "$claude_settings.tmp" "$claude_settings"
  echo "installed hooks -> .claude/settings.json"
  # Muse hook registration: project tier .muse/hooks.json at the
  # workspace root (live probe 2026-11-13: fires in the main session
  # and in workflow children; no settings merge needed).
  case " $harnesses " in
    *" muse "*)
      mkdir -p "$root/.muse"
      cp "$root/.claude/hooks.json" "$root/.muse/hooks.json"
      echo "installed hooks -> .muse/hooks.json"
      ;;
  esac
  # Note: codex and muse share .agents/skills; under --harness=all the muse
  # render (same dir) is written last. Invocation text differs only in the
  # trigger line; both harnesses accept the skill by name.
  # Tab completion delivery: copy the scripts into an existing zsh
  # completions dir when one is found (BP3_COMPLETIONS_DIR overrides the
  # search); otherwise print the path to add. Never edit a shell rc file.
  local comp_src="$root/completions/_bp3" comp_bash_src="$root/completions/bp3.bash"
  if [ -f "$comp_src" ]; then
    local comp_dest=''
    if [ -n "${BP3_COMPLETIONS_DIR:-}" ]; then
      comp_dest="$BP3_COMPLETIONS_DIR"
    else
      local cand
      for cand in "${ZDOTDIR:-$HOME}/.zsh/completions" "$HOME/.zsh/completions" \
        /opt/homebrew/share/zsh/site-functions /usr/local/share/zsh/site-functions \
        "$HOME/.local/share/zsh/site-functions"; do
        if [ -d "$cand" ]; then comp_dest="$cand"; break; fi
      done
    fi
    if [ -n "$comp_dest" ]; then
      mkdir -p "$comp_dest"
      cp "$comp_src" "$comp_dest/_bp3"
      echo "installed _bp3 -> $comp_dest/_bp3"
      echo "completion: source $comp_bash_src (bash)"
    else
      echo "completion: add $root/completions to fpath (zsh: fpath=($root/completions \$fpath); compinit) or source $comp_bash_src (bash)"
    fi
  fi
}

usage_text='usage: bp3 init [--harness=<pi|claude|codex|muse|all>] | bp3 skills install [...] | bp3 q|quest ... | bp3 harness ... | bp3 harness desk derive|create|inspect|remove|prepare|check|exit|release|list ... | bp3 worktree ... (alias of harness desk)'
case "${1:-}" in
  -h|--help) printf '%s\n' "$usage_text"; printf '%s\n' '  bp3 q -h for quest/exp doors'; exit 0 ;;
  q|quest) shift
    q_bin="${BP3_Q_BIN:-$root/_build/default/src/quest/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/quest/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" "$@" ;;
  harness) shift
    q_bin="${BP3_Q_BIN:-$root/_build/default/src/quest/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/quest/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" harness "$@" ;;
  worktree) shift
    q_bin="${BP3_Q_BIN:-$root/_build/default/src/quest/main.exe}"
    [[ -x $q_bin ]] || { echo 'build the q binary first: dune build src/quest/main.exe' >&2; exit 2; }
    BP3_ROOT="$root" exec "$q_bin" worktree "$@" ;;
  init) shift; skills_install "$@" ;;
  skills)
    shift
    case "${1:-}" in
      install) shift; skills_install "$@" ;;
      *) echo "$usage_text" >&2; exit 2 ;;
    esac
    ;;
  *) echo "$usage_text" >&2; exit 2 ;;
esac

