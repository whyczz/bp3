[0.056, "o", "\r\n==> Scenario 2: Tiered CAS bp3 release (parallel disjoint quests q1 + q2, --ff-only, doc_only drift, verify fail)\r\n"]
[0.964, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"ok\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"tag\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"v0.1.0\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"strategy\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"fast_forward\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"drift_kind\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"none\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"attempts\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39m1\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.059, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"ok\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39mfalse\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"code\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"E_NOT_FAST_FORWARD\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.114, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"ok\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39mfalse\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"code\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"E_VERIFY_FAILED\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"drift\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"code\"\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
