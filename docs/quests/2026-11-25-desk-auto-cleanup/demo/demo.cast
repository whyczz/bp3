[0.072, "o", "== 1. Prepare quest desk, land node, and run bp3 release demo-q ==\r\n"]
[0.213, "o", "quest desk: /var/folders/sh/r22bzrss2pv_qh335d1tf04h0000gn/T//bp3-demo-cleanup.QXJIWE/desks/repo-77ff66bd/quests/demo-q\r\n"]
[0.545, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"tag\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"v0.2.0\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"released_desks\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n    \u001b[0;32m\"quest-demo-q\"\u001b[0m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"kept_desks\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[]\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"branch_deleted\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39mtrue\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.004, "o", "== 2. Plant a dirty leftover desk, preview with prune --dry-run ==\r\n"]
[0.180, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"dry_run\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"kept\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n    \u001b[1;39m{\u001b[0m\r\n      \u001b[1;34m\"run_id\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"quest-stale-q\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"path\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"/var/folders/sh/r22bzrss2pv_qh335d1tf04h0000gn/T//bp3-demo-cleanup.QXJIWE/desks/repo-77ff66bd/quests/stale-q\"\u001b[0m\u001b[1;39m,\u001b[0m\r\n      \u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[0;32m\"dirty\"\u001b[0m\r\n    \u001b[1;39m}\u001b[0m\r\n  \u001b[1;39m]\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.003, "o", "== 3. Real prune keeps dirty desk safe; once cleaned, prune sweeps it ==\r\n"]
[0.155, "o", "\u001b[1;39m{\u001b[0m\r\n  \u001b[1;34m\"released\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n    \u001b[0;32m\"quest-stale-q\"\u001b[0m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m,\u001b[0m\r\n  \u001b[1;34m\"deleted_branches\"\u001b[0m\u001b[1;39m:\u001b[0m \u001b[1;39m[\u001b[0m\r\n    \u001b[0;32m\"quest/stale-q\"\u001b[0m\r\n  \u001b[1;39m]\u001b[0m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.004, "o", "demo ok: release auto-cleanup + desk prune verified!\r\n"]
