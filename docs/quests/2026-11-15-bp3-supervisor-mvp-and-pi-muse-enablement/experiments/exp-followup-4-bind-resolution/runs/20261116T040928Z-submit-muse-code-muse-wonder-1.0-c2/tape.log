476:# --- finish evidence (followup.2): per-harness, tail-scoped ---
503:echo "$last" | jq -e '(.runs[] | select(.run_id == "R-f2-muse-exit") | .lifecycle == "finished")' >/dev/null || fail "followup.2 muse exit-entry fold: $last"
