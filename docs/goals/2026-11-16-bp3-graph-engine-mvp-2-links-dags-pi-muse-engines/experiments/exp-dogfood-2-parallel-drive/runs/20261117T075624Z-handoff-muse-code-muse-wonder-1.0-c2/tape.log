=== test/pi-tree.test.mjs ===
// mvp.5 Pi proof: a real root -> node-worker -> edge-worker
// process tree. Workers are real OS processes claiming real
// bp3 links; death is checked on the process table
// (kill(pid, 0)), never inferred from node state alone.
// Cases: terminal bubble exactly once with facts only,
// whole tree dead after the bubble, unreaped grandchild
// dispositioned via parent_run_id + watch, fresh-tree
// revival after resume, root-session death revived from
// bp3 rollup + inbox by a new root process.
import { execFileSync, spawn } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

const repoRoot = fileURLToPath(new URL("..", import.meta.url));
const qBin = path.join(repoRoot, "_build", "default", "src", "quest", "main.exe");
let failures = 0;
function assert(cond, msg) {
  if (!cond) { console.error("FAIL: " + msg); failures++; }
}
function alive(pid) {
  try { process.kill(pid, 0); return true; } catch { return false; }
}
async function waitDead(pid, ms = 5000) {
  const end = Date.now() + ms;
  while (Date.now() < end) {
    if (!alive(pid)) return true;
    await new Promise((r) => setTimeout(r, 50));
  }
  return !alive(pid);
}

const work = fs.mkdtempSync(path.join(os.tmpdir(), "bp3-pi-tree-"));
const repo = path.join(work, "repo");
fs.mkdirSync(path.join(repo, "bin"), { recursive: true });
fs.mkdirSync(path.join(repo, "plans"), { recursive: true });
fs.copyFileSync(path.join(repoRoot, "bin", "bp3"), path.join(repo, "bin", "bp3"));
fs.copyFileSync(qBin, path.join(repo, "q-bin"));
for (const f of fs.readdirSync(path.join(repoRoot, "plans"))) {
  if (f.endsWith(".yaml")) fs.copyFileSync(path.join(repoRoot, "plans", f), path.join(repo, "plans", f));
}
execFileSync("git", ["init", "-q", "-b", "master", repo]);
execFileSync("git", ["-C", repo, "config", "user.email", "t@t.t"]);
execFileSync("git", ["-C", repo, "config", "user.name", "t"]);
fs.writeFileSync(path.join(repo, "a.txt"), "base\n");
fs.writeFileSync(path.join(repo, ".gitignore"), ".bp3-context.json\n");
execFileSync("git", ["-C", repo, "add", "."]);
execFileSync("git", ["-C", repo, "commit", "-qm", "base"]);

const env = { ...process.env, BP3_HARNESS: "muse-code", BP3_MODEL: "test-model", BP3_Q_BIN: path.join(repo, "q-bin") };
function bp3(args, extraEnv = {}) {
  const out = execFileSync(path.join(repo, "bin", "bp3"), args, { cwd: repo, encoding: "utf8", env: { ...env, ...extraEnv } });
  return JSON.parse(out.trim().split("\n").pop() ?? "{}");
}
function bp3Fail(args, extraEnv = {}) {
  try {
    execFileSync(path.join(repo, "bin", "bp3"), args, { cwd: repo, encoding: "utf8", env: { ...env, ...extraEnv } });
    return null;
  } catch (e) {
    return JSON.parse((e.stdout ?? "").trim().split("\n").pop() ?? "{}");
  }
}
const commonDir = execFileSync("git", ["-C", repo, "rev-parse", "--git-common-dir"], { encoding: "utf8" }).trim();
const runsDir = path.join(path.isAbsolute(commonDir) ? commonDir : path.join(repo, commonDir), "bp3", "runs");
function runCfg(runId) {
  return JSON.parse(fs.readFileSync(path.join(runsDir, runId + ".json"), "utf8"));
}

// --- worker scripts: real processes, claim first, then work ---
const nodeWorker = path.join(work, "node-worker.mjs");
fs.writeFileSync(nodeWorker, `
import { execFileSync, spawn } from "node:child_process";
import fs from "node:fs";
const [mode, graph, node, token, bubblePath, scratch] = process.argv.slice(2);
const bp3 = (args, extra = {}) => JSON.parse(execFileSync("./bin/bp3", args, { encoding: "utf8", env: { ...process.env, ...extra } }).trim().split("\\n").pop());
bp3(["harness", "link", "claim", token]);
const myCfg = JSON.parse(fs.readFileSync(process.env.BP3_RUN_CFG, "utf8"));
const myRun = myCfg.run_id;
if (mode === "orphan-parent") {
  const minted = bp3(["harness", "link", "mint", "--kind", "edge", "--graph", graph, "--node", node, "--edge", "handoff", "--harness", "pi", "--model", "test-model", "--cycle", "1", "--desk", process.cwd(), "--parent-run-id", myRun]);
  const child = spawn(process.execPath, [process.env.EDGE_WORKER, "sleep", graph, node, minted.token, scratch], { stdio: "ignore", detached: false });
  fs.writeFileSync(scratch, JSON.stringify({ grandchild_pid: child.pid, grandchild_run: minted.run_id, node_run: myRun }));
  process.exit(0); // die without reaping: grandchild is unreaped
}
const minted = bp3(["harness", "link", "mint", "--kind", "edge", "--graph", graph, "--node", node, "--edge", "handoff", "--harness", "pi", "--model", "test-model", "--cycle", "1", "--desk", process.cwd(), "--parent-run-id", myRun]);
const resultFile = scratch + ".edge.json";
const child = spawn(process.execPath, [process.env.EDGE_WORKER, mode, graph, node, minted.token, resultFile], { stdio: "inherit" });
fs.writeFileSync(scratch + ".edge.pid", String(child.pid));
const code = await new Promise((r) => child.once("exit", r));
let edgeResult = null;
try { edgeResult = JSON.parse(fs.readFileSync(resultFile, "utf8")); } catch {}
const chain = [myRun, minted.run_id];
if (edgeResult && edgeResult.ok === false) {
  bp3(["q", graph, "u", node, "block", "--reason", edgeResult.reason]);
  const bubble = { graph, node, state: "blocked", reason: edgeResult.reason, last_edge: "handoff", run_chain: chain, desk: process.cwd(), inbox_key: graph + "/" + node };
  fs.appendFileSync(bubblePath, JSON.stringify(bubble) + "\\n");
  process.exit(0);
}
const after = bp3(["q", graph, "r", node]);
const bubble = { graph, node, state: after.state, reason: null, last_edge: "handoff", run_chain: chain, desk: process.cwd(), inbox_key: graph + "/" + node };
fs.appendFileSync(bubblePath, JSON.stringify(bubble) + "\\n");
process.exit(0);
`);
const edgeWorker = path.join(work, "edge-worker.mjs");
fs.writeFileSync(edgeWorker, `
import { execFileSync } from "node:child_process";
import fs from "node:fs";
const [mode, graph, node, token, resultFile] = process.argv.slice(2);
const bp3 = (args, extra = {}) => JSON.parse(execFileSync("./bin/bp3", args, { encoding: "utf8", env: { ...process.env, ...extra } }).trim().split("\\n").pop());
bp3(["harness", "link", "claim", token]);
if (mode === "sleep") {
  // No parked workers: an edge worker whose parent died exits.
  const iv = setInterval(() => { if (process.ppid === 1) { clearInterval(iv); process.exit(0); } }, 100);
  setTimeout(() => {}, 30000);
}
else if (mode === "block-fail") {
  fs.writeFileSync(resultFile, JSON.stringify({ ok: false, kind: "typed_failure", code: "E_DECISION", reason: "choose storage shape" }));
} else if (mode === "handoff") {
  fs.writeFileSync("a.txt", "fresh tree work\\n");
  execFileSync("git", ["add", "a.txt"]);
  execFileSync("git", ["commit", "-qm", "fresh tree work"]);
  const commit = execFileSync("git", ["rev-parse", "HEAD"], { encoding: "utf8" }).trim();
  bp3(["q", graph, "u", node, "handoff", "--commit", commit, "--reason", "fresh tree work"]);
  fs.writeFileSync(resultFile, JSON.stringify({ ok: true }));
}
`);

function spawnNode(mode, graph, node, bubblePath, scratch) {
  const minted = bp3(["harness", "link", "mint", "--kind", "node", "--graph", graph, "--node", node,
    "--harness", "pi", "--model", "test-model", "--cycle", "1", "--desk", repo]);
  const cfgPath = path.join(runsDir, minted.run_id + ".json");
  const child = spawn(process.execPath, [nodeWorker, mode, graph, node, minted.token, bubblePath, scratch], {
    cwd: repo,
    env: { ...env, BP3_RUN_ID: minted.run_id, BP3_RUN_CFG: cfgPath, EDGE_WORKER: edgeWorker },
    stdio: "inherit",
  });
  return { child, runId: minted.run_id, pid: child.pid };
}
const exitOf = (child) => new Promise((r) => child.once("exit", r));

try {
  bp3(["q", "c", "demo"]);
  bp3(["q", "demo", "c", "pinode"]);

  // --- bubble exactly once, facts only; whole tree dies ---
  const bubblePath = path.join(work, "bubbles.jsonl");
  const scratch = path.join(work, "s1");
  const first = spawnNode("block-fail", "demo", "pinode", bubblePath, scratch);
  assert((await exitOf(first.child)) === 0, "node worker exits 0 on block");
  const bubbles = fs.readFileSync(bubblePath, "utf8").trim().split("\n").map((l) => JSON.parse(l));
  assert(bubbles.length === 1, "exactly one terminal bubble, got " + bubbles.length);
  const b = bubbles[0];
  assert(b.graph === "demo" && b.node === "pinode" && b.state === "blocked" && b.reason === "choose storage shape"
    && b.last_edge === "handoff" && b.inbox_key === "demo/pinode" && typeof b.desk === "string"
    && Array.isArray(b.run_chain) && b.run_chain.length === 2 && !("pid" in b), "bubble carries facts only: " + JSON.stringify(b));
  const edgeCfg = runCfg(b.run_chain[1]);
  assert(edgeCfg.creator.run_id === b.run_chain[0], "edge run hangs off node run via parent_run_id");
  assert(await waitDead(first.pid), "node worker pid dead after bubble");
  const edgePid = Number(fs.readFileSync(scratch + ".edge.pid", "utf8"));
  assert(await waitDead(edgePid), "edge worker pid dead after bubble (process table)");
  let read = bp3(["q", "demo", "r", "pinode"]);
  assert(read.state === "blocked" && read.blocked.reason === "choose storage shape", "node rests blocked");
  let rollup = bp3(["q", "r", "demo"]);
  assert(rollup.inbox.filter((i) => i.exp === "pinode").length === 1, "exactly one inbox entry");

  // --- revival is a fresh tree: new claim/run chain, no reuse ---
  const resumed = bp3(["q", "demo", "u", "pinode", "resume", "--reason", "use localStorage"], { BP3_DECIDER: "human" });
  assert(resumed.ok === true && resumed.state === "todo", "resume revives to todo");
  const second = spawnNode("handoff", "demo", "pinode", bubblePath, path.join(work, "s2"));
  assert((await exitOf(second.child)) === 0, "revived node worker exits 0");
  assert(second.runId !== first.runId && second.pid !== first.pid, "fresh run-id and pid, no reuse");
  const secondCfg = runCfg(second.runId);
  assert(secondCfg.claim.session_id !== runCfg(first.runId).claim.session_id || secondCfg.claim.pid !== runCfg(first.runId).claim.pid, "fresh claim identity");
  read = bp3(["q", "demo", "r", "pinode"]);
  assert(read.state === "handed_off", "fresh tree drives node to handed_off, got " + read.state);

  // --- unreaped grandchild: root follows parent_run_id, watch dispositions ---
  bp3(["q", "demo", "c", "orphanode"]);
  const orphanScratch = path.join(work, "orphan.json");
  const parent = spawnNode("orphan-parent", "demo", "orphanode", bubblePath, orphanScratch);
  assert((await exitOf(parent.child)) === 0, "orphan-parent node worker dies first");
  const orphan = JSON.parse(fs.readFileSync(orphanScratch, "utf8"));
  assert(runCfg(orphan.grandchild_run).creator.run_id === orphan.node_run, "grandchild chain via parent_run_id");
  assert(alive(orphan.grandchild_pid), "grandchild still live before disposition (genuinely unreaped)");
  const tapePath = path.join(work, "grandchild.jsonl");
  fs.writeFileSync(tapePath, JSON.stringify({ type: "message", id: "g1", message: { role: "user", content: "work" } }) + "\n");
  bp3(["harness", "bind-tape", "--run-id", orphan.grandchild_run, "--tape-path", tapePath]);
  const verdict = bp3Fail(["harness", "watch", "--run-id", orphan.grandchild_run, "--silence-seconds", "1", "--timeout-seconds", "20", "--grace-seconds", "1"]) ?? {};
  assert(verdict.lifecycle === "orphaned", "watch dispositions grandchild orphaned: " + JSON.stringify(verdict));
  assert(await waitDead(orphan.grandchild_pid), "grandchild dead after disposition; tree dead");

  // --- root dies: a new root process revives from rollup + inbox alone ---
  bp3(["q", "demo", "c", "rootnode"]);
  const rootBubble = path.join(work, "root-bubbles.jsonl");
  const dying = spawnNode("block-fail", "demo", "rootnode", rootBubble, path.join(work, "s3"));
  await exitOf(dying.child);
  const newRoot = path.join(work, "new-root.mjs");
  fs.writeFileSync(newRoot, `
import { execFileSync, spawn } from "node:child_process";
const bp3 = (args, extra = {}) => JSON.parse(execFileSync("./bin/bp3", args, { encoding: "utf8", env: { ...process.env, ...extra } }).trim().split("\\n").pop());
const rollup = bp3(["q", "r", "demo"]);
const hit = rollup.inbox.find((i) => i.exp === "rootnode");
if (!hit || hit.reason !== "choose storage shape") process.exit(2);
bp3(["q", "demo", "u", "rootnode", "resume", "--reason", "use localStorage"], { BP3_DECIDER: "human" });
const minted = bp3(["harness", "link", "mint", "--kind", "node", "--graph", "demo", "--node", "rootnode", "--harness", "pi", "--model", "test-model", "--cycle", "1", "--desk", process.cwd()]);
console.log(JSON.stringify({ run_id: minted.run_id, token: minted.token }));
`);
  const fresh = JSON.parse(execFileSync(process.execPath, [newRoot], { cwd: repo, encoding: "utf8", env }).trim().split("\n").pop());
  assert(fresh.run_id !== dying.runId, "new root mints a fresh node run");
  read = bp3(["q", "demo", "r", "rootnode"]);
  assert(read.state === "todo", "rootnode revived to todo by new root, got " + read.state);
} finally {
  try { fs.rmSync(work, { recursive: true, force: true }); } catch {}
}
if (failures > 0) process.exit(1);
console.log("pi-tree tests: ok");
=== test/blocked.sh ===
#!/usr/bin/env bash
# mvp.5: blocked-fail-fast at the bp3 state layer — failure
# is a state transition, never a waiting process. The node
# read itself carries the decision point (reason,
# checkpoint, since), a stale edge attempt after a block
# refuses naming the current state, dirty work is
# checkpointed only when the tree is dirty at block time,
# and a human resume revives the node for a fresh worker
# that binds a new commit from bp3 reads alone.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/repo/bin" "$work/repo/plans"
cp "$root/bin/bp3" "$work/repo/bin/"
cp "$root/_build/default/src/quest/main.exe" "$work/repo/q-bin"
cp "$root"/plans/*.yaml "$work/repo/plans/"
cd "$work/repo"
git init -q -b master
git config user.email t@t.t; git config user.name t
echo base > a.txt; git add .; git commit -qm base

export BP3_HARNESS=muse-code BP3_MODEL=test-model
q() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q "$@"; }
fail() { echo "FAIL: $*" >&2; exit 1; }
ledger() { git show "bp3/exp/demo/$1:docs/quests/demo/experiments/$1/ledger.jsonl"; }

q c demo >/dev/null

# --- cap escalation: the decision point rests on the node read ---
q demo c cap-exp >/dev/null
echo work > w.txt; git add w.txt; git commit -qm work
W=$(git rev-parse HEAD)
q demo u cap-exp handoff --commit "$W" --reason work >/dev/null
out=$(q demo u cap-exp grade --verdict needs_fix --reason "choose storage shape")
echo "$out" | jq -e '.ok == true and .state == "blocked" and .human_action_required == true' >/dev/null || fail "cap blocks: $out"
out=$(q demo r cap-exp)
echo "$out" | jq -e '.state == "blocked" and .blocked.reason == "choose storage shape" and (.blocked | has("checkpoint")) and (.blocked.since | test("^20")) and (.legal_edges == ["resume", "delete"])' >/dev/null || fail "blocked node read carries decision point: $out"
out=$(q r demo)
echo "$out" | jq -e '([.inbox[] | select(.exp == "cap-exp")] | length == 1) and (.inbox[] | select(.exp == "cap-exp") | .reason == "choose storage shape")' >/dev/null || fail "exactly one inbox entry: $out"

# --- stale worker after block: refused with current state, nothing ledgered ---
before=$(ledger cap-exp | wc -l)
if out=$(q demo u cap-exp handoff --commit "$W" --reason "stale retry" 2>&1); then fail "stale handoff after block accepted"; fi
echo "$out" | jq -e '.ok == false and .error.code == "E_ILLEGAL_EDGE" and .error.facts.state == "blocked" and (.error.facts.legal_edges == ["resume", "delete"]) and (.error.guidance | length > 0)' >/dev/null || fail "stale refusal names current state: $out"
[ "$(ledger cap-exp | wc -l)" = "$before" ] || fail "stale refusal ledgered"

# --- revival is fresh: human resume, then a new commit binds from reads alone ---
out=$(BP3_DECIDER=human q demo u cap-exp resume --reason "use localStorage")
echo "$out" | jq -e '.ok == true and .state == "todo" and .cycle == 2' >/dev/null || fail "resume revives: $out"
out=$(q demo r cap-exp)
echo "$out" | jq -e '.state == "todo" and .blocked == null and (.legal_edges | index("handoff") != null)' >/dev/null || fail "revived read is clean todo: $out"
echo more > w.txt; git add w.txt; git commit -qm more
W2=$(git rev-parse HEAD)
out=$(q demo u cap-exp handoff --commit "$W2" --reason "fresh worker")
echo "$out" | jq -e '.ok == true and .state == "handed_off" and .cycle == 2' >/dev/null || fail "fresh handoff after resume: $out"

# --- checkpoint only when the human needs the diff: clean block has none ---
q demo c clean-exp >/dev/null
out=$(q demo u clean-exp block --reason "pick a name")
echo "$out" | jq -e '.ok == true and .state == "blocked" and .human_action_required == true' >/dev/null || fail "clean block: $out"
out=$(q demo r clean-exp)
echo "$out" | jq -e '.blocked.reason == "pick a name" and .blocked.checkpoint == null' >/dev/null || fail "clean block carries no checkpoint: $out"
if out=$(q demo u clean-exp resume --reason "named" 2>&1); then fail "resume without human accepted"; fi
echo "$out" | jq -e '.ok == false and .error.code == "E_HUMAN_REQUIRED"' >/dev/null || fail "resume human gate: $out"

# --- dirty block checkpoints the exact work the human must see ---
q demo c dirty-exp >/dev/null
echo wip > wip.txt
out=$(q demo u dirty-exp block --reason "review this diff")
echo "$out" | jq -e '.ok == true and .state == "blocked"' >/dev/null || fail "dirty block: $out"
ckpt=$(q demo r dirty-exp | jq -r '.blocked.checkpoint')
[ -n "$ckpt" ] && [ "$ckpt" != "null" ] || fail "dirty block checkpoint missing"
[ "$(git cat-file -t "$ckpt")" = "commit" ] || fail "checkpoint is not a commit: $ckpt"
rm wip.txt

# --- siblings continue: a blocked node starves only its dependents ---
q c blast >/dev/null
q blast c bx >/dev/null; q blast c by --depends-on bx >/dev/null; q blast c bw >/dev/null
q blast u bx block --reason "decide" >/dev/null
out=$(q r blast)
echo "$out" | jq -e '.ready == ["bw"] and .starved == [{"blocked": "bx", "starved": ["by"]}]' >/dev/null || fail "siblings continue, dependents starve: $out"

echo "blocked tests: ok"
=== induct-node.js ===
// induct-node: one workflow run per ready node, owning the
// node's whole FSM loop (mvp.3). The root worker reads the
// rollup ready set and dispatches one induct-node run per
// ready node, in parallel desks; this run loops one node:
// read state, mint one edge link, spawn one edge worker,
// bind its tape, re-read, until the node rests landed,
// blocked, or deleted, then returns exactly one terminal
// outcome {node, outcome, commit, run_ids, refusals} to
// the root. Landing stays serial at the root: this loop
// takes the land edge only for its own node, one node per
// run, and bp3 re-checks mergeability against the new tip.
// The old node-loop / induct-grade / quest-land steps are
// phases inside this loop (author, grade+verify, land).
// Pi form of the same contract: the root pi session spawns
// one node-worker session per ready node; that session
// claims its node link first, loops spawn_run per edge,
// and returns the same one terminal outcome. Edge workers
// never mint links and never call a second edge.
// Fail-fast (mvp.5): failure is a state transition, never a
// waiting process. An edge worker completes its edge,
// returns a typed failure, or dies. A typed failure makes
// this loop record the decision point through the block
// edge once — with the failure's reason verbatim — and
// exit; it never retries the failed edge, parks, polls
// for the human, or pages anyone (paging is the root
// worker's job, off the blocked bubble). A worker that
// dies with no parseable verdict is an orphaned Run: the
// node is not blocked, and the next loop iteration mints
// one fresh link and dispatches one replacement. The
// terminal bubble carries facts only — graph, node,
// state, reason, last edge, claim/run chain, desk, and
// inbox key — so revival after resume is a fresh run
// that re-reads bp3; no pid or session is ever resumed.
// Args: {quest, exp, ts, harness, model, desk}.

function textOf(result) {
  if (typeof result === "string") return result;
  if (!result || typeof result !== "object") return "";
  if (typeof result.output === "string") return result.output;
  if (typeof result.text === "string") return result.text;
  if (typeof result.content === "string") return result.content;
  try {
    return JSON.stringify(result);
  } catch (e) {
    return "";
  }
}

function parseVerdict(result) {
  const text = textOf(result);
  if (!text) return null;
  try {
    return JSON.parse(text);
  } catch (e) {
    // fall through to embedded-JSON extraction
  }
  const start = text.indexOf("{");
  const end = text.lastIndexOf("}");
  if (start >= 0 && end > start) {
    try {
      return JSON.parse(text.slice(start, end + 1));
    } catch (e) {
      return null;
    }
  }
  return null;
}

function errorText(result) {
  const v = parseVerdict(result);
  if (v && v.error && v.error.code) {
    const facts = v.error.facts ? JSON.stringify(v.error.facts) : "";
    return v.error.code + (facts ? " " + facts : "");
  }
  const text = textOf(result).trim();
  return text ? text.slice(0, 500) : "no verdict returned";
}

export default async function workflow(host) {
  const rawArgs = typeof host.args === "string"
    ? JSON.parse(host.args)
    : (host.args || {});
  const quest = rawArgs.quest;
  const exp = rawArgs.exp;
  const ts = rawArgs.ts;
  const harness = rawArgs.harness || "muse-code";
  const model = rawArgs.model || "unknown";
  const desk = rawArgs.desk ? String(rawArgs.desk) : "";
  const envPrefix =
    "BP3_HARNESS=" + harness + " BP3_MODEL=" + model + " ";
  const deskNote = desk ? ("Your working directory is the quest worktree `" + desk + "` - cd there first and run every command from there; do not work in the conductor checkout. ") : "";
  const refusals = [];
  const runIds = [];
  if (!quest || !exp || !ts) {
    return {
      node: exp || null, outcome: "refused", commit: null,
      run_ids: runIds,
      refusals: ["missing quest, exp, or ts in workflow args"],
    };
  }

  const expDir =
    "docs/quests/" + quest + "/experiments/" + exp;

  async function readState() {
    const result = await host.agent({
      label: "read " + exp,
      input:
        "Run exactly `" + envPrefix + "./bin/bp3 q " + quest + " r " + exp +
        "` from the quest worktree if one is named below, else the repository root, and return only its stdout JSON " +
        "verdict verbatim as your entire reply, with no prose and no " +
        "code fences. If the command fails, return its stdout JSON " +
        "verdict verbatim instead. Do not edit any file and do not " +
        "call any `bp3 q u` update edge.",
    });
    const v = parseVerdict(result);
    if (!v || typeof v.state !== "string") {
      return {
        state: "unknown",
        commit: null,
        cycle: 0,
        legal_edges: [],
        reason: null,
        raw: textOf(result),
      };
    }
    return {
      state: v.state,
      commit: v.commit === undefined ? null : v.commit,
      cycle: typeof v.cycle === "number" ? v.cycle : 0,
      legal_edges: Array.isArray(v.legal_edges) ? v.legal_edges : [],
      // The recorded decision point (mvp.5): present on a
      // blocked node's own read, so a fresh worker — or a
      // revived root — reconstructs why it stopped from
      // bp3 alone.
      reason: (v.blocked && typeof v.blocked.reason === "string" && v.blocked.reason)
        ? v.blocked.reason
        : (typeof v.blocked_reason === "string" && v.blocked_reason ? v.blocked_reason : null),
      raw: textOf(result),
    };
  }

  const links = {};

  function runIdOf(edge, cycle) {
    if (links[edge] && links[edge].run_id) return links[edge].run_id;
    return ts + "-" + edge + "-" + harness + "-" + model +
      "-c" + String(cycle);
  }

  function envPreset() {
    return "BP3_QUEST=" + quest + " BP3_EXP=" + exp + " " + envPrefix;
  }

  function claimNote(edge) {
    const link = links[edge];
    if (!link) return "";
    return (
      "Your first action claims your one-time link: run `" +
      envPrefix + "./bin/bp3 harness link claim " + link.token +
      "` and note the run_id it returns (expected " + link.run_id +
      "). Prefix your state-edge call below with " +
      "BP3_RUN_ID=<that run_id>. "
    );
  }

  // The link minter (mvp.1): this loop, before each edge
  // worker spawns. A refused mint means that worker never
  // starts. The mint names no tape; the launcher binds the
  // worker's session tape after it returns (bindTape).
  async function mintLink(edge, cycle) {
    const cmd =
      envPreset() + "./bin/bp3 harness link mint" +
      " --kind edge --edge " + edge +
      " --graph " + quest + " --node " + exp +
      " --harness " + harness + " --model " + model +
      " --cycle " + String(cycle) +
      (desk ? " --desk " + desk : "");
    const result = await host.agent({
      label: "mint " + exp,
      input:
        deskNote +
        "Run exactly `" + cmd + "` from the quest worktree if " +
        "one is named above, else the repository root, and return " +
        "only its stdout JSON verdict verbatim as your entire " +
        "reply, with no prose and no code fences. If the command " +
        "fails, return its stdout JSON verdict verbatim instead. " +
        "Do not edit any file and do not call any `bp3 q u` " +
        "update edge.",
    });
    const v = parseVerdict(result);
    if (!v || v.ok !== true || typeof v.token !== "string" || typeof v.run_id !== "string") {
      refusals.push(
        "link mint refused before the " + edge + " child: " +
        errorText(result)
      );
      return false;
    }
    links[edge] = { token: v.token, run_id: v.run_id };
    runIds.push(v.run_id);
    return true;
  }

  // The named tape binder (followup.3): after the edge
  // worker returns, resolution is mechanical (find-tape on
  // the run-id) and the bind is bind-tape's one row.
  async function bindTape(edge, cycle) {
    const runId = runIdOf(edge, cycle);
    const resolveCmd =
      envPreset() + "./bin/bp3 harness find-tape" +
      " --run-id " + runId;
    const resolved = await host.agent({
      label: "resolve " + exp,
      input:
        deskNote +
        "Run exactly `" + resolveCmd + "` from the quest worktree if " +
        "one is named above, else the repository root, and return " +
        "only its stdout JSON verdict verbatim as your entire " +
        "reply, with no prose and no code fences. If the command " +
        "fails, return its stdout JSON verdict verbatim instead. " +
        "Do not edit any file and do not call any `bp3 q u` " +
        "update edge.",
    });
    const rv = parseVerdict(resolved);
    const tapePath = rv && rv.ok === true
      ? (typeof rv.tape_path === "string" && rv.tape_path
         ? rv.tape_path
         : (typeof rv.wal === "string" ? rv.wal : ""))
      : "";
    if (!tapePath) {
      refusals.push(
        "bind-tape resolution refused after the " + edge + " child: " +
        errorText(resolved)
      );
      return false;
    }
    const bindCmd =
      envPreset() + "./bin/bp3 harness bind-tape" +
      " --run-id " + runId + " --tape-path " + tapePath;
    const bound = await host.agent({
      label: "bind " + exp,
      input:
        deskNote +
        "Run exactly `" + bindCmd + "` from the quest worktree if " +
        "one is named above, else the repository root, and return " +
        "only its stdout JSON verdict verbatim as your entire " +
        "reply, with no prose and no code fences. If the command " +
        "fails, return its stdout JSON verdict verbatim instead. " +
        "Do not edit any file and do not call any `bp3 q u` " +
        "update edge.",
    });
    const bv = parseVerdict(bound);
    if (!bv || bv.ok !== true) {
      refusals.push(
        "bind-tape refused after the " + edge + " child: " +
        errorText(bound)
      );
      return false;
    }
    return true;
  }

  // Fail-fast classification (mvp.5). Three shapes come
  // back from an edge worker: a verdict was cast (bp3
  // state moved, or will be seen moved on re-read), a
  // typed failure (a parseable refusal — the child's own
  // ok:false, or the bp3 verdict it relayed), or silence
  // (no parseable verdict at all: the worker died, and
  // its Run is derived orphaned by the supervisor fold).
  function classify(v) {
    if (!v) return { kind: "orphaned" };
    const inner = (v.verdict && typeof v.verdict === "object") ? v.verdict : null;
    if (v.ok === false || (inner && inner.ok === false)) {
      return { kind: "typed", reason: failureReason(v, inner) };
    }
    return { kind: "cast" };
  }

  function failureReason(v, inner) {
    if (typeof v.reason === "string" && v.reason) return v.reason;
    const err = (inner && inner.error) || v.error || null;
    if (err) {
      if (typeof err.guidance === "string" && err.guidance) return err.guidance;
      if (typeof err.code === "string" && err.code) return err.code;
    }
    return "edge worker returned a typed failure with no reason";
  }

  // The one terminal bubble (mvp.5): facts only, never a
  // live handle. The root worker pages the human off a
  // blocked bubble's reason and inbox key, and revives
  // the node after resume by minting a fresh node link —
  // nothing here is resumed in place.
  function bubble(state, commit, reason, lastEdge) {
    return {
      graph: quest,
      node: exp,
      outcome: state,
      commit: commit === undefined ? null : commit,
      reason: reason || null,
      last_edge: lastEdge || null,
      run_ids: runIds,
      desk: desk || null,
      inbox_key: quest + "/" + exp,
      refusals,
    };
  }

  // The block edge is this loop's own call (mvp.5), taken
  // exactly once for a typed failure, after the failed
  // worker's tape bind above has reaped its Run: every
  // edge Run this loop spawned is terminal in bp3 before
  // the node worker exits on blocked. The reason rides
  // verbatim; dirty work is checkpointed by bp3 only
  // when the tree is dirty at this moment.
  async function callBlock(reason) {
    const safe = String(reason).replace(/(["$`\\])/g, "\\$1");
    const cmd =
      envPreset() + "./bin/bp3 q " + quest + " u " + exp +
      " block --reason \"" + safe + "\"";
    const result = await host.agent({
      label: "block " + exp,
      input:
        deskNote +
        "Run exactly `" + cmd + "` from the quest worktree if " +
        "one is named above, else the repository root, and return " +
        "only its stdout JSON verdict verbatim as your entire " +
        "reply, with no prose and no code fences. If the command " +
        "fails, return its stdout JSON verdict verbatim instead. " +
        "Do not edit any file.",
    });
    return parseVerdict(result);
  }

  // Record the decision point and exit: one block call,
  // one re-read, one blocked bubble. A block refused
  // because the node already rests blocked (a race with
  // the cycle cap) still exits blocked — the re-read is
  // the judge, never this loop's memory.
  async function blockAndExit(reason, lastEdge, commit) {
    const bv = await callBlock(reason);
    const after = await readState();
    if (after.state === "blocked") {
      return bubble("blocked", after.commit, after.reason || reason, lastEdge);
    }
    if (bv && bv.ok === true && typeof bv.state === "string") {
      return bubble(bv.state, commit, reason, lastEdge);
    }
    refusals.push(
      "block refused after " + lastEdge + " failure: " +
      (bv ? errorText(JSON.stringify(bv)) : "no verdict returned") +
      "; re-read shows " + after.state
    );
    return {
      node: exp, outcome: "refused",
      commit: after.commit === undefined ? null : after.commit,
      run_ids: runIds, refusals,
    };
  }

  function tapePreamble(edge, cycle) {
    const folder = expDir + "/runs/" + runIdOf(edge, cycle);
    return (
      "Your run folder is `" + folder + "` under `" + expDir +
      "/runs/`. " + claimNote(edge) +
      "`BP3_QUEST`, `BP3_EXP`, `BP3_HARNESS`, and `BP3_MODEL` " +
      "arrive via environment; your run-id arrives via the " +
      "claim above and `bp3` stamps it into its verdicts and " +
      "ledger lines. First check whether that concrete run " +
      "folder already exists: if it does, stop immediately, do " +
      "not overwrite or reuse it, and return a JSON object " +
      '{"ok":false,"error":{"code":"E_RUN_EXISTS"}} describing ' +
      "the collision. Run-id folders must fail if they already " +
      "exist. Otherwise create the folder, then tee all of your " +
      "session output into its tape.log for the rest of the run: " +
      "run your shell work so stdout and stderr are appended " +
      "through `tee -a <run-folder>/tape.log` (for example " +
      "`exec > >(tee -a <run-folder>/tape.log) 2>&1` in bash, " +
      "or pipe each command through `tee -a`). The tape is " +
      "verbatim evidence only; never parse tape text into facts. " +
      "Write `<run-folder>/notes.md` with brief authored lessons " +
      "from the run before you finish. Record the concrete run " +
      "folder name as run_id in your reply JSON."
    );
  }

  const authorLoad =
    "First load the code-writer skill (read_skill \"code-writer\") " +
    "and follow its procedure, including naming discipline and " +
    "its language references. ";

  async function spawnEdge(edge, state, fix) {
    if (!(await mintLink(edge, state.cycle))) return null;
    let input;
    if (edge === "handoff") {
      input =
        deskNote + "You are the author child for exp `" + exp + "` of quest `" +
        quest + "`, currently in state `todo` at cycle " +
        String(state.cycle) + ". " + authorLoad + tapePreamble(edge, state.cycle) +
        (fix ? " The grader named this fix; carry it verbatim: " + fix : "") +
        " Do the exp's work in the repository, then commit the " +
        "work as a clean git commit and note its full sha. Then " +
        "call the state edge directly yourself: " +
        "`" + envPreset() + "./bin/bp3 q " + quest + " u " + exp +
        " handoff --commit <your-commit-sha> --reason \"<short reason>\"`. " +
        "Children call `bp3 q u` directly; never only return a " +
        "verdict for the parent to relay. Reply with only a JSON " +
        "object {ok, run_id, commit, verdict} where verdict is " +
        "the JSON printed by the handoff call.";
    } else if (edge === "grade" || edge === "verify") {
      const verdicts = edge === "grade" ? "ship|needs_fix" : "pass|fail";
      input =
        deskNote + "You are the " + edge + " child for exp `" + exp + "` of quest `" +
        quest + "`, currently in state `handed_off` at cycle " +
        String(state.cycle) + ". " + tapePreamble(edge, state.cycle) +
        " Judge the exact bound commit " + String(state.commit) +
        "; never edit the work. Then call the state edge directly yourself: " +
        "`" + envPreset() + "./bin/bp3 q " + quest + " u " + exp + " " + edge +
        " --verdict " + verdicts + " --reason \"<short reason>\"`. " +
        "Reply with only a JSON object {ok, run_id, commit, verdict, reason} " +
        "where verdict is the JSON printed by the " + edge + " call and " +
        "reason carries any named fix verbatim.";
    } else {
      input =
        deskNote + "You are the land child for exp `" + exp + "` of quest `" +
        quest + "`, currently in state `approved` at cycle " +
        String(state.cycle) + ". " + tapePreamble(edge, state.cycle) +
        " Call the state edge directly yourself: " +
        "`" + envPreset() + "./bin/bp3 q " + quest + " u " + exp +
        " land --reason \"<short reason>\"`. " +
        "Reply with only a JSON object {ok, run_id, commit, verdict} " +
        "where verdict is the JSON printed by the land call.";
    }
    const result = await host.agent({ label: edge + " " + exp, input });
    const v = parseVerdict(result);
    if (v && typeof v.run_id === "string" && v.run_id) runIds.push(v.run_id);
    await bindTape(edge, state.cycle);
    return v;
  }

  // The FSM loop: one edge worker per iteration, re-reading
  // bp3 after every verdict; this run holds no state of its
  // own across edges. Terminal means landed, blocked, or
  // deleted, and exactly one such bubble returns. Fail-fast
  // (mvp.5): a typed failure blocks at once through this
  // loop's own block call; an orphaned worker is replaced
  // by the next iteration's fresh link; neither path ever
  // waits on a human inside this run.
  let fix = "";
  let lastEdge = null;
  for (let step = 0; step < 12; step++) {
    const state = await readState();
    if (state.state === "unknown") {
      refusals.push("read failed: " + (state.raw || "no verdict"));
      return { node: exp, outcome: "refused", commit: null, run_ids: runIds, refusals };
    }
    if (state.state === "landed" || state.state === "blocked" || state.state === "deleted") {
      return bubble(state.state, state.commit,
        state.state === "blocked" ? (state.reason || fix) : null, lastEdge);
    }
    if (state.state === "todo") {
      lastEdge = "handoff";
      const r = await spawnEdge("handoff", state, fix);
      fix = "";
      const c = classify(r);
      if (c.kind === "typed") return blockAndExit(c.reason, "handoff", state.commit);
      if (c.kind === "orphaned") {
        refusals.push(
          "handoff worker orphaned (no verdict); next loop mints a replacement link");
      }
    } else if (state.state === "handed_off") {
      lastEdge = "grade";
      const g = await spawnEdge("grade", state, "");
      const gc = classify(g);
      if (gc.kind === "typed") return blockAndExit(gc.reason, "grade", state.commit);
      if (gc.kind === "orphaned") {
        refusals.push(
          "grade worker orphaned (no verdict); next loop mints a replacement link");
        continue;
      }
      const mid = await readState();
      if (mid.state === "handed_off") {
        lastEdge = "verify";
        const vf = await spawnEdge("verify", mid, "");
        const vc = classify(vf);
        if (vc.kind === "typed") return blockAndExit(vc.reason, "verify", mid.commit);
        if (vc.kind === "orphaned") {
          refusals.push(
            "verify worker orphaned (no verdict); next loop mints a replacement link");
        }
      } else if (g && typeof g.reason === "string" && g.reason) {
        // needs_fix below the cap rides the next author
        // cycle verbatim; at the cap the same words are
        // the recorded blocked reason.
        fix = g.reason;
      }
    } else if (state.state === "approved") {
      lastEdge = "land";
      const r = await spawnEdge("land", state, "");
      const c = classify(r);
      if (c.kind === "typed") return blockAndExit(c.reason, "land", state.commit);
      if (c.kind === "orphaned") {
        refusals.push(
          "land worker orphaned (no verdict); next loop mints a replacement link");
      }
    } else {
      refusals.push("no phase owns state " + state.state);
      return { node: exp, outcome: "refused", commit: state.commit, run_ids: runIds, refusals };
    }
  }
  refusals.push("FSM loop exceeded 12 edge dispatches without a terminal state");
  const last = await readState();
  return {
    node: exp, outcome: "refused",
    commit: last.commit === undefined ? null : last.commit,
    run_ids: runIds, refusals,
  };
}
