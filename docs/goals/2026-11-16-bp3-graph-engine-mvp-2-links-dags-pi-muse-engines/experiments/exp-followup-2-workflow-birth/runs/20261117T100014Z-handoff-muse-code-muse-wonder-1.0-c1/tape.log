    "depth": 2,
    "harness": "pi", "model": "...", "thinking": "high",
    "minted_at": "...", "token_hash": "sha256:..."
  },
  "claim": {                         // worker side, known at claim
    "session_id": "...", "pid": 48151, "cwd": "...",
