.PHONY: check test lint release publish install

# This host's default MacOSX27.2 SDK ships a libpthread.tbd the linker
# cannot parse ("unknown architecture"); the 26.5 SDK links cleanly.
# Use it when present; harmless elsewhere.
MAC_SDK := $(shell if [ -d /Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk ]; then echo /Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk; fi)
DUNE_BUILD = $(if $(MAC_SDK),SDKROOT=$(MAC_SDK) ,)dune build$(if $(findstring /.bp3/worktrees/,$(CURDIR)), --root=.,)

check: lint
	./scripts/check-skills skills .pi/skills .agents/skills .claude/skills
	./test/skills.sh
	$(DUNE_BUILD) src/quest/main.exe
	./test/q.sh
	./test/harness.sh
	./test/config.sh
	./test/link.sh
	./test/context.sh
	node --test extensions/bp3-pi/test/bp3-pi.test.mjs
	./test/worktree.sh
	./test/tape.sh
	./test/hooks.sh
	./test/traverse.sh
	./test/completion.sh
	./test/release.sh
	./test/install.sh

lint:
	shellcheck bin/bp3 scripts/check-skills test/skills.sh test/q.sh test/harness.sh test/config.sh test/link.sh test/context.sh test/worktree.sh test/tape.sh test/hooks.sh test/traverse.sh test/completion.sh test/release.sh test/install.sh completions/bp3.bash scripts/release-check scripts/install-bp3.sh scripts/bp3-shim scripts/release-publish
	node --check skills/traverse/workflows/node-loop.js
	node --check skills/traverse/workflows/induct-grade.js
	node --check skills/traverse/workflows/quest-land.js

test:
	./test/skills.sh

# --- release (Exp 5): tag-gated artifact + checksum; publish-once via gh ---
RELEASE_VERSION := $(shell sed -n 's/.*bp3_version = "\(.*\)".*/\1/p' src/quest/gitx.ml | head -1)
RELEASE_OS := $(shell uname -s | tr '[:upper:]' '[:lower:]')
RELEASE_ARCH := $(shell uname -m)
RELEASE_ARTIFACT := dist/bp3-q-v$(RELEASE_VERSION)-$(RELEASE_OS)-$(RELEASE_ARCH)

release:
	@./scripts/release-check >/dev/null
	$(DUNE_BUILD) src/quest/main.exe
	mkdir -p dist
	cp _build/default/src/quest/main.exe $(RELEASE_ARTIFACT)
	cd dist && shasum -a 256 $$(basename $(RELEASE_ARTIFACT)) > $$(basename $(RELEASE_ARTIFACT)).sha256
	@echo "released $(RELEASE_ARTIFACT)"

publish: release
	./scripts/release-publish $(RELEASE_ARTIFACT) $(RELEASE_ARTIFACT).sha256

PREFIX ?= $(HOME)/.local
install:
	PREFIX="$(PREFIX)" ./scripts/install-bp3.sh
ls: .agents/skills/traverse/workflows/: No such file or directory
skills/traverse/workflows/:
induct-grade.js
node-loop.js
quest-land.js
---
// node-loop: build one todo exp, then stop. Installed to
// .agents/workflows/node-loop.js by `bp3 skills install`.
// This step owns exactly one transition family: it reads state,
// spawns the single author child for a `todo` exp, re-reads, and
// returns what the re-read reports. Any other state belongs to
// a different step; this file refuses it untouched. All state
// moves through `bp3 q u`, called directly by the author child;
// this script never writes state. Its one write is proof, not
// state: as the link minter (mvp.1) it mints a one-time link via
// `bp3 harness link mint` before the child spawns; the
// child's first action claims it, and the claim binds
// session to run-id. As the named tape binder it then
// binds the child's session tape via `bp3 harness
// bind-tape` after the child returns.
// Args are supplied by the calling traverse skill as {quest, exp,
// ts, harness, model}; ts is a UTC compact timestamp from the
// caller, embedded by the child in its run-id because scripts
// cannot read the clock.

function textOf(result) {
  if (typeof result === "string") return result;
  if (!result || typeof result !== "object") return "";
  if (typeof result.output === "string") return result.output;
  if (typeof result.text === "string") return result.text;
  if (typeof result.content === "string") return result.content;
  try {
    return JSON.stringify(result);
  } catch (e) {
    return "";
  }
}

function parseVerdict(result) {
  const text = textOf(result);
  if (!text) return null;
  try {
    return JSON.parse(text);
  } catch (e) {
    // fall through to embedded-JSON extraction
  }
  const start = text.indexOf("{");
  const end = text.lastIndexOf("}");
  if (start >= 0 && end > start) {
    try {
      return JSON.parse(text.slice(start, end + 1));
    } catch (e) {
      return null;
    }
  }
  return null;
}

function errorText(result) {
  const v = parseVerdict(result);
  if (v && v.error && v.error.code) {
    const facts = v.error.facts ? JSON.stringify(v.error.facts) : "";
    return v.error.code + (facts ? " " + facts : "");
  }
  const text = textOf(result).trim();
  return text ? text.slice(0, 500) : "no verdict returned";
}

export default async function workflow(host) {
  const rawArgs = typeof host.args === "string"
    ? JSON.parse(host.args)
    : (host.args || {});
  const quest = rawArgs.quest;
  const exp = rawArgs.exp;
  const ts = rawArgs.ts;
  const harness = rawArgs.harness || "muse-code";
  const model = rawArgs.model || "unknown";
  const desk = rawArgs.desk ? String(rawArgs.desk) : "";
  const envPrefix =
    "BP3_HARNESS=" + harness + " BP3_MODEL=" + model + " ";
  const deskNote = desk ? ("Your working directory is the quest worktree `" + desk + "` - cd there first and run every command from there; do not work in the conductor checkout. ") : "";
  const authorLoad =
    "First load the code-writer skill (read_skill \"code-writer\") " +
    "and follow its procedure, including naming discipline and " +
    "its language references. ";
  const refusals = [];
  const runIds = [];
  if (!quest || !exp || !ts) {
    return {
      exp: exp || null,
      outcome: "refused",
      commit: null,
      run_ids: runIds,
      refusals: ["missing quest, exp, or ts in workflow args"],
    };
  }

  const expDir =
    "docs/quests/" + quest + "/experiments/" + exp;

  async function readState() {
    const result = await host.agent({
      label: "read " + exp,
      input:
        "Run exactly `" + envPrefix + "./bin/bp3 q " + quest + " r " + exp +
        "` from the quest worktree if one is named below, else the repository root, and return only its stdout JSON " +
        "verdict verbatim as your entire reply, with no prose and no " +
        "code fences. If the command fails, return its stdout JSON " +
        "verdict verbatim instead. Do not edit any file and do not " +
        "call any `bp3 q u` update edge.",
    });
    const v = parseVerdict(result);
    if (!v || typeof v.state !== "string") {
      return {
        state: "unknown",
        commit: null,
        cycle: 0,
        legal_edges: [],
        raw: textOf(result),
      };
    }
    return {
      state: v.state,
      commit: v.commit === undefined ? null : v.commit,
      cycle: typeof v.cycle === "number" ? v.cycle : 0,
      legal_edges: Array.isArray(v.legal_edges) ? v.legal_edges : [],
---QSH---
#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/repo/bin" "$work/repo/plans"
cp "$root/bin/bp3" "$work/repo/bin/"
cp "$root/_build/default/src/quest/main.exe" "$work/repo/q-bin"
cp "$root"/plans/*.yaml "$work/repo/plans/"
cd "$work/repo"
git init -q -b master
git config user.email t@t.t; git config user.name t
echo base > a.txt; git add .; git commit -qm base

export BP3_HARNESS=muse-code BP3_MODEL=test-model
q() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q "$@"; }
quest_alias() { BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 quest "$@"; }

fail() { echo "FAIL: $*" >&2; exit 1; }

# --- create / read verdict shapes, both spellings ---
out=$(q c demo)
echo "$out" | jq -e '.ok == true and .quest == "demo" and .state == "proposed"' >/dev/null || fail "quest create shape: $out"
out=$(q create demo2)
echo "$out" | jq -e '.ok == true and .state == "proposed"' >/dev/null || fail "quest create alias: $out"
out=$(quest_alias r demo)
echo "$out" | jq -e '.ok == true and .quest == "demo" and .state == "proposed" and (.exps | type == "array") and (.inbox | type == "array") and has("rollup")' >/dev/null || fail "quest read shape: $out"
out=$(q r)
echo "$out" | jq -e '.ok == true and (.quests | length >= 2)' >/dev/null || fail "quest list: $out"

out=$(q demo c parser-fix)
echo "$out" | jq -e '.ok == true and .state == "todo" and .cycle == 1' >/dev/null || fail "exp create: $out"
out=$(q demo create parser-fix2)
echo "$out" | jq -e '.ok == true and .state == "todo"' >/dev/null || fail "exp create alias: $out"
out=$(q demo r parser-fix)
echo "$out" | jq -e '.ok == true and .state == "todo"' >/dev/null || fail "exp read: $out"
out=$(q demo read parser-fix)
echo "$out" | jq -e '.ok == true and .state == "todo"' >/dev/null || fail "exp read alias: $out"

# --- strict argv: dup flag, unknown flag, stray positional -> usage before write ---
before=$(git show bp3/exp/demo/parser-fix:docs/quests/demo/experiments/parser-fix/ledger.jsonl | wc -l)
if out=$(q demo u parser-fix handoff --commit abc --reason x --reason y 2>&1); then fail "dup flag accepted"; fi
echo "$out" | jq -e '.ok == false and .error.code == "E_USAGE"' >/dev/null || fail "dup flag code: $out"
if out=$(q demo u parser-fix handoff --commit abc --reason x --bogus y 2>&1); then fail "unknown flag accepted"; fi
echo "$out" | jq -e '.error.code == "E_USAGE"' >/dev/null || fail "unknown flag code: $out"
if out=$(q demo u parser-fix handoff extra --commit abc --reason x 2>&1); then fail "stray positional accepted"; fi
echo "$out" | jq -e '.error.code == "E_USAGE"' >/dev/null || fail "stray code: $out"
after=$(git show bp3/exp/demo/parser-fix:docs/quests/demo/experiments/parser-fix/ledger.jsonl | wc -l)
[ "$before" = "$after" ] || fail "strict argv wrote to ledger"

# --- refusal: land from todo, ledger unchanged ---
if out=$(q demo u parser-fix land --reason "too early" 2>&1); then fail "land from todo accepted"; fi
echo "$out" | jq -e '.ok == false and .error.code == "E_ILLEGAL_EDGE" and .error.facts.state == "todo" and .error.facts.edge == "land" and (.error.facts.legal_edges | index("handoff") != null) and (.error.guidance | length > 0)' >/dev/null || fail "illegal edge facts: $out"
after=$(git show bp3/exp/demo/parser-fix:docs/quests/demo/experiments/parser-fix/ledger.jsonl | wc -l)
[ "$before" = "$after" ] || fail "refusal ledgered"

# --- identity: unset -> unknown + warning; invalid -> fail fast ---
out=$(env -u BP3_HARNESS -u BP3_MODEL BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q demo c id-exp)
echo "$out" | jq -e '.ok == true and (.warnings | index("W_IDENTITY_UNKNOWN") != null)' >/dev/null || fail "identity warning: $out"
git show bp3/exp/demo/id-exp:docs/quests/demo/experiments/id-exp/ledger.jsonl | tail -1 | jq -e '.harness == "unknown" and .model == "unknown" and .bp3_version == "0.2.0"' >/dev/null || fail "identity ledger unknown"
if out=$(BP3_HARNESS=bogus BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q demo r parser-fix 2>&1); then fail "invalid harness accepted"; fi
echo "$out" | jq -e '.error.code == "E_IDENTITY"' >/dev/null || fail "identity code: $out"

# --- run-id: BP3_RUN_ID from env stamps verdict + ledger; unset is absent ---
out=$(BP3_RUN_ID=run-42 BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q c runq)
echo "$out" | jq -e '.ok == true and .run_id == "run-42"' >/dev/null || fail "run-id quest verdict: $out"
out=$(BP3_RUN_ID=run-42 BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q runq c rid-exp)
echo "$out" | jq -e '.ok == true and .run_id == "run-42"' >/dev/null || fail "run-id exp verdict: $out"
git show bp3/exp/runq/rid-exp:docs/quests/runq/experiments/rid-exp/ledger.jsonl | tail -1 | jq -e '.run_id == "run-42" and .harness == "muse-code"' >/dev/null || fail "run-id ledger set"
out=$(BP3_RUN_ID=run-42 BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q runq r rid-exp)
echo "$out" | jq -e '.ok == true and .run_id == "run-42"' >/dev/null || fail "run-id read verdict: $out"
out=$(env -u BP3_RUN_ID BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q runq c rid-unset)
echo "$out" | jq -e '.ok == true and (has("run_id") | not)' >/dev/null || fail "run-id unset verdict: $out"
git show bp3/exp/runq/rid-unset:docs/quests/runq/experiments/rid-unset/ledger.jsonl | tail -1 | jq -e 'has("run_id") | not' >/dev/null || fail "run-id ledger unset"
out=$(env -u BP3_RUN_ID BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q runq r rid-unset)
echo "$out" | jq -e '.ok == true and (has("run_id") | not)' >/dev/null || fail "run-id unset read verdict: $out"
out=$(env -u BP3_HARNESS -u BP3_MODEL -u BP3_RUN_ID BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q runq c rid-unknown)
echo "$out" | jq -e '.ok == true and (has("run_id") | not) and (.warnings | index("W_IDENTITY_UNKNOWN") != null)' >/dev/null || fail "run-id unset identity warning: $out"
git show bp3/exp/runq/rid-unknown:docs/quests/runq/experiments/rid-unknown/ledger.jsonl | tail -1 | jq -e '(has("run_id") | not) and .harness == "unknown"' >/dev/null || fail "run-id unset unknown ledger"

# --- happy path handoff/grade/verify/land (alias spellings mixed) ---
echo work > b.txt; git add b.txt; git commit -qm work
B=$(git rev-parse HEAD)
out=$(q demo u parser-fix handoff --commit "$B" --reason "first cut")
echo "$out" | jq -e '.ok == true and .state == "handed_off" and .cycle == 1' >/dev/null || fail "handoff: $out"
out=$(q demo update parser-fix grade --verdict ship --reason "looks right")
echo "$out" | jq -e '.ok == true and .state == "handed_off"' >/dev/null || fail "grade ship stays handed_off until verify: $out"
out=$(q demo u parser-fix verify --verdict pass --reason "green")
echo "$out" | jq -e '.ok == true and .state == "approved"' >/dev/null || fail "verify pass approves: $out"
out=$(q demo u parser-fix land --reason "ship it")
echo "$out" | jq -e '.ok == true and .state == "landed" and .fin == "exp_fin"' >/dev/null || fail "land: $out"
out=$(q r demo)
echo "$out" | jq -e '.ok == true and (.exps[] | select(.exp == "parser-fix") | .state == "landed" and .fin == "exp_fin")' >/dev/null || fail "read after land: $out"

# --- mig.1 compat: frozen pre-rename ledger folds to new words, file untouched ---
out=$(q demo c compat-exp)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "compat create: $out"
append_ledger_line() { # $1 exp $2 json-line
  local br="bp3/exp/demo/$1" path="docs/quests/demo/experiments/$1/ledger.jsonl" tip idx led blob tree nt
  tip=$(git rev-parse "$br")
  led=$(git show "$br:$path")
  idx=$(mktemp)
  GIT_INDEX_FILE="$idx" git read-tree "$tip"
  blob=$(printf '%s\n%s\n' "$led" "$2" | git hash-object -w --stdin)
  GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,$path"
  tree=$(GIT_INDEX_FILE="$idx" git write-tree)
  nt=$(git commit-tree "$tree" -p "$tip" -m "compat fixture $1")
  git update-ref "refs/heads/$br" "$nt" "$tip"
  rm -f "$idx"
}
compat_tip_before=$(git rev-parse bp3/exp/demo/compat-exp)
append_ledger_line compat-exp "{\"ts\":\"2026-01-01T00:00:00Z\",\"edge\":\"submit\",\"from\":\"todo\",\"to\":\"submitted\",\"cycle\":1,\"commit\":\"$B\",\"verdict\":null,\"reason\":\"frozen\",\"harness\":\"t\",\"model\":\"t\",\"bp3_version\":\"0.2.0\"}"
out=$(q demo r compat-exp)
echo "$out" | jq -e --arg c "$B" '.state == "handed_off" and .cycle == 1 and .commit == $c and (.legal_edges | index("grade") != null) and (.legal_edges | index("verify") != null)' >/dev/null || fail "compat old submit folds handed_off: $out"
append_ledger_line compat-exp "{\"ts\":\"2026-01-01T00:01:00Z\",\"edge\":\"review\",\"from\":\"submitted\",\"to\":\"submitted\",\"cycle\":1,\"commit\":\"$B\",\"verdict\":\"ship\",\"reason\":\"frozen\",\"harness\":\"t\",\"model\":\"t\",\"bp3_version\":\"0.2.0\"}"
append_ledger_line compat-exp "{\"ts\":\"2026-01-01T00:02:00Z\",\"edge\":\"check\",\"from\":\"submitted\",\"to\":\"approved\",\"cycle\":1,\"commit\":\"$B\",\"verdict\":\"pass\",\"reason\":\"frozen\",\"harness\":\"t\",\"model\":\"t\",\"bp3_version\":\"0.2.0\"}"
out=$(q demo r compat-exp)
echo "$out" | jq -e '.state == "approved" and .cycle == 1' >/dev/null || fail "compat old grade/verify fold approved: $out"
# reads never rewrite the frozen file
q demo r compat-exp >/dev/null
q demo r compat-exp >/dev/null
[ "$(git rev-parse bp3/exp/demo/compat-exp)" != "$compat_tip_before" ] || fail "compat fixture did not land"
compat_tip_read=$(git rev-parse bp3/exp/demo/compat-exp)
q r demo >/dev/null
[ "$(git rev-parse bp3/exp/demo/compat-exp)" = "$compat_tip_read" ] || fail "read rewrote frozen ledger"
# old verbs refuse as unknown edges, ledger unchanged
for old in submit review check; do
  if out=$(q demo u compat-exp "$old" --commit "$B" --verdict ship --reason "old words" 2>&1); then fail "old edge $old accepted"; fi
  echo "$out" | jq -e '.ok == false and .error.code == "E_USAGE"' >/dev/null || fail "old edge $old code: $out"
done
[ "$(git rev-parse bp3/exp/demo/compat-exp)" = "$compat_tip_read" ] || fail "old edge refusal ledgered"
# mixed vocab in one ledger (this quest's own shape): new handoff, old verdicts
out=$(q demo c mixed-exp)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "mixed create: $out"
out=$(q demo u mixed-exp handoff --commit "$B" --reason "new words")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "mixed handoff: $out"
append_ledger_line mixed-exp "{\"ts\":\"2026-01-01T00:03:00Z\",\"edge\":\"review\",\"from\":\"submitted\",\"to\":\"submitted\",\"cycle\":1,\"commit\":\"$B\",\"verdict\":\"ship\",\"reason\":\"frozen\",\"harness\":\"t\",\"model\":\"t\",\"bp3_version\":\"0.2.0\"}"
append_ledger_line mixed-exp "{\"ts\":\"2026-01-01T00:04:00Z\",\"edge\":\"check\",\"from\":\"submitted\",\"to\":\"approved\",\"cycle\":1,\"commit\":\"$B\",\"verdict\":\"pass\",\"reason\":\"frozen\",\"harness\":\"t\",\"model\":\"t\",\"bp3_version\":\"0.2.0\"}"
out=$(q demo r mixed-exp)
echo "$out" | jq -e '.state == "approved" and .cycle == 1' >/dev/null || fail "mixed vocab folds approved: $out"

# --- fin report words: exp_fin above; quest_fin when rollup landed ---
out=$(q c fin-demo)
echo "$out" | jq -e '.ok == true' >/dev/null || fail "fin quest create: $out"
out=$(q fin-demo c only-exp)
echo "$out" | jq -e '.state == "todo" and .fin == null' >/dev/null || fail "fin exp create: $out"
out=$(q fin-demo u only-exp handoff --commit "$B" --reason "work")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "fin handoff: $out"
out=$(q fin-demo u only-exp grade --verdict ship --reason "ok")
out=$(q fin-demo u only-exp verify --verdict pass --reason "ok")
out=$(q fin-demo u only-exp land --reason "done")
echo "$out" | jq -e '.state == "landed" and .fin == "exp_fin"' >/dev/null || fail "fin land: $out"
out=$(q r fin-demo)
echo "$out" | jq -e '.rollup == "landed" and .fin == "quest_fin" and (.exps[0] | .state == "landed" and .fin == "exp_fin")' >/dev/null || fail "quest_fin read: $out"
out=$(q r demo)
echo "$out" | jq -e '.fin == null' >/dev/null || fail "unfinished quest has no quest_fin: $out"

# --- blocked inbox after needs_fix at max_cycles (default max_cycles=1) ---
out=$(q demo u parser-fix2 handoff --commit "$B" --reason "work")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "submit2: $out"
out=$(q demo u parser-fix2 grade --verdict needs_fix --reason "broken")
echo "$out" | jq -e '.ok == true and .state == "blocked" and .human_action_required == true' >/dev/null || fail "needs_fix blocks at max: $out"
out=$(q r demo)
echo "$out" | jq -e '(.inbox | length == 1) and .inbox[0].quest == "demo" and .inbox[0].exp == "parser-fix2" and .inbox[0].reason == "broken" and (.inbox[0] | has("checkpoint")) and (.inbox[0] | has("cycle")) and (.inbox[0] | has("since"))' >/dev/null || fail "blocked inbox: $out"

# table format contains same facts
tbl=$(q r demo --format table)
echo "$tbl" | grep -q "demo" || fail "table missing quest"
echo "$tbl" | grep -q "parser-fix2" || fail "table missing blocked exp"
echo "$tbl" | grep -q "blocked" || fail "table missing blocked state"

# rendered tables: header row, aligned columns, short commits, counts
echo "$tbl" | sed -n 1p | grep -q "^quest demo \[proposed\] rollup: " || fail "quest table header: $tbl"
echo "$tbl" | sed -n 2p | grep -Eq '^exp +state +cycle +commit +changes$' || fail "quest table columns: $tbl"
echo "$tbl" | grep -Eq '^parser-fix +landed +1 +[0-9a-f]{7} +\+[0-9]+ u[0-9]+ -[0-9]+$' || fail "quest table landed row: $tbl"
if echo "$tbl" | grep -q '="'; then fail "quest table dumps inline JSON: $tbl"; fi
if echo "$tbl" | grep -q 'legal_edges'; then fail "quest table dumps raw fields: $tbl"; fi
etbl=$(q demo r parser-fix --format table)
echo "$etbl" | sed -n 1p | grep -Eq '^demo / parser-fix — landed, cycle 1, commit [0-9a-f]{7}, legal: ' || fail "exp table summary: $etbl"
echo "$etbl" | sed -n 2p | grep -Eq '^change +path$' || fail "exp table columns: $etbl"
echo "$etbl" | grep -Eq '^\+ +b\.txt$' || fail "exp table change row: $etbl"
# null commit / unknown changes render as - / ?, never crash
out=$(q demo c null-exp)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "null-exp create: $out"
ntbl=$(q demo r null-exp --format table)
echo "$ntbl" | sed -n 1p | grep -q 'commit -, legal: handoff, block, delete' || fail "null commit cell: $ntbl"
echo "$ntbl" | grep -q '? changes unknown' || fail "unknown changes cell: $ntbl"
qtbl_null=$(q r demo --format table)
echo "$qtbl_null" | grep -Eq '^null-exp +todo +1 +- +\?$' || fail "quest table null row: $qtbl_null"

# tree format: the human view (git-status alphabet: + todo, u in-flight, - deleted, blank landed)
tree=$(q r demo --format tree)
echo "$tree" | grep -q "^demo " || fail "tree missing quest root: $tree"
echo "$tree" | grep -q "u parser-fix2 - blocked" || fail "tree blocked marker: $tree"
echo "$tree" | grep -q "parser-fix - landed (exp_fin)" || fail "tree exp_fin: $tree"
echo "$tree" | grep -q "(human owed)" || fail "tree human owed: $tree"
echo "$tree" | grep -q "human owed:" || fail "tree inbox header: $tree"
etree=$(q demo r parser-fix2 --format tree)
echo "$etree" | grep -q "u parser-fix2 - blocked" || fail "exp tree marker: $etree"
echo "$etree" | grep -q "legal: resume, delete" || fail "exp tree legal edges: $etree"

# delete spellings (d / delete) on a scratch exp
out=$(q demo c scratch-exp)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "scratch create: $out"
out=$(q demo d scratch-exp --reason "no longer needed")
echo "$out" | jq -e '.ok == true and .state == "deleted"' >/dev/null || fail "exp delete d: $out"
out=$(q demo create scratch-exp2)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "scratch2 create: $out"
out=$(q demo delete scratch-exp2 --reason "gone")
echo "$out" | jq -e '.ok == true and .state == "deleted"' >/dev/null || fail "exp delete alias: $out"

# --- scenario helpers ---
qa() { env BP3_MODEL=executor-a BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q "$@"; }
qb() { env BP3_MODEL=executor-b BP3_Q_BIN="$work/repo/q-bin" ./bin/bp3 q "$@"; }
exp_ledger() { git show "bp3/exp/demo/$1:docs/quests/demo/experiments/$1/ledger.jsonl"; }
commit_on_exp() {
  local exp_name="$1"
  local file_path="$2"
  local content="$3"
  local branch="refs/heads/bp3/exp/demo/$exp_name"
  local tip
  local blob
  local tree
  local new_tip
  local idx="$work/idx-$exp_name"
  tip=$(git rev-parse "$branch")
  rm -f "$idx"
  blob=$(printf '%s' "$content" | git hash-object -w --stdin)
  GIT_INDEX_FILE="$idx" git read-tree "$tip"
  GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,$file_path"
  tree=$(GIT_INDEX_FILE="$idx" git write-tree)
  new_tip=$(printf 'work %s\n' "$exp_name" | git commit-tree "$tree" -p "$tip")
  git update-ref "$branch" "$new_tip" "$tip"
  rm -f "$idx"
  printf '%s' "$new_tip"
}

# --- two executors alternate edges on one exp, identical guards ---
out=$(q demo c alt-exp)
echo "$out" | jq -e '.ok == true and .state == "todo"' >/dev/null || fail "alt create: $out"
if out_a=$(qa demo u alt-exp land --reason "too early" 2>&1); then fail "alt land by A accepted"; fi
if out_b=$(qb demo u alt-exp land --reason "too early" 2>&1); then fail "alt land by B accepted"; fi
echo "$out_a" | jq -e '.ok == false and .error.code == "E_ILLEGAL_EDGE" and .error.facts.state == "todo" and .error.facts.edge == "land"' >/dev/null || fail "alt guard A: $out_a"
echo "$out_b" | jq -e '.ok == false and .error.code == "E_ILLEGAL_EDGE" and .error.facts.state == "todo" and .error.facts.edge == "land"' >/dev/null || fail "alt guard B: $out_b"
[ "$(echo "$out_a" | jq -cS '.error.facts')" = "$(echo "$out_b" | jq -cS '.error.facts')" ] || fail "alt guards differ: $out_a vs $out_b"
echo alt-work > alt.txt; git add alt.txt; git commit -qm alt-work
ALT=$(git rev-parse HEAD)
out=$(qa demo u alt-exp handoff --commit "$ALT" --reason "work")
echo "$out" | jq -e '.ok == true and .state == "handed_off"' >/dev/null || fail "alt handoff A: $out"
out=$(qb demo u alt-exp grade --verdict ship --reason "ok")
echo "$out" | jq -e '.ok == true and .state == "handed_off"' >/dev/null || fail "alt grade B: $out"
out=$(qa demo u alt-exp verify --verdict pass --reason "ok")
echo "$out" | jq -e '.ok == true and .state == "approved"' >/dev/null || fail "alt verify A: $out"
out=$(qb demo u alt-exp land --reason "ship")
echo "$out" | jq -e '.ok == true and .state == "landed"' >/dev/null || fail "alt land B: $out"
exp_ledger alt-exp | jq -se '([.[] | select(.edge == "handoff") | .model] == ["executor-a"]) and ([.[] | select(.edge == "grade") | .model] == ["executor-b"]) and ([.[] | select(.edge == "verify") | .model] == ["executor-a"]) and ([.[] | select(.edge == "land") | .model] == ["executor-b"])' >/dev/null || fail "alt ledger models"

# --- verdict naming a superseded commit refused ---
out=$(q demo c stale-exp)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "stale create: $out"
echo stale-a > stale.txt; git add stale.txt; git commit -qm stale-a
STALE_A=$(git rev-parse HEAD)
out=$(q demo u stale-exp handoff --commit "$STALE_A" --reason "first")
echo "$out" | jq -e '.state == "handed_off" and .cycle == 1' >/dev/null || fail "stale handoff A: $out"
out=$(q demo u stale-exp block --reason "hold")
echo "$out" | jq -e '.state == "blocked"' >/dev/null || fail "stale block: $out"
out=$(BP3_DECIDER=human q demo u stale-exp resume --reason "go simpler")
echo "$out" | jq -e '.state == "todo" and .cycle == 2' >/dev/null || fail "stale resume: $out"
echo stale-b > stale.txt; git add stale.txt; git commit -qm stale-b
STALE_B=$(git rev-parse HEAD)
out=$(q demo u stale-exp handoff --commit "$STALE_B" --reason "second")
echo "$out" | jq -e '.state == "handed_off" and .cycle == 2' >/dev/null || fail "stale handoff B: $out"
before=$(exp_ledger stale-exp | wc -l)
if out=$(q demo u stale-exp grade --verdict ship --commit "$STALE_A" --reason "stale" 2>&1); then fail "stale grade accepted"; fi
echo "$out" | jq -e --arg b "$STALE_B" '.ok == false and .error.code == "E_COMMIT_MISMATCH" and .error.facts.bound == $b' >/dev/null || fail "stale grade code: $out"
if out=$(q demo u stale-exp verify --verdict pass --commit "$STALE_A" --reason "stale" 2>&1); then fail "stale verify accepted"; fi
echo "$out" | jq -e '.ok == false and .error.code == "E_COMMIT_MISMATCH"' >/dev/null || fail "stale verify code: $out"
after=$(exp_ledger stale-exp | wc -l)
[ "$before" = "$after" ] || fail "stale verdict ledgered"
out=$(q demo r stale-exp)
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "stale still handed_off: $out"
out=$(q demo u stale-exp grade --verdict ship --commit "$STALE_B" --reason "current")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "stale grade current: $out"
out=$(q demo u stale-exp verify --verdict pass --commit "$STALE_B" --reason "current")
echo "$out" | jq -e '.state == "approved"' >/dev/null || fail "stale verify current: $out"
out=$(q demo u stale-exp land --reason "ship")
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "stale land: $out"

# --- grade + verify on same commit while handed_off: approved exactly once ---
out=$(q demo c parallel-exp)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "parallel create: $out"
echo par-work > par.txt; git add par.txt; git commit -qm par-work
PAR=$(git rev-parse HEAD)
out=$(q demo u parallel-exp handoff --commit "$PAR" --reason "work")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "parallel handoff: $out"
out=$(q demo u parallel-exp grade --verdict ship --reason "ok")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "parallel grade first: $out"
out=$(q demo u parallel-exp verify --verdict pass --reason "ok")
echo "$out" | jq -e '.state == "approved"' >/dev/null || fail "parallel verify approves: $out"
[ "$(exp_ledger parallel-exp | grep -c '"to":"approved"')" = "1" ] || fail "parallel approved count"
if out=$(q demo u parallel-exp grade --verdict ship --reason "again" 2>&1); then fail "parallel extra grade accepted"; fi
echo "$out" | jq -e '.error.code == "E_ILLEGAL_EDGE" and .error.facts.state == "approved"' >/dev/null || fail "parallel extra grade code: $out"
if out=$(q demo u parallel-exp verify --verdict pass --reason "again" 2>&1); then fail "parallel extra verify accepted"; fi
echo "$out" | jq -e '.error.code == "E_ILLEGAL_EDGE" and .error.facts.state == "approved"' >/dev/null || fail "parallel extra verify code: $out"
[ "$(exp_ledger parallel-exp | grep -c '"to":"approved"')" = "1" ] || fail "parallel approved twice"
out=$(q demo u parallel-exp land --reason "ship")
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "parallel land: $out"
out=$(q demo c parallel-rev)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "parallel-rev create: $out"
out=$(q demo u parallel-rev handoff --commit "$PAR" --reason "work")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "parallel-rev handoff: $out"
out=$(q demo u parallel-rev verify --verdict pass --reason "ok")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "parallel-rev verify first: $out"
out=$(q demo u parallel-rev grade --verdict ship --reason "ok")
echo "$out" | jq -e '.state == "approved"' >/dev/null || fail "parallel-rev grade approves: $out"
[ "$(exp_ledger parallel-rev | grep -c '"to":"approved"')" = "1" ] || fail "parallel-rev approved count"
out=$(q demo u parallel-rev land --reason "ship")
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "parallel-rev land: $out"

# --- needs_fix at max_cycles blocked; resume human gate (parser-fix2 above) ---
before=$(exp_ledger parser-fix2 | wc -l)
if out=$(q demo u parser-fix2 resume --reason "go" 2>&1); then fail "resume without human accepted"; fi
echo "$out" | jq -e '.ok == false and .error.code == "E_HUMAN_REQUIRED"' >/dev/null || fail "resume human code: $out"
after=$(exp_ledger parser-fix2 | wc -l)
[ "$before" = "$after" ] || fail "refused resume ledgered"
out=$(q demo r parser-fix2)
echo "$out" | jq -e '.state == "blocked" and .cycle == 1 and (.legal_edges | index("resume") != null) and (.legal_edges | index("delete") != null)' >/dev/null || fail "blocked legal edges: $out"
out=$(BP3_DECIDER=human q demo u parser-fix2 resume --reason "go simpler")
echo "$out" | jq -e '.ok == true and .state == "todo" and .cycle == 2' >/dev/null || fail "resume human todo cycle+1: $out"
out=$(q r demo)
echo "$out" | jq -e '[.inbox[] | select(.exp == "parser-fix2")] | length == 0' >/dev/null || fail "resumed exp still in inbox: $out"

# --- two exps land into one quest branch: clean merge keeps verdicts ---
out=$(q demo c land-a)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "land-a create: $out"
out=$(q demo c land-b)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "land-b create: $out"
LAND_A=$(commit_on_exp land-a fa.txt "A-content")
LAND_B=$(commit_on_exp land-b fb.txt "B-content")
out=$(q demo u land-a handoff --commit "$LAND_A" --reason "work")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "land-a handoff: $out"
out=$(q demo u land-b handoff --commit "$LAND_B" --reason "work")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "land-b handoff: $out"
out=$(q demo u land-a grade --verdict ship --reason "ok")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "land-a grade: $out"
out=$(q demo u land-a verify --verdict pass --reason "ok")
echo "$out" | jq -e '.state == "approved"' >/dev/null || fail "land-a verify: $out"
out=$(q demo u land-b grade --verdict ship --reason "ok")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "land-b grade: $out"
out=$(q demo u land-b verify --verdict pass --reason "ok")
echo "$out" | jq -e '.state == "approved"' >/dev/null || fail "land-b verify: $out"
out=$(q demo u land-a land --reason "ship")
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "land-a land: $out"
out=$(q demo u land-b land --reason "ship")
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "land-b clean merge: $out"
[ "$(git show bp3/quest/demo:fa.txt)" = "A-content" ] || fail "clean merge lost fa.txt"
[ "$(git show bp3/quest/demo:fb.txt)" = "B-content" ] || fail "clean merge lost fb.txt"
git merge-base --is-ancestor "$LAND_A" bp3/quest/demo || fail "land-a reviewed commit not ancestor of quest tip"
git merge-base --is-ancestor "$LAND_B" bp3/quest/demo || fail "land-b reviewed commit not ancestor of quest tip"
out=$(q demo r land-b)
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "land-b verdicts kept: $out"
[ "$(exp_ledger land-b | grep -c '"to":"approved"')" = "1" ] || fail "land-b approved verdict lost"

# --- two exps land: conflict demotes only the conflicting exp ---
out=$(q demo c land-c)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "land-c create: $out"
out=$(q demo c land-d)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "land-d create: $out"
LAND_C=$(commit_on_exp land-c shared.txt "C-side")
LAND_D=$(commit_on_exp land-d shared.txt "D-side")
out=$(q demo u land-c handoff --commit "$LAND_C" --reason "work")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "land-c handoff: $out"
out=$(q demo u land-d handoff --commit "$LAND_D" --reason "work")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "land-d handoff: $out"
out=$(q demo u land-c grade --verdict ship --reason "ok")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "land-c grade: $out"
out=$(q demo u land-c verify --verdict pass --reason "ok")
echo "$out" | jq -e '.state == "approved"' >/dev/null || fail "land-c verify: $out"
out=$(q demo u land-d grade --verdict ship --reason "ok")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "land-d grade: $out"
out=$(q demo u land-d verify --verdict pass --reason "ok")
echo "$out" | jq -e '.state == "approved"' >/dev/null || fail "land-d verify: $out"
out=$(q demo u land-c land --reason "ship")
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "land-c land: $out"
cycle_before=$(q demo r land-d | jq -r '.cycle')
out=$(q demo u land-d land --reason "ship")
echo "$out" | jq -e --argjson cyc "$cycle_before" '.ok == true and .state == "todo" and .cycle == $cyc and .facts.land_conflict == true' >/dev/null || fail "land-d conflict demotion: $out"
out=$(q demo r land-d)
echo "$out" | jq -e --argjson cyc "$cycle_before" '.state == "todo" and .cycle == $cyc' >/dev/null || fail "land-d cycle changed: $out"
out=$(q demo r land-c)
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "land-c demoted by other conflict: $out"
out=$(q demo r land-a)
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "land-a demoted by other conflict: $out"
[ "$(git show bp3/quest/demo:shared.txt)" = "C-side" ] || fail "conflict overwrote quest work file"

# --- dirty-tree handoff refused; block checkpoint is a real commit ---
out=$(q demo c dirty-exp)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "dirty create: $out"
echo dirty-work > dirty.txt; git add dirty.txt; git commit -qm dirty-work
DIRTY_WORK=$(git rev-parse HEAD)
echo dirty >> a.txt
before=$(exp_ledger dirty-exp | wc -l)
if out=$(q demo u dirty-exp handoff --commit "$DIRTY_WORK" --reason "work" 2>&1); then fail "dirty handoff accepted"; fi
echo "$out" | jq -e '.ok == false and .error.code == "E_DIRTY_TREE"' >/dev/null || fail "dirty handoff code: $out"
after=$(exp_ledger dirty-exp | wc -l)
[ "$before" = "$after" ] || fail "dirty handoff ledgered"
out=$(q demo r dirty-exp)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "dirty handoff changed state: $out"
git checkout -- a.txt
out=$(q demo u dirty-exp handoff --commit "$DIRTY_WORK" --reason "work")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "clean handoff after dirty: $out"
echo dirty-again >> a.txt
out=$(q demo u dirty-exp block --reason "stuck")
echo "$out" | jq -e '.ok == true and .state == "blocked" and .human_action_required == true' >/dev/null || fail "dirty block: $out"
checkpoint=$(exp_ledger dirty-exp | tail -1 | jq -r '.checkpoint')
[ -n "$checkpoint" ] && [ "$checkpoint" != "null" ] || fail "block checkpoint missing"
[ "$(git cat-file -t "$checkpoint")" = "commit" ] || fail "checkpoint is not a commit object: $checkpoint"
out=$(q r demo)
echo "$out" | jq -e --arg ck "$checkpoint" '[.inbox[] | select(.exp == "dirty-exp" and .checkpoint == $ck)] | length == 1' >/dev/null || fail "inbox checkpoint mismatch: $out"
git checkout -- a.txt

# --- delete from blocked requires human; tombstone keeps branch ref ---
before=$(exp_ledger dirty-exp | wc -l)
if out=$(q demo d dirty-exp --reason "gone" 2>&1); then fail "delete blocked without human accepted"; fi
echo "$out" | jq -e '.ok == false and .error.code == "E_HUMAN_REQUIRED"' >/dev/null || fail "delete blocked code: $out"
after=$(exp_ledger dirty-exp | wc -l)
[ "$before" = "$after" ] || fail "refused delete ledgered"
out=$(q demo r dirty-exp)
echo "$out" | jq -e '.state == "blocked"' >/dev/null || fail "refused delete changed state: $out"
out=$(BP3_DECIDER=human q demo d dirty-exp --reason "gone")
echo "$out" | jq -e '.ok == true and .state == "deleted"' >/dev/null || fail "delete blocked human: $out"
git rev-parse --verify -q refs/heads/bp3/exp/demo/dirty-exp >/dev/null || fail "delete removed exp branch ref"
out=$(q demo r dirty-exp)
echo "$out" | jq -e '.state == "deleted" and (.legal_edges | length == 0)' >/dev/null || fail "tombstone read: $out"
exp_ledger dirty-exp | tail -1 | jq -e '.edge == "delete" and .to == "deleted"' >/dev/null || fail "tombstone ledger line"

# --- fresh-clone reconstruction from branch tips alone ---
out=$(q demo c clone-blocked)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "clone-blocked create: $out"
echo cb-work > cb.txt; git add cb.txt; git commit -qm cb-work
CB_WORK=$(git rev-parse HEAD)
out=$(q demo u clone-blocked handoff --commit "$CB_WORK" --reason "work")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "clone-blocked handoff: $out"
out=$(q demo u clone-blocked grade --verdict needs_fix --reason "clone blocked reason")
echo "$out" | jq -e '.state == "blocked" and .human_action_required == true' >/dev/null || fail "clone-blocked blocks: $out"
before_clone=$(q r demo | jq -S -c '{quest, state, rollup, exps: (.exps | sort_by(.exp) | map({exp, state, cycle, commit})), inbox: (.inbox | sort_by(.exp))}')
git clone -q "$work/repo" "$work/clone"
cd "$work/clone"
git config user.email t@t.t; git config user.name t
git fetch -q origin '+refs/heads/bp3/*:refs/heads/bp3/*'
test ! -f docs/quests/demo/experiments/clone-blocked/state.yaml || fail "clone worktree carries state.yaml; branch-tip proof unclear"
clone_q() { BP3_Q_BIN="$work/clone/q-bin" ./bin/bp3 q "$@"; }
after_clone=$(clone_q r demo | jq -S -c '{quest, state, rollup, exps: (.exps | sort_by(.exp) | map({exp, state, cycle, commit})), inbox: (.inbox | sort_by(.exp))}')
[ "$before_clone" = "$after_clone" ] || fail "clone reconstruction differs: $before_clone vs $after_clone"
out=$(clone_q demo r clone-blocked)
echo "$out" | jq -e '.state == "blocked"' >/dev/null || fail "clone blocked exp: $out"
out=$(clone_q demo r land-a)
echo "$out" | jq -e '.state == "landed"' >/dev/null || fail "clone landed exp: $out"
out=$(clone_q demo r land-d)
echo "$out" | jq -e '.state == "todo"' >/dev/null || fail "clone demoted exp: $out"
out=$(clone_q r demo)
echo "$out" | jq -e '.rollup == "blocked" and ([.inbox[] | select(.exp == "clone-blocked" and .reason == "clone blocked reason")] | length == 1)' >/dev/null || fail "clone rollup/inbox: $out"
cd "$work/repo"

# --- proposed changes: the bound commit's changeset, visible before land ---
q c chg >/dev/null
q chg c files >/dev/null
echo new > added.txt; mkdir -p sub; echo deep > sub/deep.txt; echo change >> a.txt; git rm -q b.txt 2>/dev/null || rm -f b.txt
git add -A; git commit -qm "add+modify+delete"
CHG=$(git rev-parse HEAD)
out=$(q chg u files handoff --commit "$CHG" --reason "changeset demo")
echo "$out" | jq -e '.state == "handed_off"' >/dev/null || fail "chg handoff: $out"
out=$(q chg r files)
echo "$out" | jq -e '[.changes[] | select(.change == "+" and .path == "added.txt")] | length == 1' >/dev/null || fail "changes +: $out"
echo "$out" | jq -e '[.changes[] | select(.change == "u" and .path == "a.txt")] | length == 1' >/dev/null || fail "changes u: $out"
echo "$out" | jq -e '[.changes[] | select(.change == "-" and .path == "b.txt")] | length == 1' >/dev/null || fail "changes -: $out"
ctree=$(q chg r files --format tree)
echo "$ctree" | grep -q "├── + added.txt" || fail "exp tree files: $ctree"
echo "$ctree" | grep -q "├── sub" || fail "exp tree dir branch: $ctree"
echo "$ctree" | grep -q "└── + deep.txt" || fail "exp tree nested leaf: $ctree"
echo "$ctree" | grep -qF "+ added.txt" || fail "exp tree + line: $ctree"
echo "$ctree" | grep -qF "u a.txt" || fail "exp tree u line: $ctree"
echo "$ctree" | grep -qF -- "- b.txt" || fail "exp tree - line: $ctree"
qtree=$(q r chg --format tree)
echo "$qtree" | grep -q "\[+2 u1 -1\]" || fail "quest tree counts: $qtree"
git checkout -q HEAD -- a.txt 2>/dev/null || true
# unsure changeset renders as ?, never a fake empty
q chg c fresh >/dev/null
ftree=$(q chg r fresh --format tree)
echo "$ftree" | grep -q "? changes unknown" || fail "unsure changes marker: $ftree"
out=$(q chg r fresh)
echo "$out" | jq -e '.changes == null' >/dev/null || fail "unsure changes json: $out"

# --- icebox door: read-only list/search/slug over docs/icebox ---
mkdir -p docs/icebox
cat > docs/icebox/2026-01-01-alpha-idea.md <<'EOF'
