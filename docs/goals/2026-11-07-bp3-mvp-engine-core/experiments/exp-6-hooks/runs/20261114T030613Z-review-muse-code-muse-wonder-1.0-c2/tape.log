 out=$(hooks "$sweep")
 echo "$out" | jq -e --arg r "$RUN2" '.event_line.event == "run_unsettled" and .event_line.run_id == $r and (.event_line | has("last_seen_ts"))' >/dev/null || fail "run_unsettled verdict: $out"
@@ -126,6 +135,25 @@ out=$(hooks "$sweep")
