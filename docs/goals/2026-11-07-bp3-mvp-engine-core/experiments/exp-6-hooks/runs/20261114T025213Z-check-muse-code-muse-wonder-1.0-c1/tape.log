--- bound commit files hooks ---
(* hooks — the bp3 q hooks emitter. Reads one Muse hook
   event JSON from stdin, self-gates, resolves the witnessed Run
   binding, and appends past-tense event lines to the exp ledger
   through the internal fact writer below. Always exits 0:
   fail-open, never blocks a tool, never judges an edge.
   Event lines carry event/ts/run_id and never edge/from/to,
   so the Store fold skips them by construction. *)
open Gitx
open Store

(* ---------- small helpers ---------- *)
let verdict event_line reason =
  `Assoc [("ok", `Bool true); ("event_line", event_line);
          ("reason", (match reason with Some r -> json_str r | None -> `Null))]

let no_write reason = verdict `Null (Some reason)

let read_stdin () =
  let buf = Buffer.create 1024 in
  (try
     while true do
       Buffer.add_string buf (input_line stdin);
       Buffer.add_char buf '\n'
     done
   with End_of_file -> ());
  Buffer.contents buf

let member_str j key =
  try match Yojson.Safe.Util.member key j with `String s -> s | _ -> "" with _ -> ""

--- hooks.json at bound ---
{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "PostLLMCall": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "./bin/bp3 q hooks"}]}]
  }
}
