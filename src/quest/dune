; The engine is a library so unit tests link it (test-pyramid unit.1);
; unwrapped, so modules keep their names (Store, Hooks, ...).
(library
 (name bp3_quest)
 (wrapped false)
 (modules :standard \ main run_suites)
 (libraries yojson unix str))

(executable
 (name main)
 (modules main)
 (libraries bp3_quest bp3_warden bp3_db bp3_repo yojson unix str))

; The parallel suite runner (test-pyramid tier.1); scripts/run-suites
; execs it. Its pure core is the Suites module in the library.
(executable
 (name run_suites)
 (modules run_suites)
 (libraries bp3_quest unix))
